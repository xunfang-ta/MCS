    <bib:Memo rdf:about="#item_24">
        <rdf:value>&lt;!-- zab:deep-read-plan:%7B%22templateId%22%3A%22default-v2-chapter-reading%22%2C%22template%22%3A%7B%22id%22%3A%22default-v2-chapter-reading%22%2C%22name%22%3A%22%E9%BB%98%E8%AE%A4%EF%BC%9A%E5%8F%8C%E9%98%B6%E6%AE%B5%E9%80%90%E7%AB%A0%E7%B2%BE%E8%AF%BB%22%2C%22description%22%3A%22%E5%85%88%E8%A7%A3%E6%9E%90%E7%AB%A0%E8%8A%82%20JSON%EF%BC%8C%E5%86%8D%E6%8C%89%E7%AB%A0%E8%8A%82%E9%A1%BA%E5%BA%8F%E9%80%90%E7%AB%A0%E7%B2%BE%E8%AF%BB%EF%BC%9B%E7%AC%AC%E4%BA%8C%E9%98%B6%E6%AE%B5%E7%94%A8%E9%87%8D%E7%82%B9%E8%BF%BD%E9%97%AE%E8%A1%A5%E5%85%85%E8%AE%BA%E6%96%87%E7%90%86%E8%A7%A3%E3%80%82%22%2C%22version%22%3A2%2C%22phases%22%3A%5B%7B%22id%22%3A%22chapter_reading%22%2C%22title%22%3A%22%E9%98%B6%E6%AE%B5%E4%B8%80%EF%BC%9A%E9%80%90%E7%AB%A0%E7%B2%BE%E8%AF%BB%22%2C%22type%22%3A%22sequential_dynamic%22%2C%22description%22%3A%22%E5%85%88%E8%AE%A9%20AI%20%E8%AF%86%E5%88%AB%E8%AE%BA%E6%96%87%E7%AB%A0%E8%8A%82%E7%BB%93%E6%9E%84%EF%BC%8C%E5%86%8D%E6%8A%8A%E7%AB%A0%E8%8A%82%E6%A0%87%E9%A2%98%E6%B8%B2%E6%9F%93%E8%BF%9B%E7%AB%A0%E8%8A%82%E7%B2%BE%E8%AF%BB%E6%8F%90%E7%A4%BA%E8%AF%8D%EF%BC%8C%E6%8C%89%E9%A1%BA%E5%BA%8F%E5%86%99%E5%85%A5%E7%B2%BE%E8%AF%BB%E7%AC%94%E8%AE%B0%E3%80%82%22%2C%22contextStrategy%22%3A%22last_round%22%2C%22fixedPrompts%22%3A%5B%5D%2C%22planningPrompt%22%3A%22%E8%AF%B7%E9%98%85%E8%AF%BB%E5%85%A8%E6%96%87%E5%85%A8%E6%96%87%EF%BC%8C%E8%AF%86%E5%88%AB%E8%AE%BA%E6%96%87%E7%9A%84%E4%B8%BB%E8%A6%81%E7%AB%A0%E8%8A%82%E7%BB%93%E6%9E%84%EF%BC%8C%E5%B9%B6%E5%8F%AA%E8%BF%94%E5%9B%9E%20JSON%EF%BC%8C%E4%B8%8D%E8%A6%81%E8%BE%93%E5%87%BA%E8%A7%A3%E9%87%8A%E6%96%87%E5%AD%97%E3%80%82%5Cn%5Cn%E8%BF%94%E5%9B%9E%E6%A0%BC%E5%BC%8F%E5%BF%85%E9%A1%BB%E6%98%AF%EF%BC%9A%5Cn%7B%5Cn%20%20%5C%22chapters%5C%22%3A%20%5B%5Cn%20%20%20%20%7B%20%5C%22id%5C%22%3A%20%5C%22ch1%5C%22%2C%20%5C%22title_zh%5C%22%3A%20%5C%22%E5%BC%95%E8%A8%80%5C%22%2C%20%5C%22title_en%5C%22%3A%20%5C%22Introduction%5C%22%20%7D%2C%5Cn%20%20%20%20%7B%20%5C%22id%5C%22%3A%20%5C%22ch2%5C%22%2C%20%5C%22title_zh%5C%22%3A%20%5C%22%E7%AC%AC%E4%BA%8C%E7%AB%A0%5C%22%2C%20%5C%22title_en%5C%22%3A%20%5C%22Related%20Work%20%E6%88%96%20Method%5C%22%20%7D%5Cn%20%20%5D%5Cn%7D%5Cn%5Cn%E8%A6%81%E6%B1%82%EF%BC%9A%5Cn1.%20%E4%BC%98%E5%85%88%E4%BD%BF%E7%94%A8%E8%AE%BA%E6%96%87%E5%8E%9F%E6%96%87%E4%B8%AD%E7%9A%84%E7%AB%A0%E8%8A%82%E6%A0%87%E9%A2%98%E3%80%82%5Cn2.%20%E5%A6%82%E6%9E%9C%E8%AE%BA%E6%96%87%E6%A0%87%E9%A2%98%E4%B8%8D%E6%98%AF%E4%B8%AD%E6%96%87%EF%BC%8C%E8%AF%B7%E7%BB%99%E5%87%BA%E7%AE%80%E7%9F%AD%E4%B8%AD%E6%96%87%E8%AF%91%E5%90%8D%E5%92%8C%E8%8B%B1%E6%96%87%E5%8E%9F%E5%90%8D%E3%80%82%5Cn3.%20%E8%87%B3%E5%B0%91%E8%BF%94%E5%9B%9E%E4%B8%A4%E4%B8%AA%E7%AB%A0%E8%8A%82%EF%BC%9B%E5%A6%82%E6%9E%9C%E7%BB%93%E6%9E%84%E4%B8%8D%E6%B8%85%E6%99%B0%EF%BC%8C%E5%B0%B1%E8%BF%94%E5%9B%9E%E2%80%9C%E5%BC%95%E8%A8%80%E2%80%9D%E5%92%8C%E2%80%9C%E7%AC%AC%E4%BA%8C%E7%AB%A0%E2%80%9D%E3%80%82%5Cn4.%20JSON%20%E5%AD%97%E6%AE%B5%E4%BC%9A%E7%9B%B4%E6%8E%A5%E7%94%A8%E4%BA%8E%E9%80%90%E7%AB%A0%E7%B2%BE%E8%AF%BB%E6%8F%90%E7%A4%BA%E8%AF%8D%E6%A8%A1%E6%9D%BF%EF%BC%9Atitle_zh%20%E5%AF%B9%E5%BA%94%20%7B%7Btitle_zh%7D%7D%EF%BC%8Ctitle_en%20%E5%AF%B9%E5%BA%94%20%7B%7Btitle_en%7D%7D%EF%BC%8Cid%20%E4%BB%85%E7%94%A8%E4%BA%8E%E5%86%85%E9%83%A8%E6%A0%87%E8%AF%86%E3%80%82%22%2C%22chapterTemplate%22%3A%22%E8%AF%B7%E7%B2%BE%E8%AF%BB%E8%AE%BA%E6%96%87%E4%B8%AD%E7%9A%84%E2%80%9C%7B%7Btitle_zh%7D%7D%EF%BC%88%7B%7Btitle_en%7D%7D%EF%BC%89%E2%80%9D%E8%BF%99%E4%B8%80%E7%AB%A0%E3%80%82%5Cn%5Cn%E8%AF%B7%E5%9B%B4%E7%BB%95%E4%B8%8B%E9%9D%A2%E9%97%AE%E9%A2%98%E7%BB%84%E7%BB%87%E5%9B%9E%E7%AD%94%EF%BC%9A%5Cn1.%20%E8%BF%99%E4%B8%80%E7%AB%A0%E5%9C%A8%E5%85%A8%E6%96%87%E4%B8%AD%E7%9A%84%E4%BD%9C%E7%94%A8%E6%98%AF%E4%BB%80%E4%B9%88%EF%BC%9F%5Cn2.%20%E8%BF%99%E4%B8%80%E7%AB%A0%E6%8F%90%E5%87%BA%E4%BA%86%E5%93%AA%E4%BA%9B%E5%85%B3%E9%94%AE%E6%A6%82%E5%BF%B5%E3%80%81%E8%AE%BA%E8%AF%81%E6%88%96%E6%8A%80%E6%9C%AF%E7%BB%86%E8%8A%82%EF%BC%9F%5Cn3.%20%E5%93%AA%E4%BA%9B%E5%86%85%E5%AE%B9%E6%98%AF%E8%AF%BB%E8%80%85%E7%90%86%E8%A7%A3%E5%90%8E%E7%BB%AD%E7%AB%A0%E8%8A%82%E5%BF%85%E9%A1%BB%E6%8E%8C%E6%8F%A1%E7%9A%84%EF%BC%9F%5Cn4.%20%E5%A6%82%E6%9E%9C%E8%BF%99%E4%B8%80%E7%AB%A0%E6%9C%89%E5%85%AC%E5%BC%8F%E3%80%81%E5%AE%9E%E9%AA%8C%E8%AE%BE%E7%BD%AE%E6%88%96%E5%AE%9A%E4%B9%89%EF%BC%8C%E8%AF%B7%E7%94%A8%E9%80%9A%E4%BF%97%E4%B8%AD%E6%96%87%E8%A7%A3%E9%87%8A%E3%80%82%5Cn%5Cn%E8%BE%93%E5%87%BA%E8%A6%81%E6%B1%82%EF%BC%9A%5Cn-%20%E4%BD%BF%E7%94%A8%20Markdown%E3%80%82%5Cn-%20%E4%B8%8D%E8%A6%81%E5%AF%92%E6%9A%84%EF%BC%8C%E4%B8%8D%E8%A6%81%E9%87%8D%E5%A4%8D%E9%A2%98%E7%9B%AE%E3%80%82%5Cn-%20%E6%A0%87%E9%A2%98%E5%B1%82%E7%BA%A7%E4%BB%8E%E4%B8%89%E7%BA%A7%E6%A0%87%E9%A2%98%E5%BC%80%E5%A7%8B%EF%BC%8C%E4%BE%8B%E5%A6%82%E2%80%9C%23%23%23%20%E6%9C%AC%E7%AB%A0%E4%BD%9C%E7%94%A8%E2%80%9D%E3%80%82%5Cn-%20%E5%B0%BD%E9%87%8F%E8%AE%A9%E6%B2%A1%E6%9C%89%E8%AF%A5%E5%B0%8F%E6%96%B9%E5%90%91%E8%83%8C%E6%99%AF%E7%9A%84%E8%AF%BB%E8%80%85%E4%B9%9F%E8%83%BD%E7%9C%8B%E6%87%82%E3%80%82%22%7D%2C%7B%22id%22%3A%22deep_questions%22%2C%22title%22%3A%22%E9%98%B6%E6%AE%B5%E4%BA%8C%EF%BC%9A%E9%87%8D%E7%82%B9%E8%BF%BD%E9%97%AE%22%2C%22type%22%3A%22independent%22%2C%22description%22%3A%22%E6%AF%8F%E4%B8%AA%E8%BF%BD%E9%97%AE%E7%8B%AC%E7%AB%8B%E9%98%85%E8%AF%BB%E5%85%A8%E6%96%87%E5%85%A8%E6%96%87%EF%BC%8C%E4%B8%8D%E6%90%BA%E5%B8%A6%E5%85%B6%E4%BB%96%E8%BD%AE%E6%AC%A1%E4%B8%8A%E4%B8%8B%E6%96%87%E3%80%82%22%2C%22parallelizable%22%3Afalse%2C%22maxConcurrency%22%3A1%2C%22prompts%22%3A%5B%7B%22id%22%3A%22q_core_contribution%22%2C%22title%22%3A%22%E6%A0%B8%E5%BF%83%E8%B4%A1%E7%8C%AE%E5%88%A4%E6%96%AD%22%2C%22prompt%22%3A%22%E8%AF%B7%E5%9F%BA%E4%BA%8E%E8%AE%BA%E6%96%87%E5%85%A8%E6%96%87%EF%BC%8C%E7%94%A8%E4%B8%AD%E6%96%87%E5%88%A4%E6%96%AD%E6%9C%AC%E6%96%87%E6%9C%80%E6%A0%B8%E5%BF%83%E7%9A%84%E8%B4%A1%E7%8C%AE%E6%98%AF%E4%BB%80%E4%B9%88%EF%BC%8C%E5%B9%B6%E8%AF%B4%E6%98%8E%E5%AE%83%E4%B8%BA%E4%BB%80%E4%B9%88%E9%87%8D%E8%A6%81%E3%80%82%E8%BE%93%E5%87%BA%20Markdown%EF%BC%8C%E6%A0%87%E9%A2%98%E5%B1%82%E7%BA%A7%E4%BB%8E%E4%B8%89%E7%BA%A7%E6%A0%87%E9%A2%98%E5%BC%80%E5%A7%8B%E3%80%82%22%2C%22order%22%3A1%7D%2C%7B%22id%22%3A%22q_limits_questions%22%2C%22title%22%3A%22%E5%B1%80%E9%99%90%E4%B8%8E%E7%96%91%E9%97%AE%22%2C%22prompt%22%3A%22%E8%AF%B7%E5%9F%BA%E4%BA%8E%E8%AE%BA%E6%96%87%E5%85%A8%E6%96%87%EF%BC%8C%E7%94%A8%E4%B8%AD%E6%96%87%E5%88%97%E5%87%BA%E6%9C%AC%E6%96%87%E6%9C%80%E5%80%BC%E5%BE%97%E6%B3%A8%E6%84%8F%E7%9A%84%E5%B1%80%E9%99%90%E3%80%81%E9%A3%8E%E9%99%A9%E6%88%96%E4%BB%8D%E6%9C%AA%E8%A7%A3%E5%86%B3%E7%9A%84%E9%97%AE%E9%A2%98%E3%80%82%E8%BE%93%E5%87%BA%20Markdown%EF%BC%8C%E6%A0%87%E9%A2%98%E5%B1%82%E7%BA%A7%E4%BB%8E%E4%B8%89%E7%BA%A7%E6%A0%87%E9%A2%98%E5%BC%80%E5%A7%8B%E3%80%82%22%2C%22order%22%3A2%7D%5D%7D%5D%2C%22prompts%22%3A%5B%5D%7D%2C%22chapters%22%3A%5B%7B%22id%22%3A%22ch1%22%2C%22title_zh%22%3A%22%E5%BC%95%E8%A8%80%22%2C%22title_en%22%3A%22Introduction%22%7D%2C%7B%22id%22%3A%22ch2%22%2C%22title_zh%22%3A%22%E6%96%87%E7%8C%AE%E7%BB%BC%E8%BF%B0%22%2C%22title_en%22%3A%22Literature%20Review%22%7D%2C%7B%22id%22%3A%22ch3%22%2C%22title_zh%22%3A%22%E6%96%B9%E6%B3%95%E8%AE%BA%22%2C%22title_en%22%3A%22Methodology%22%7D%2C%7B%22id%22%3A%22ch4%22%2C%22title_zh%22%3A%22%E5%AE%9E%E8%AF%81%E7%BB%93%E6%9E%9C%E4%B8%8E%E5%88%86%E6%9E%90%22%2C%22title_en%22%3A%22Empirical%20Results%20and%20Analysis%22%7D%2C%7B%22id%22%3A%22ch5%22%2C%22title_zh%22%3A%22%E7%BB%93%E8%AE%BA%22%2C%22title_en%22%3A%22Conclusion%22%7D%5D%7D --&gt;
&lt;h1&gt;AI 精读 - Do Technical Indicators Generate Tradable Value? Evidence from Market States, Price-Path Images, and...&lt;/h1&gt;
&lt;h2&gt;章节解析&lt;/h2&gt;
&lt;p&gt;第1章：引言（Introduction）&lt;/p&gt;
&lt;p&gt;第2章：文献综述（Literature Review）&lt;/p&gt;
&lt;p&gt;第3章：方法论（Methodology）&lt;/p&gt;
&lt;p&gt;第4章：实证结果与分析（Empirical Results and Analysis）&lt;/p&gt;
&lt;p&gt;第5章：结论（Conclusion）&lt;/p&gt;
&lt;!-- zab:slot:chapter_ch1:done --&gt;
&lt;h2&gt;引言&lt;/h2&gt;
&lt;h3&gt;本章作用&lt;/h3&gt;
&lt;p&gt;引言是整篇论文的“问题提出”章节，它的核心任务是确立研究问题、说明研究价值，并为后续所有实证分析提供逻辑起点。具体来说，引言做了以下四件关键事情：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;strong&gt;定位问题&lt;/strong&gt;：技术指标在量化投资中到底有没有用？这个问题看起来老生常谈，但作者提出了一个更尖锐的追问——不是“预测准不准”，而是“扣掉交易成本后能不能赚钱”。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;指出文献缺口&lt;/strong&gt;：现有研究主要用分类指标（AUC、Accuracy）评估模型好坏，忽略了投资组合层面的经济价值；传统技术指标本质上是对价格和成交量的二次加工，可能丢失价格路径中的非线性信息；不同市场环境下预测关系可能不稳定。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;提出统一比较框架&lt;/strong&gt;：把不同的“信息层”放在同一个框架下比较，从最基础的价格-成交量变量，到传统技术指标、市场状态变量、微观结构变量，再到价格路径图像模型。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;预告核心结论&lt;/strong&gt;：传统技术指标的信息增量有限，而基于OHLC价格路径图像的CNN模型在5天预测任务中，扣除10个基点交易成本后仍能获得9.34%的年化多空净收益，说明图像化价格路径表示更能捕捉非线性信息。&lt;/li&gt;
&lt;/ol&gt;
&lt;h3&gt;关键概念与论证&lt;/h3&gt;
&lt;h4&gt;核心命题的转换&lt;/h4&gt;
&lt;p&gt;引言最重要的论证在于：&lt;strong&gt;“预测能力”不等于“投资能力”&lt;/strong&gt;。传统研究关注模型能否把涨跌分类正确，但引言指出，真正决定一个信号是否有价值的是——把预测结果变成投资组合后，在真实交易环境中（有换手率、有交易成本）能否产生正向的经风险调整后的收益。&lt;/p&gt;
&lt;h4&gt;三个文献缺口&lt;/h4&gt;
&lt;p&gt;引言通过文献回顾，归纳出当前研究的三个不足：&lt;/p&gt;
&lt;table style=&quot;max-width:100%; width:auto; table-layout:auto; overflow-wrap:anywhere; word-break:break-word;&quot;&gt;
&lt;thead&gt;
&lt;tr&gt;
&lt;th&gt;缺口&lt;/th&gt;
&lt;th&gt;具体内容&lt;/th&gt;
&lt;th&gt;本论文的回应&lt;/th&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;&lt;tr&gt;
&lt;td&gt;评价指标缺陷&lt;/td&gt;
&lt;td&gt;大量研究依赖AUC、Accuracy等分类指标，但分类准确率不能反映组合层面的获利能力&lt;/td&gt;
&lt;td&gt;以多空组合年化收益、夏普比率、换手率、扣费后净收益为主要评价指标&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;信息表示局限&lt;/td&gt;
&lt;td&gt;传统技术指标是对价格、成交量、波动率的线性重组，可能丢失价格路径中的非线性形态信息&lt;/td&gt;
&lt;td&gt;将过去20个交易日的OHLC价格路径转换为图像，用CNN自动提取形态特征&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;环境依赖缺失&lt;/td&gt;
&lt;td&gt;预测关系在不同市场状态下可能不稳定，但许多研究忽视了这一点&lt;/td&gt;
&lt;td&gt;引入市场状态变量作为特征组，并进行半年度滚动窗口的跨期稳定性检验&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;h4&gt;统一比较框架的构建&lt;/h4&gt;
&lt;p&gt;引言提出了一种“逐层递进”的信息对比逻辑：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Set1（基础层）&lt;/strong&gt;：原始的价格、成交量、换手率、波动率等基本信息&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Set2（传统指标层）&lt;/strong&gt;：在Set1基础上加入RSI、MACD、布林带、ATR等技术指标&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Set3（市场状态层）&lt;/strong&gt;：再加入市场整体收益、波动率等宏观状态变量&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Set4（微观结构层）&lt;/strong&gt;：再加入StockJump（股价跳跃）和VPIN（信息交易概率）等微观结构变量&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;OHLC Image CNN（图像层）&lt;/strong&gt;：把价格路径转成图片交给深度学习模型&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Raw OHLCV CNN（对照层）&lt;/strong&gt;：用原始价格-成交量序列直接输入CNN，用来区分“图像表示”和“CNN架构”各自的作用&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这种分层设计的目的是：每增加一层信息，就能观察到它相对于前一层是否真的有边际增量价值。&lt;/p&gt;
&lt;h4&gt;观点链条&lt;/h4&gt;
&lt;p&gt;引言的论证逻辑可以概括为：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;基本价格-成交量信息本身就有一些短期预测能力（Set1在零成本下多空收益约10.26%）。&lt;/li&gt;
&lt;li&gt;传统技术指标（Set2）和市场状态变量（Set3）虽然增加了特征维度，但改进极其有限；甚至加入微观结构变量（Set4）后表现反而下降。&lt;/li&gt;
&lt;li&gt;OHLC图像CNN在1天预测任务中实现了20.29%的多空年化收益，远超所有结构化模型。&lt;/li&gt;
&lt;li&gt;但10个基点的交易成本几乎抹平了1天任务的所有利润，说明信号存在不等于经济价值存在。&lt;/li&gt;
&lt;li&gt;在5天预测任务中，OHLC图像CNN扣费后仍保持9.34%的净年化收益，说明拉长预测周期有助于缓解换手率压力。&lt;/li&gt;
&lt;/ol&gt;
&lt;h4&gt;三个贡献&lt;/h4&gt;
&lt;p&gt;引言最后总结了论文的贡献：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;在统一框架内系统比较了多个信息层次的技术信息；&lt;/li&gt;
&lt;li&gt;将评价标准从统计预测准确率转向交易成本约束下的投资组合经济价值；&lt;/li&gt;
&lt;li&gt;通过对比OHLC图像CNN与Raw OHLCV CNN，证明价格路径图像提供了传统结构化特征无法捕捉的有效非线性表示。&lt;/li&gt;
&lt;/ol&gt;
&lt;h3&gt;后续章节必须掌握的内容&lt;/h3&gt;
&lt;p&gt;要理解后续的方法论和实证结果，读者必须掌握以下几个核心技术设定：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;四层特征集合&lt;/strong&gt;：Set1到Set4是逐层递进的，从基础价格-成交量到微观结构变量，每一层都是在前一层上添加新特征。理解这个递进关系是读懂边际增量分析的前提。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;两个预测周期&lt;/strong&gt;：1天和5天。论文同时测试这两个周期，因为周期越短，换手率越高，交易成本侵蚀越严重；周期越长，信号相对稳定，但也可能丢失短期信息。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;两类深度学习模型&lt;/strong&gt;：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;OHLC Image CNN&lt;/strong&gt;：将过去20天OHLC价格数据转换成图像（或张量），交给卷积神经网络学习价格路径的空间模式&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Raw OHLCV CNN&lt;/strong&gt;：将原始的价格-成交量序列直接作为输入，同样用CNN处理&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;两者的区别是理解论文核心结论的关键：如果Raw OHLCV CNN表现差而OHLC Image CNN表现好，说明是“图像化表示”起了作用，而不是CNN架构本身。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;评价体系&lt;/strong&gt;：论文采用“组合优先、分类指标为辅”的双重评估方式。主要看多空组合年化收益率、夏普比率、组合换手率、扣费后净收益；AUC、Accuracy、F1只是辅助诊断。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;展开窗口滚动框架&lt;/strong&gt;：论文用半年度滚动窗口做样本外测试——训练集从最早的历史数据开始，每次测试最近半年，验证集取测试窗口之前半年，用验证集调参。这种设计避免了数据穿越（look-ahead bias）。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;10个基点交易成本&lt;/strong&gt;：这是后续所有“扣费后收益”计算的基础假设，相当于千分之一，即0.1%。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;样本范围&lt;/strong&gt;：沪深300指数（CSI 300）成分股，时间跨度为2019年4月2日至2025年12月30日，测试期为2022年上半年至2025年下半年。&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;h3&gt;公式、实验设置与定义解释&lt;/h3&gt;
&lt;p&gt;引言本身没有列出具体公式（公式出现在第3章方法论中），但它预设了几个重要的定义和实验参数，以下用通俗语言解释：&lt;/p&gt;
&lt;h4&gt;核心术语解释&lt;/h4&gt;
&lt;ul&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;OHLC&lt;/strong&gt;：Open（开盘价）、High（最高价）、Low（最低价）、Close（收盘价）。这是股票日K线中最基本的四个价格信息。论文把这些价格路径转换成图像，让机器“看”这张图来学习价格走势模式。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;CNN（卷积神经网络）&lt;/strong&gt;：一种深度学习模型，常用于图像识别。它的特点是能在图像上滑动窗口，自动提取局部特征（如边缘、纹理、形状）。论文用CNN从价格路径图像中提取“上涨形态”“下跌形态”等非线性模式。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;CSI 300&lt;/strong&gt;：沪深300指数，由A股市场中规模大、流动性好的300只股票组成，代表了中国蓝筹股的整体表现。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;Long-Short Portfolio（多空组合）&lt;/strong&gt;：把样本股票按模型预测的上涨概率排序，取最高的20%作为“多头”买入，取最低的20%作为“空头”卖出。这个组合的收益衡量了模型区分“未来会涨的股票”和“未来会跌的股票”的能力。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;Turnover（换手率）&lt;/strong&gt;：衡量投资组合在时间推移中发生了多少仓位变化。换手率越高，意味着需要频繁买卖股票，交易成本就越高。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;10 bps Transaction Costs（10个基点交易成本）&lt;/strong&gt;：每次交易需要支付0.1%的费用。这是中国A股市场比较常见的一个交易成本假设。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;Sharpe Ratio（夏普比率）&lt;/strong&gt;：衡量“每承受一单位风险能获得多少超额收益”。一个正且较高的夏普比率意味着投资策略在风险调整后仍然有利可图。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;VPIN（Volume-Synchronized Probability of Informed Trading）&lt;/strong&gt;：一种微观结构指标，用来度量市场中知情交易者（拥有信息优势的交易者）参与比例和订单流不平衡程度。通俗地说，它衡量的是买卖单之间“力量悬殊”的程度，有助于捕捉异常波动和潜在风险。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;StockJump&lt;/strong&gt;：股价跳跃特征指标，用于刻画股票价格在短时间内的剧烈波动（非连续的价格变化）。这类跳跃往往蕴含了突发信息。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;AUC / Accuracy / F1&lt;/strong&gt;：传统的机器学习分类评价指标。&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;AUC衡量模型区分正负样本的能力（0.5为随机，1为完美）&lt;/li&gt;
&lt;li&gt;Accuracy是预测正确样本占总样本的比例&lt;/li&gt;
&lt;li&gt;F1是精确率和召回率的调和平均&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;h4&gt;论文中的标签定义&lt;/h4&gt;
&lt;p&gt;虽然引言未直接写公式，但它在第1章明确提到“用未来区间复合收益定义方向性预测标签”。这个定义实际上来自第3章方法论中的两个公式：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;未来k日复合收益&lt;/strong&gt;：Rₜ⁽ʰ⁾ = (1+r₁)(1+r₂)...(1+rₖ) - 1，其中r是每日收益率，k取1或5。意思就是“未来1天/5天，这只股票累计涨了多少”。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;二分类标签&lt;/strong&gt;：如果未来k日复合收益为正，则标签为1（预测上涨）；否则标签为0（预测不涨或下跌）。&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;h4&gt;实验设计的通俗理解&lt;/h4&gt;
&lt;p&gt;论文的实验可以比喻为“信息含量层层加码”的对照实验：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;先只用最基础的价格和成交量数据（Set1），看模型能不能判断未来涨跌；&lt;/li&gt;
&lt;li&gt;在此基础上，加入大家熟悉的技术指标（Set2），看有没有额外的帮助；&lt;/li&gt;
&lt;li&gt;再加入市场整体环境的描述（Set3），看市场状态信息有没有额外价值；&lt;/li&gt;
&lt;li&gt;再加入更微观的交易结构数据（Set4），看深层交易信息有没有用；&lt;/li&gt;
&lt;li&gt;最后换一个完全不同的玩法——把价格走势画成图，让深度学习模型自己看图像判断（OHLC Image CNN）。&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;实验结果表明：步骤2-4的“加码”几乎没什么用，甚至有害；步骤5的图像方法则明显更有效，尤其当预测周期拉长到5天时，扣掉交易成本后仍然能获得稳定的正收益。&lt;/p&gt;

&lt;!-- zab:slot:chapter_ch1:end --&gt;
&lt;hr/&gt;
&lt;!-- zab:slot:chapter_ch2:done --&gt;
&lt;h2&gt;文献综述&lt;/h2&gt;
&lt;h3&gt;本章作用&lt;/h3&gt;
&lt;p&gt;文献综述（第2章）在全文中的功能是&lt;strong&gt;为实证研究建立理论依据和合法性&lt;/strong&gt;。它通过梳理四条研究脉络，说明为什么这篇论文要这样设计实验、为什么这样评价模型，以及它试图填补什么空白。&lt;/p&gt;
&lt;p&gt;具体来说，本章做了四件事：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;确立理论出发点&lt;/strong&gt;：从“股票收益预测”这一核心问题出发，说明为什么需要复杂模型（因为价格数据中有线性模型无法捕捉的非线性信息），以及为什么预测结果必须放在投资组合层面检验。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;完成视角转换&lt;/strong&gt;：通过引入“概率预测”方法论（Neuhierl et al.，2024），把评价标准从“分类是否准确”切换为“预测分数能否用于构建可盈利的投资组合”。这是全文方法论的哲学基础。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;逐层批判现有研究&lt;/strong&gt;：分别在技术指标、机器学习、市场状态三个方向指出已有研究的进展和局限，最后集中提炼出三个尚未解决的研究缺口。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;为实证设计“铺路”&lt;/strong&gt;：本章提出的“统一比较框架”“三类评价维度”“市场状态作为特征而非状态切换模型”等思路，直接决定了第3章的方法论和第4章的实证结果呈现方式。&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;一句话概括：&lt;strong&gt;引言提出问题，文献综述证明“为什么这个问题值得研究、为什么用这个方法研究是合理的”。&lt;/strong&gt;&lt;/p&gt;
&lt;h3&gt;关键概念与论证&lt;/h3&gt;
&lt;h4&gt;1. 概率预测视角（Probability Forecasting）&lt;/h4&gt;
&lt;p&gt;文献综述引用了Neuhierl et al.（2024）的一个重要主张：&lt;strong&gt;模型输出的概率预测不应只用于评估分类准确率，而应直接用于资产定价和组合构建。&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;这与传统做法的根本区别在于：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;传统做法：模型输出涨跌分类 → 计算AUC、Accuracy → 判断模型好坏&lt;/li&gt;
&lt;li&gt;本论文做法：模型输出“未来上涨的概率” → 按概率跨截面排序 → 构建多空组合 → 扣除交易成本后看是否赚钱&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这一转换是全文评价体系的“定海神针”。后续所有模型的评价都基于这个逻辑。&lt;/p&gt;
&lt;h4&gt;2. 非线性信息的理论动机&lt;/h4&gt;
&lt;p&gt;Kelly et al.（2024）证明：在收益预测中，变量之间的非线性关系和相互作用可能包含线性模型无法捕捉的信息。这从理论上为使用深度学习模型提供了合理性。&lt;/p&gt;
&lt;p&gt;但论文同时指出，&lt;strong&gt;“能用复杂模型”不等于“必须用复杂模型”&lt;/strong&gt;。因此，作者选择CNN不是为了追求模型复杂度，而是为了从价格路径中学习局部形态特征（local morphological patterns）。&lt;/p&gt;
&lt;h4&gt;3. 市场环境依赖性与样本敏感性&lt;/h4&gt;
&lt;p&gt;Cakici et al.（2023）和Hanauer &amp;amp; Kalsbach（2023）的研究表明：&lt;strong&gt;股票收益的可预测性高度依赖市场环境（市场类型、时间样本），不同市场的结果可能完全不同。&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;这一点至关重要，因为它暗示了：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;在某一个市场（如美股）有效的信号，在另一个市场（如A股）不一定有效；&lt;/li&gt;
&lt;li&gt;在某一段时间有效的预测关系，在另一段时间可能失效。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这为论文引入“半年度滚动窗口”“跨期稳定性检验”提供了理论依据。&lt;/p&gt;
&lt;h4&gt;4. 技术指标的本质——二次加工信息&lt;/h4&gt;
&lt;p&gt;文献综述通过一系列文献说明技术指标仍然有预测能力：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Shi et al.（2025）：技术指标对股票收益仍有预测力&lt;/li&gt;
&lt;li&gt;Mostafavi et al.（2025）：将技术指标按趋势、动量、波动率、成交量四个维度分类&lt;/li&gt;
&lt;li&gt;Wang et al.（2024）：将技术指标与筹码因子、新闻信息结合&lt;/li&gt;
&lt;li&gt;Albahli et al.（2023）：用DenseNet深度学习模型从技术指标中挖掘非线性信息&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;但文献综述紧接着指出一个关键问题：&lt;strong&gt;这些研究大多关注“预测能力”，而量化投资真正关心的是“能否通过稳定的组合收益赚钱”。&lt;/strong&gt; 这为论文强调“组合层面经济价值”提供了理论靶子。&lt;/p&gt;
&lt;h4&gt;5. 任务一致性原则（Task-Consistency Principle）&lt;/h4&gt;
&lt;p&gt;Wang, Z.（2025）提出了一个重要观点：&lt;strong&gt;模型性能的关键不是模型复杂度，而是模型设计与任务的匹配度。&lt;/strong&gt; 也就是说，不是模型越复杂越好，而是模型是否“适合”任务。&lt;/p&gt;
&lt;p&gt;这是论文选择CNN（而不是更复杂的Transformer或其他模型）的核心理由。作者强调：本文使用CNN不是为了展示深度学习的“豪华配置”，而是因为CNN擅长从图像中提取局部空间模式，这与“从价格路径图像中识别形态”这个任务高度一致。&lt;/p&gt;
&lt;h4&gt;6. 市场状态的非平稳性&lt;/h4&gt;
&lt;p&gt;Kijkarncharoensin et al.（2025）、Gupta et al.（2025）使用隐马尔可夫模型（HMM）识别市场状态；Horvath et al.（2024）用Wasserstein距离聚类证明市场结构具有非平稳性。&lt;/p&gt;
&lt;p&gt;文献综述指出：这些研究说明“市场不是一直处在一个稳定状态中”。但本论文的回应方式是一个简化处理：&lt;strong&gt;不把市场状态做成完整的机制转换模型（regime-switching），而是把市场状态变量作为一个特征组（Set3）加入预测模型。&lt;/strong&gt; 这是一个重要的方法论选择——降低了模型复杂度，但仍保留了市场层面的信息。&lt;/p&gt;
&lt;h4&gt;7. 三大研究缺口&lt;/h4&gt;
&lt;p&gt;文献综述在第2.5节明确列出了现有研究的三个尚未解决的问题：&lt;/p&gt;
&lt;table style=&quot;max-width:100%; width:auto; table-layout:auto; overflow-wrap:anywhere; word-break:break-word;&quot;&gt;
&lt;thead&gt;
&lt;tr&gt;
&lt;th&gt;缺口&lt;/th&gt;
&lt;th&gt;具体表现&lt;/th&gt;
&lt;th&gt;本论文的回应&lt;/th&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;&lt;tr&gt;
&lt;td&gt;&lt;strong&gt;缺乏统一比较框架&lt;/strong&gt;&lt;/td&gt;
&lt;td&gt;传统技术指标、市场状态变量、微观结构变量、价格路径图像表示很少在同一框架内被系统比较，各层信息的边际增量价值缺乏一致性结论&lt;/td&gt;
&lt;td&gt;构建Set1–Set4加OHLC Image CNN加Raw OHLCV CNN的统一比较框架&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;&lt;strong&gt;评价标准与经济价值脱节&lt;/strong&gt;&lt;/td&gt;
&lt;td&gt;现有文献倾向于用预测准确率或无成本预测力作为主导评价标准，忽视交易成本、组合换手率、多空组合的经济价值，导致统计预测力与可实施性之间存在鸿沟&lt;/td&gt;
&lt;td&gt;以扣费后多空净收益、夏普比率、换手率为主要评价指标&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;&lt;strong&gt;跨预测周期与跨市场状态的稳定性缺失&lt;/strong&gt;&lt;/td&gt;
&lt;td&gt;技术信息在不同预测周期（1天vs 5天）和不同市场状态下是否稳定，这一问题尚未被充分回答&lt;/td&gt;
&lt;td&gt;同时测试1天和5天预测任务，并通过半年度滚动窗口检验跨期稳定性&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;h3&gt;后续章节必须掌握的内容&lt;/h3&gt;
&lt;p&gt;读者在进入第3章方法论和第4章实证结果之前，必须理解以下几点：&lt;/p&gt;
&lt;h4&gt;1. 三个评价维度&lt;/h4&gt;
&lt;p&gt;文献综述第2.5节明确说明，本论文从三个维度进行系统分析：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;预测能力（Predictive Power）&lt;/strong&gt;：模型能否正确区分未来涨得好的股票和涨得差的股票（不扣成本）&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;组合经济价值（Portfolio Economic Value）&lt;/strong&gt;：预测信号转化为投资组合后，扣除交易成本是否还能创造超额收益&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;跨期稳定性（Cross-Period Stability）&lt;/strong&gt;：在不同时间窗口（不同半年）内，表现是否稳定，而不是只靠个别时段“撞大运”&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这三个维度贯穿了第4章的全部实证分析。&lt;/p&gt;
&lt;h4&gt;2. 特征集的递进逻辑（Set1–Set4）&lt;/h4&gt;
&lt;p&gt;文献综述虽然没有详细列出每个特征集的内容（这部分在第3章表1中给出），但它确立了“逐层递进”的比较逻辑：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Set1：基础价格-成交量信息（作为基准控制组）&lt;/li&gt;
&lt;li&gt;Set2：在Set1基础上加入传统技术指标&lt;/li&gt;
&lt;li&gt;Set3：在Set2基础上加入市场状态变量&lt;/li&gt;
&lt;li&gt;Set4：在Set3基础上加入StockJump和VPIN微观结构变量&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;读者必须理解：&lt;strong&gt;每一层都是在前一层基础上增加特征，目的是观察“新增信息是否真的带来了增量预测能力”。&lt;/strong&gt;&lt;/p&gt;
&lt;h4&gt;3. 两类CNN模型的区分逻辑&lt;/h4&gt;
&lt;p&gt;文献综述第2.3节提出了一个重要的对照设计：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;OHLC Image CNN&lt;/strong&gt;：将过去20个交易日的OHLC价格路径转换成图像/张量，交给CNN学习&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Raw OHLCV CNN&lt;/strong&gt;：直接把原始价格-成交量序列当作输入，同样用CNN处理&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;作者明确说明：&lt;strong&gt;设置Raw OHLCV CNN作为对照模型，是为了区分“图像表示”的贡献和“CNN架构”的贡献。&lt;/strong&gt; 如果OHLC Image CNN表现好而Raw OHLCV CNN表现差，就说明优势来自“把价格路径画成图”这个表示方式，而不是CNN架构本身。&lt;/p&gt;
&lt;h4&gt;4. 市场状态变量的定位&lt;/h4&gt;
&lt;p&gt;文献综述第2.4节特别强调：本论文虽然引入了市场状态变量，但&lt;strong&gt;不是做完整的市场机制转换分析（regime-switching），而是把市场状态作为Set3中的一个特征组&lt;/strong&gt;。&lt;/p&gt;
&lt;p&gt;这意味着读者不应期望看到HMM、马尔可夫链等状态识别模型。市场状态变量在本文中只是普通特征，与个股层面的技术指标并列输入模型。&lt;/p&gt;
&lt;h4&gt;5. 概率输出的使用方式&lt;/h4&gt;
&lt;p&gt;文献综述大量强调“概率预测”视角。读者需要建立这样的认知：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;模型输出的不是“涨/跌”的分类标签，而是“上涨概率”（0到1之间的数值）&lt;/li&gt;
&lt;li&gt;这个概率被用来做&lt;strong&gt;跨截面排序&lt;/strong&gt;（当天所有股票按概率从小到大的排序）&lt;/li&gt;
&lt;li&gt;排序后构造组合（前20%多头，后20%空头），而不是直接评价分类对的百分比&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这是理解第4章所有结果的关键前提。&lt;/p&gt;
&lt;h3&gt;公式、实验设置与定义解释&lt;/h3&gt;
&lt;p&gt;需要说明的是：&lt;strong&gt;文献综述这一章本身没有列出任何公式。&lt;/strong&gt; 所有数学公式都出现在第3章方法论中。但文献综述确实确立了一些重要定义和概念，这些概念在第3章被操作化为具体公式。以下用通俗语言解释文献综述中提到的关键定义：&lt;/p&gt;
&lt;h4&gt;核心术语定义&lt;/h4&gt;
&lt;ul&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;Cross-sectional return prediction（横截面收益预测）&lt;/strong&gt;：在同一时间点（同一天），预测不同股票之间的相对收益差异。目标是找到“哪些股票未来涨得多，哪些涨得少”，而不是预测某只股票自身的绝对涨跌幅度。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;Probability forecast（概率预测）&lt;/strong&gt;：模型输出的是“未来上涨的概率”，而不是单纯“涨/跌”的二元判断。例如，模型预测股票A未来5天上涨概率为0.62，股票B为0.48，那么股票A应被排在前面。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;High-dimensional data（高维数据）&lt;/strong&gt;：特征数量很多的数据，例如每只股票有几十个甚至上百个特征。文献综述指出，高维数据中的非线性关系和交互作用可能包含线性模型无法捕捉的信息。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;Technical indicators（技术指标）&lt;/strong&gt;：基于价格、成交量、波动率等基础数据计算出来的派生指标。常见的有RSI（相对强弱指标）、MACD（指数平滑移动平均线）、布林带宽度、ATR（平均真实波幅）等。文献综述的核心观点是：&lt;strong&gt;这些指标本质上是对基础价格-成交量信息的二次加工，并非独立的信息来源。&lt;/strong&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;Market state variables（市场状态变量）&lt;/strong&gt;：描述整个市场或行业层面状态的信息，例如市场整体收益、市场波动率等。文献综述强调，这些变量代表“环境信息”，与个股层面的特征不同。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;StockJump（股价跳跃特征）&lt;/strong&gt;：描述股票价格在短时间内出现剧烈、非连续变化的指标。它反映了突发信息或异常波动。文献综述提到它是一种“微观结构变量”，用于捕捉价格路径中的极端变化。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;VPIN（Volume-Synchronized Probability of Informed Trading）&lt;/strong&gt;：基于成交量同步抽样的知情交易概率，用来衡量订单流不平衡程度和知情交易者的参与强度。文献综述将其归类为“非线性高阶技术信息”之一。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;Regime-switching（机制转换）&lt;/strong&gt;：一种假设市场在不同状态（如牛市/熊市、高波动/低波动）之间转变的建模方法。文献综述指出，已有研究用HMM等方法识别这些状态，但本论文不做这种完整建模，而是把市场状态当作普通特征。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;Cross-sectional sorting（横截面排序）&lt;/strong&gt;：在每一个交易日，把所有股票按照模型预测的上涨概率从高到低排序，然后根据排名位置构建投资组合。这是文献综述强调的核心操作步骤。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;Long-Short portfolio（多空组合）&lt;/strong&gt;：做多预测概率最高的股票组（如前20%），同时做空预测概率最低的股票组（如后20%）。多空组合的收益主要反映“模型能否正确区分未来涨得好的股票和涨得差的股票”。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;Transaction cost（交易成本）&lt;/strong&gt;：实际交易中需要支付的费用，包括佣金、印花税、冲击成本等。文献综述批评现有研究忽视交易成本，而本论文将所有收益在10个基点（0.1%）的交易成本假设下重新计算。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;Turnover（换手率）&lt;/strong&gt;：投资组合在调整时更换股票的比例。换手率越高，意味着需要更频繁地买卖，交易成本越高。文献综述指出，这是“统计预测力无法转化为投资价值”的核心障碍。&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;h4&gt;文献综述中隐含但关键的实验设定&lt;/h4&gt;
&lt;p&gt;虽然公式在第3章，但文献综述已经预设了若干将在后续章节使用的关键设定：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;预测周期&lt;/strong&gt;：论文同时研究1天和5天两个预测周期。文献综述在第2.5节明确提出“不同预测周期下技术信息的稳定性”是一个未被解决的问题。1天任务代表高频信号（换手率极高），5天任务代表相对低频信号（换手率较低）。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;样本市场&lt;/strong&gt;：文献综述提到“国际市场”和“新兴市场”的研究（Cakici et al.，2023；Hanauer &amp;amp; Kalsbach，2023），暗示本论文的研究对象是A股市场（沪深300成分股），与这些国际研究形成对照。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;评价指标&lt;/strong&gt;：文献综述明确指出，本论文将“组合年化收益、夏普比率、交易成本调整后的净收益、组合换手率”作为主要评价指标，而AUC、Accuracy、F1仅作为辅助诊断指标。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;复杂模型的使用准则&lt;/strong&gt;：文献综述确立了一个原则——&lt;strong&gt;模型复杂度不是目的，任务一致性才是关键&lt;/strong&gt;。这最终决定了论文采用“CNN + OHLC图像”而不是“复杂模型 + 原始数据”的组合。&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;

&lt;!-- zab:slot:chapter_ch2:end --&gt;
&lt;hr/&gt;
&lt;!-- zab:slot:chapter_ch3:done --&gt;
&lt;h2&gt;方法论&lt;/h2&gt;
&lt;h3&gt;本章作用&lt;/h3&gt;
&lt;p&gt;第3章是全文从“理论问题”走向“实证检验”的桥梁。文献综述第2章已经提出三个研究缺口：缺乏统一比较框架、评价标准与经济价值脱节、跨周期与跨市场状态的稳定性没有被充分回答。第3章的作用就是把这三个缺口转化为可操作的实验设计。&lt;/p&gt;
&lt;p&gt;具体来说，这一章做了六件事：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;明确研究问题与检验逻辑&lt;/strong&gt;：提出核心假设——技术指标、市场状态变量、微观结构变量是否在基础价格-成交量信息之外具有“增量预测能力”，以及这种能力能否在扣除交易成本后形成可投资的组合收益。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;构建数据与标签体系&lt;/strong&gt;：定义什么是“未来上涨”，用未来1天和未来5天的复利收益构建二分类标签。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;设计四层递进特征集（Set1–Set4）&lt;/strong&gt;：从最基础的价格-成交量信息出发，逐层加入传统技术指标、市场状态变量、微观结构变量，用于检验每一类信息的增量贡献。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;设定统一模型与滚动训练机制&lt;/strong&gt;：所有结构化特征模型统一使用SGD Logistic模型，采用扩展窗口的滚动外样本预测框架，保证不同特征集之间可以横向比较。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;引入图像化价格路径模型&lt;/strong&gt;：将过去20个交易日的OHLC价格路径转换成图像，用CNN学习非线性形态特征；同时加入Raw OHLCV CNN作为对照，以区分“图像表示”和“CNN架构”各自的贡献。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;建立评价体系&lt;/strong&gt;：以组合层面收益和交易成本调整后表现为主要评价指标，分类指标（AUC、Accuracy、F1）仅作为辅助。&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;一句话概括：&lt;strong&gt;第3章把“研究问题”翻译成“数据、特征、模型、训练方式、评价指标”五个可操作模块，直接决定了第4章所有结果的含义和解读方式。&lt;/strong&gt;&lt;/p&gt;
&lt;h3&gt;这一章提出的关键概念、论证或技术细节&lt;/h3&gt;
&lt;h4&gt;1. 未来区间复利收益与方向标签&lt;/h4&gt;
&lt;p&gt;论文用两个公式定义预测目标。&lt;/p&gt;
&lt;p&gt;公式（1）是未来区间复利收益：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$R_{i,t}^{(h)} = \prod_{k=1}^{h} (1 + r_{i,t+k}) - 1, \quad h \in \{1, 5\}$&lt;/pre&gt;
&lt;p&gt;用通俗语言解释：股票 &lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt; 在交易日 &lt;span class=&quot;math&quot;&gt;$t$&lt;/span&gt; 之后 &lt;span class=&quot;math&quot;&gt;$h$&lt;/span&gt; 个交易日内的复利收益，就是把未来 &lt;span class=&quot;math&quot;&gt;$h$&lt;/span&gt; 天的每日收益率 &lt;span class=&quot;math&quot;&gt;$r$&lt;/span&gt; 连乘后再减1。比如 &lt;span class=&quot;math&quot;&gt;$h=5$&lt;/span&gt;，就是未来5天的累计收益率。&lt;/p&gt;
&lt;p&gt;公式（2）是二分类方向标签：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$y_{i,t}^{(h)} = \mathbb{1}(R_{i,t}^{(h)} &amp;gt; 0), \quad h \in \{1, 5\}$&lt;/pre&gt;
&lt;p&gt;意思是：如果未来 &lt;span class=&quot;math&quot;&gt;$h$&lt;/span&gt; 天复利收益大于0，标签为1；否则为0。这定义了模型要预测的任务——未来上涨还是不涨。&lt;/p&gt;
&lt;p&gt;这个设计的核心意义在于：&lt;strong&gt;模型输出的是“上涨概率”，而不是“涨跌分类”本身。&lt;/strong&gt; 这个概率后续被用来给股票排序，而不是直接用来计算准确率。&lt;/p&gt;
&lt;h4&gt;2. 四层递进特征集（Set1–Set4）&lt;/h4&gt;
&lt;p&gt;论文为了检验不同技术信息的增量价值，构造了四个逐层叠加的特征集：&lt;/p&gt;
&lt;table style=&quot;max-width:100%; width:auto; table-layout:auto; overflow-wrap:anywhere; word-break:break-word;&quot;&gt;
&lt;thead&gt;
&lt;tr&gt;
&lt;th&gt;特征集&lt;/th&gt;
&lt;th&gt;内容&lt;/th&gt;
&lt;th&gt;功能&lt;/th&gt;
&lt;th&gt;特征数量&lt;/th&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;&lt;tr&gt;
&lt;td&gt;Set1&lt;/td&gt;
&lt;td&gt;基础价格-成交量变量&lt;/td&gt;
&lt;td&gt;控制收益、波动率、成交量、换手率、流动性等基础信息&lt;/td&gt;
&lt;td&gt;13&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Set2&lt;/td&gt;
&lt;td&gt;Set1 + 传统技术指标&lt;/td&gt;
&lt;td&gt;检验传统技术指标是否提供增量预测能力&lt;/td&gt;
&lt;td&gt;30&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Set3&lt;/td&gt;
&lt;td&gt;Set2 + 市场状态变量&lt;/td&gt;
&lt;td&gt;检验市场整体收益、波动率、交易状态是否提供额外信息&lt;/td&gt;
&lt;td&gt;38&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Set4&lt;/td&gt;
&lt;td&gt;Set3 + StockJump + VPIN&lt;/td&gt;
&lt;td&gt;检验价格跳跃和订单流不平衡是否提供额外信息&lt;/td&gt;
&lt;td&gt;77&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;p&gt;这里有一个非常关键的论证：&lt;strong&gt;Set1并非“原始数据”，而是经过筛选、清洗、标准化后的基准控制变量组，已包含收益、波动率、流动性、市值等基础维度。&lt;/strong&gt; 论文在这之后专门用一段话解释：为什么Set2加入传统技术指标后增量效果很弱，这在理论上完全合理。&lt;/p&gt;
&lt;p&gt;因为传统技术指标本质上是对基础价格-成交量信息的二次加工：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;RSI基于历史涨跌差异计算；&lt;/li&gt;
&lt;li&gt;MACD基于不同周期移动平均线的差值；&lt;/li&gt;
&lt;li&gt;布林带宽度直接映射历史波动率；&lt;/li&gt;
&lt;li&gt;ATR刻画日内价格振幅。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;既然Set1已经覆盖了这些底层信息，那么Set2的技术指标在信息内容上并没有提供“新的原始信息”，因此难以产生显著的边际预测能力。这个论证是第4章解释实证结果的重要基础。&lt;/p&gt;
&lt;h4&gt;3. 统一模型与扩展窗口滚动训练&lt;/h4&gt;
&lt;p&gt;论文没有用不同模型来比较不同特征集，而是规定：&lt;strong&gt;所有结构化特征集都使用同一个SGD Logistic模型。&lt;/strong&gt; 输入为过去20个交易日的数据，输出为未来1天和未来5天的方向预测。&lt;/p&gt;
&lt;p&gt;训练机制采用“扩展窗口滚动法”：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;测试期从2022年上半年到2025年下半年，每半年一个测试窗口；&lt;/li&gt;
&lt;li&gt;每个测试窗口前半年为验证窗口，用于选择超参数和最优模型结构；&lt;/li&gt;
&lt;li&gt;验证窗口之前的所有样本作为扩展训练集。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这种设计的目的是防止数据窥探和过拟合，同时保证所有模型在相同的时间序列划分下进行训练和测试，使得横向比较有效。&lt;/p&gt;
&lt;p&gt;在数据预处理上，论文采用&lt;strong&gt;横截面分位数排序&lt;/strong&gt;进行特征标准化，即每一天内对所有股票按同一特征值排序，再转换为分位数，避免变量量纲差异和极端值影响。标准化器只用在训练集上拟合，防止测试集信息泄漏。&lt;/p&gt;
&lt;p&gt;此外，样本筛选规则非常严格：&lt;strong&gt;如果某个样本的未来收益计算窗口与验证/测试期重叠，该样本会被直接剔除。&lt;/strong&gt; 这是为了避免标签泄漏，保证外样本预测的纯净性。&lt;/p&gt;
&lt;h4&gt;4. 图像化价格路径模型（OHLC Image CNN）&lt;/h4&gt;
&lt;p&gt;这是全文最核心的模型扩展。传统结构化特征只能输入数值型指标，论文则把过去20个交易日的OHLC价格路径转换为图像或张量，交给CNN学习。&lt;/p&gt;
&lt;p&gt;这样做的好处是：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;不需要人为定义技术形态规则；&lt;/li&gt;
&lt;li&gt;可以自动发现价格波动结构、日内价格振幅特征、成交量与价格的匹配关系；&lt;/li&gt;
&lt;li&gt;可以捕捉传统指标无法覆盖的非线性信息。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;论文同时设置了一个&lt;strong&gt;Raw OHLCV CNN&lt;/strong&gt;作为对照模型：它直接输入原始价格-成交量序列，不经过图像化表示。这个对照组的目的是区分“CNN架构本身”和“图像化价格路径表示”哪个贡献更大。如果OHLC Image CNN表现好而Raw OHLCV CNN表现差，就说明优势来自图像化表示方式，而不是深度学习模型本身。&lt;/p&gt;
&lt;h4&gt;5. 组合层面的评价体系&lt;/h4&gt;
&lt;p&gt;论文在第3.6节确立了“组合表现为主、分类指标为辅”的双重评价逻辑。具体操作是：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;用模型输出的外样本上涨概率对所有股票进行横截面排序；&lt;/li&gt;
&lt;li&gt;将股票等分为五组（五分位数），概率最高为Q5，最低为Q1；&lt;/li&gt;
&lt;li&gt;构造两个组合：&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;多头组合&lt;/strong&gt;：持有Q5，衡量选股能力；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;多空组合&lt;/strong&gt;：做多Q5、做空Q1，衡量横截面排序能力，同时规避市场整体波动。&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;主要评价指标为：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;多头和多空组合的年化收益；&lt;/li&gt;
&lt;li&gt;夏普比率；&lt;/li&gt;
&lt;li&gt;交易成本调整后的净收益；&lt;/li&gt;
&lt;li&gt;组合换手率。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;AUC、Accuracy、F1仅作为辅助诊断指标。论文特别说明：多空组合被理解为标准的学术组合构建方式，而不是可直接落地的A股交易策略。&lt;/p&gt;
&lt;h3&gt;读者理解后续章节必须掌握的内容&lt;/h3&gt;
&lt;h4&gt;1. 特征集的递进逻辑是“增量比较”&lt;/h4&gt;
&lt;p&gt;读者必须理解：Set1是基准，后面每一层都在前一层基础上增加特征。第4章反复说的是“Set2相对Set1的提升有限”“Set3相对Set2的提升有限”“Set4甚至下降”。这背后的比较逻辑是：&lt;strong&gt;我们看的是“新增信息是否真的带来了新的预测能力”，而不是看哪个特征集绝对表现最好。&lt;/strong&gt;&lt;/p&gt;
&lt;h4&gt;2. 预测概率用于排序，不是用于分类&lt;/h4&gt;
&lt;p&gt;这是理解第4章结果的关键。所有模型输出的是0到1之间的“上涨概率”，然后按概率大小排序，分成Q1到Q5。组合收益来自“前20%和后20%的差异”，不是来自“预测对了多少个”。&lt;/p&gt;
&lt;p&gt;因此，即使AUC只有0.51左右（接近随机猜测），只要模型能把未来涨得好的股票排在前面、把涨得差的股票排在后面，就能产生多空收益。第4章第3节专门用这个逻辑解释为什么AUC和组合回报之间没有直接关系。&lt;/p&gt;
&lt;h4&gt;3. 1天与5天的区分是“换手率”与“预测周期”的权衡&lt;/h4&gt;
&lt;p&gt;论文同时测试了1天和5天两个预测任务：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;1天任务：信号周期短，换手率极高（约1.16–1.22），交易成本侵蚀严重；&lt;/li&gt;
&lt;li&gt;5天任务：信号周期长，换手率显著下降（OHLC Image CNN约0.517），交易成本压力较小。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;读者必须记住：&lt;strong&gt;1天任务的优势在零成本下很明显，但在10 bps成本下几乎全部消失；5天任务虽然零成本收益不如1天任务，但扣费后仍能保持正收益。&lt;/strong&gt; 这是第4章最核心的实证发现。&lt;/p&gt;
&lt;h4&gt;4. 10 bps交易成本是评价经济价值的关键门槛&lt;/h4&gt;
&lt;p&gt;论文在所有扣费场景中统一使用10 bps（0.1%）的单边交易成本。10 bps是一个较低但有代表性的成本假设。读者需要理解：如果组合换手率很高，即使每次预测都有一点优势，频繁买卖也会把利润全部吃掉。因此，&lt;strong&gt;“有预测信号”不等于“能赚钱”。&lt;/strong&gt;&lt;/p&gt;
&lt;h4&gt;5. 半年度滚动稳定性分析是判断“真本事”的重要证据&lt;/h4&gt;
&lt;p&gt;论文用8个半年度测试窗口来检验模型的跨期稳定性。如果模型只在某几个特定窗口表现好，那可能是“撞大运”；如果大多数窗口都有正收益，那才算具有稳健性。第4章中OHLC Image CNN（5天）在8个窗口中有6个为正收益，平均净年化收益9.43%，平均净夏普0.777，这是支撑结论的关键证据。&lt;/p&gt;
&lt;h4&gt;6. Raw OHLCV CNN的意义在于“排除法”&lt;/h4&gt;
&lt;p&gt;读者需要记住Raw OHLCV CNN的存在。它的表现比OHLC Image CNN差，说明CNN架构本身不是优势来源，真正的优势来自“将价格路径画成图像”这种表示方式。这个对照设计是全文区分“模型复杂度贡献”和“表示方式贡献”的核心手段。&lt;/p&gt;
&lt;h3&gt;公式、实验设置与定义解释&lt;/h3&gt;
&lt;h4&gt;公式（1）：未来区间复利收益&lt;/h4&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$R_{i,t}^{(h)} = \prod_{k=1}^{h} (1 + r_{i,t+k}) - 1, \quad h \in \{1, 5\}$&lt;/pre&gt;
&lt;p&gt;通俗解释：假设股票今天收盘后，未来1天收益率为1%，未来2天收益率为2%，那么未来2天的复利收益就是 &lt;span class=&quot;math&quot;&gt;$(1+0.01)(1+0.02)-1 = 0.0302$&lt;/span&gt;，即3.02%。这个公式把未来 &lt;span class=&quot;math&quot;&gt;$h$&lt;/span&gt; 天的每日收益率复合起来，得到完整的区间收益。&lt;/p&gt;
&lt;h4&gt;公式（2）：方向标签&lt;/h4&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$y_{i,t}^{(h)} = \mathbb{1}(R_{i,t}^{(h)} &amp;gt; 0), \quad h \in \{1, 5\}$&lt;/pre&gt;
&lt;p&gt;通俗解释：如果上述区间收益大于0，标签为1，表示“未来上涨”；如果小于等于0，标签为0，表示“未来不涨”。这是一个标准的二分类标签定义。&lt;/p&gt;
&lt;h4&gt;解释：StockJump和VPIN&lt;/h4&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;StockJump&lt;/strong&gt;：度量股价在短时间内发生剧烈、非连续变化的特征，反映突发信息或异常波动。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;VPIN&lt;/strong&gt;（Volume-Synchronized Probability of Informed Trading）：基于成交量同步抽样的知情交易概率，衡量订单流不平衡程度和知情交易者参与强度。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这两个变量被归类为“非线性高阶技术信息”，用于补充传统价格-成交量指标之外的微观结构信息。&lt;/p&gt;
&lt;h4&gt;解释：市场状态变量&lt;/h4&gt;
&lt;p&gt;市场状态变量描述的是市场整体或行业层面的状态，如市场整体收益、市场波动率、市场交易活跃度。论文将它们作为Set3中的一个普通特征组加入模型，而不是用完整的机制转换模型（如隐马尔可夫模型）来识别市场阶段。&lt;/p&gt;
&lt;h4&gt;解释：横截面分位数排序标准化&lt;/h4&gt;
&lt;p&gt;在每一天内，将所有股票按某一特征值从小到大排序，并映射到0到1之间的分位数。这样做可以消除不同股票间量纲差异和极端值的影响，同时保留当天的横截面相对信息。标准化器只在训练集上拟合，避免测试集信息泄漏。&lt;/p&gt;
&lt;h4&gt;解释：扩展窗口滚动训练&lt;/h4&gt;
&lt;p&gt;假设当前测试窗口是2024年上半年。那么：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;验证窗口：2023年下半年；&lt;/li&gt;
&lt;li&gt;训练窗口：2023年上半年及之前的所有样本。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;当测试窗口移动到2024年下半年时，训练窗口就扩展到2024年上半年及之前。这种设计确保模型在测试时只使用测试期之前的信息，避免未来数据泄漏。&lt;/p&gt;
&lt;h4&gt;解释：五分位数组合（Q1–Q5）&lt;/h4&gt;
&lt;p&gt;每个交易日，将所有股票按预测上涨概率从低到高排序，平均分成五组：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Q1：概率最低的20%；&lt;/li&gt;
&lt;li&gt;Q2：次低的20%；&lt;/li&gt;
&lt;li&gt;Q3：中间的20%；&lt;/li&gt;
&lt;li&gt;Q4：次高的20%；&lt;/li&gt;
&lt;li&gt;Q5：概率最高的20%。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;多空组合 = 做多Q5 + 做空Q1。如果Q5未来收益高于Q1，说明模型具有一定的横截面排序能力。&lt;/p&gt;
&lt;h4&gt;解释：换手率&lt;/h4&gt;
&lt;p&gt;换手率衡量投资组合在一定时间内需要更换多少持仓。换手率越高，意味着买卖频率越高，交易成本越大。论文中1天任务换手率约1.16–1.22，意味着组合几乎每天都要翻一遍；5天OHLC Image CNN换手率约0.517，意味着每半年组合持仓约更换一半左右。&lt;/p&gt;
&lt;h4&gt;解释：交易成本调整后的净收益&lt;/h4&gt;
&lt;p&gt;净收益 = 毛收益 − 换手率 × 单边交易成本。论文统一使用10 bps（0.1%）成本，即每次买卖都要支付0.1%的费用。如果组合年化换手率为20倍，那么交易成本就可能吃掉2%的收益；如果换手率达到100倍，交易成本就高达10%。因此，&lt;strong&gt;预测周期越短、换手率越高，净收益越容易被侵蚀。&lt;/strong&gt;&lt;/p&gt;

&lt;!-- zab:slot:chapter_ch3:end --&gt;
&lt;hr/&gt;
&lt;!-- zab:slot:chapter_ch4:done --&gt;
&lt;h2&gt;实证结果与分析&lt;/h2&gt;
&lt;h3&gt;本章作用&lt;/h3&gt;
&lt;p&gt;第4章是全文实证检验的核心章节。第3章已经搭建了“特征集—模型—滚动训练—评价体系”这套实验框架，但框架本身不产生结论。第4章的作用，就是把这套框架真正跑起来，用数据回答三个问题：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;不同层次的技术信息（传统技术指标、市场状态变量、微观结构变量）是否在基础价格—成交量信息之外，具有&lt;strong&gt;增量预测能力&lt;/strong&gt;？&lt;/li&gt;
&lt;li&gt;这些预测能力在扣除交易成本之后，是否能转化为&lt;strong&gt;有经济价值的组合收益&lt;/strong&gt;？&lt;/li&gt;
&lt;li&gt;这种能力能否在不同市场阶段中保持&lt;strong&gt;稳定&lt;/strong&gt;，而不是只靠某个特定时期“撞运气”？&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;因此，第4章是连接“统计意义上的预测”与“投资意义上的可实施性”之间的关键检验。它直接决定了第5章结论的成立基础：哪些信息真正有用，哪些只是看似有用。&lt;/p&gt;
&lt;h3&gt;关键概念、论证或技术细节&lt;/h3&gt;
&lt;p&gt;这一章的论证结构清晰，围绕三条证据链展开：&lt;strong&gt;零成本下的排序能力、扣成本后的经济价值、跨期稳定性&lt;/strong&gt;。&lt;/p&gt;
&lt;h4&gt;1. 零成本条件下：传统技术指标的增量价值有限&lt;/h4&gt;
&lt;p&gt;在还没有引入交易成本的时候，所有模型都基于预测上涨概率构造“多空组合”（做多预测概率最高的Q5组，做空概率最低的Q1组）。这个阶段的收益可以看作模型识别“未来谁涨得好、谁涨得差”的原始能力。&lt;/p&gt;
&lt;p&gt;1天预测任务中，四个结构化特征集的表现如下：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Set1（基础价格—成交量，13个特征）：多空年化收益10.26%，夏普比率0.550；&lt;/li&gt;
&lt;li&gt;Set2（加入传统技术指标，30个特征）：收益11.48%，夏普0.689；&lt;/li&gt;
&lt;li&gt;Set3（加入市场状态变量，38个特征）：收益11.75%，夏普0.687；&lt;/li&gt;
&lt;li&gt;Set4（加入StockJump和VPIN，77个特征）：收益大幅下降到2.79%，夏普仅0.187。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这组数字说明一个核心问题：&lt;strong&gt;特征数量增加不等于信息增量增加。&lt;/strong&gt; Set2和Set3相对Set1的提升非常有限，说明传统技术指标和市场状态变量本质上还是在重复基础价格—成交量信息。最典型的是Set4，加入微观结构变量后收益反而暴跌。这说明StockJump和VPIN在当前日频预测框架下，更多是引入噪声，而不是有效信号。&lt;/p&gt;
&lt;p&gt;与此同时，OHLC Image CNN在1天任务中取得20.29%的多空年化收益，夏普比率1.486，显著超过所有结构化模型。这为后续论证提供了第一个证据：&lt;strong&gt;价格路径图像中包含传统结构化特征难以捕捉的非线性信息。&lt;/strong&gt;&lt;/p&gt;
&lt;h4&gt;2. 扣成本条件下：1天信号几乎被交易成本吞噬&lt;/h4&gt;
&lt;p&gt;“预测能力”不等于“投资能力”。所有预测要变成真实利润，必须经过交易。交易就要付出成本。论文统一设定10 bps（0.1%）单边交易成本，检验经济可行性。&lt;/p&gt;
&lt;p&gt;结果非常残酷：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;1天任务中，所有结构化模型扣费后的多空年化收益全部由正转负：Set1从10.26%跌到-19.01%，Set2跌到-17.85%，Set3跌到-17.61%，Set4跌到-27.96%；&lt;/li&gt;
&lt;li&gt;1天任务的组合换手率全部维持在1.16–1.22之间，意味着组合几乎每天都要更换一遍持仓；&lt;/li&gt;
&lt;li&gt;即使表现最好的OHLC Image CNN，1天扣费后年化收益也从20.29%骤降到0.05%，净夏普只有0.004。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这组数据揭示了一个重要事实：&lt;strong&gt;信号存在，不代表能赚钱。&lt;/strong&gt; 1天预测周期太短，换手率太高，预测收益完全被交易成本吞掉。&lt;/p&gt;
&lt;h4&gt;3. 5天任务：图像模型展现出真正的经济价值&lt;/h4&gt;
&lt;p&gt;延长预测周期是降低换手率的自然方法。论文进一步检验5天预测任务：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;结构化模型（Set1–Set4）扣费后多空年化收益仍然全部为负，分别是-2.63%、-2.72%、-0.99%、-0.32%；&lt;/li&gt;
&lt;li&gt;OHLC Image CNN在零成本下多空年化收益11.94%，夏普0.974；扣费后仍保留&lt;strong&gt;9.34%的正净年化收益&lt;/strong&gt;，净夏普&lt;strong&gt;0.761&lt;/strong&gt;；&lt;/li&gt;
&lt;li&gt;其5天换手率只有0.517，远低于1天任务的1.16–1.22。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这意味着5天图像模型不仅发现了有效的横截面排序信息，而且这种信息在扣掉交易成本后仍然能够形成正收益。这是全文最核心的实证发现。&lt;/p&gt;
&lt;h4&gt;4. Raw OHLCV CNN对照组：证明优势来自图像表示，而不是CNN架构&lt;/h4&gt;
&lt;p&gt;论文设置了一个重要的对照组——Raw OHLCV CNN。这个模型同样使用CNN架构，但输入是原始的“价格—成交量”数值序列，而不是图像化表示。&lt;/p&gt;
&lt;p&gt;关键结果：5天任务扣费后，Raw OHLCV CNN的多空年化收益为-1.71%，明显弱于OHLC Image CNN的+9.34%。这说明&lt;strong&gt;CNN架构本身不是优势来源&lt;/strong&gt;。真正起作用的是“将价格路径转化为图像”这种表示方式。图像保留了价格路径的空间形态信息，而原始数值序列很难让CNN捕捉到这种形态。&lt;/p&gt;
&lt;h4&gt;5. 分类指标与组合收益的脱钩：AUC高≠能赚钱&lt;/h4&gt;
&lt;p&gt;论文同时报告了AUC、Accuracy、F1等传统分类指标（表2）。结果发现：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;所有模型的AUC都集中在0.50–0.516之间，最接近随机猜测（0.5）；&lt;/li&gt;
&lt;li&gt;最好的AUC是Raw OHLCV CNN在1天任务中的0.516和OHLC Image CNN在5天任务中的0.514；&lt;/li&gt;
&lt;li&gt;但OHLC Image CNN的组合收益远远高于其他模型。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这个对比非常关键，它说明在股票横截面预测中，&lt;strong&gt;分类准确率和投资回报之间没有直接关系&lt;/strong&gt;。原因是：组合构建不是依赖“预测对了多少个”，而是依赖“预测概率的横截面排序”。只要模型能把未来表现好的股票排在前20%，把表现差的排在后20%，即使AUC只有0.51，也能产生多空收益。因此，用AUC评价技术指标的增量价值会产生严重误导。&lt;/p&gt;
&lt;h4&gt;6. 半年度稳定性分析：5天图像模型不是单次运气&lt;/h4&gt;
&lt;p&gt;为了避免结论被某个特定市场阶段“绑架”，论文用8个半年度测试窗口（2022上半年—2025下半年）检验模型的跨期稳定性：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;5天OHLC Image CNN：8个窗口中6个为正收益，平均净年化收益9.43%，平均净夏普0.777；&lt;/li&gt;
&lt;li&gt;1天OHLC Image CNN：8个窗口中仅5个为正，平均净年化收益-0.15%；&lt;/li&gt;
&lt;li&gt;Raw OHLCV CNN 5天：只有4个窗口为正，平均净年化收益-1.63%；&lt;/li&gt;
&lt;li&gt;Set2/Set3/Set4的1天任务表现尤其糟糕，Set4 1天甚至0个窗口为正，平均净年化收益-28.20%。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这些结果进一步证明：&lt;strong&gt;5天图像模型的经济价值不是来自某个特殊时期的偶然，而是具有跨市场阶段的稳健性。&lt;/strong&gt;&lt;/p&gt;
&lt;h3&gt;读者理解后续章节必须掌握的内容&lt;/h3&gt;
&lt;h4&gt;1. “增量价值”的比较逻辑&lt;/h4&gt;
&lt;p&gt;第4章最重要的比较不是“哪个模型绝对收益最高”，而是“在基础信息之上，新增信息是否带来了额外的预测能力”。因此，读者必须记住：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Set1是基准；&lt;/li&gt;
&lt;li&gt;Set2相对Set1的提升很小，说明传统技术指标是基础信息的二次加工，没有新增原始信息；&lt;/li&gt;
&lt;li&gt;Set3相对Set2提升也很小，说明市场状态变量对个股横截面排序帮助有限；&lt;/li&gt;
&lt;li&gt;Set4相对Set3反而下降，说明微观结构变量在当前日频框架下更多是噪声。&lt;/li&gt;
&lt;/ul&gt;
&lt;h4&gt;2. 预测概率用于排序，不用于分类&lt;/h4&gt;
&lt;p&gt;所有模型输出的是0到1的“上涨概率”，然后按概率从低到高排序，分成5组（Q1到Q5）。投资收益来自Q5和Q1之间的差异，而不是“预测对了多少个”。因此，AUC低不代表组合收益低，AUC高也不代表组合收益高。第4章用AUC和组合收益的脱钩，直接解释了这个反直觉现象。&lt;/p&gt;
&lt;h4&gt;3. 1天与5天的核心区别是“换手率”&lt;/h4&gt;
&lt;p&gt;1天任务和5天任务之间的差异，本质上不是预测难度，而是&lt;strong&gt;换手率带来的成本压力&lt;/strong&gt;：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;1天任务换手率1.16–1.22，意味着持仓几乎每天翻一遍，10 bps成本迅速吞噬利润；&lt;/li&gt;
&lt;li&gt;5天任务换手率0.517，意味着每半年持仓更换约一半，成本压力小得多。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;因此读者必须记住：&lt;strong&gt;1天任务零成本下有优势，扣成本后利润几乎全部消失；5天任务虽然零成本收益不如1天，但扣成本后仍然保持正收益。&lt;/strong&gt;&lt;/p&gt;
&lt;h4&gt;4. Raw OHLCV CNN是排除法，不是陪跑&lt;/h4&gt;
&lt;p&gt;Raw OHLCV CNN的存在，是为了排除“CNN架构本身”这个可能解释。它表现差，说明5天图像模型的优势来自“图像化价格路径表示”，而不是深度学习架构的复杂度。读者后续看到类似“深度学习技术是否有效”的结论时，必须意识到作者已经通过对照组控住了架构变量。&lt;/p&gt;
&lt;h4&gt;5. 多空组合是学术评价方式，不是实盘策略&lt;/h4&gt;
&lt;p&gt;论文反复强调，多空组合（做多Q5、做空Q1）是标准的学术组合构建方式，用来衡量横截面排序能力，同时规避市场整体波动。它不直接等同于可投资的A股实盘策略，因为卖空在现实中可能受到限制。读者不应该据此过度解读为“可以直接用来交易”。&lt;/p&gt;
&lt;h4&gt;6. 半年度窗口稳定性是判断“真本事”的试金石&lt;/h4&gt;
&lt;p&gt;8个半年度窗口的检验，核心目的是排除“模型只在特定市场阶段有效”的偶然性。5天图像模型在6/8个窗口取得正收益，说明它在牛市、熊市、震荡市中都有一定的适应能力。这是结论能够成立的重要证据。&lt;/p&gt;
&lt;h3&gt;实验设置与定义解释&lt;/h3&gt;
&lt;p&gt;第4章虽然没有出现新的数学公式，但涉及多个关键实验设置和定义。以下用通俗语言解释。&lt;/p&gt;
&lt;h4&gt;10 bps交易成本&lt;/h4&gt;
&lt;p&gt;10 bps就是0.1%。每次买入或卖出股票，都要支付0.1%的费用。例如，你花100元买入一只股票，需要额外支付0.1元费用；卖出时同样支付0.1%。10 bps是一个相对较低但现实的市场成本假设。它之所以重要，是因为高频交易中即使每次只付0.1%，一年下来累积的成本也会非常可观。&lt;/p&gt;
&lt;h4&gt;换手率&lt;/h4&gt;
&lt;p&gt;换手率衡量投资组合在一段时间内更换持仓的比例。如果换手率为1.16，意味着一年内组合的持仓相当于完全更换了1.16次。换手率越高，交易越频繁，交易成本越大。因此，预测周期越短，换手率越高，成本侵蚀越严重。&lt;/p&gt;
&lt;h4&gt;五分位数组合（Q1–Q5）&lt;/h4&gt;
&lt;p&gt;每天把所有股票按照模型预测的上涨概率从低到高排序，平均分成5组，每组20%：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Q1：概率最低的20%；&lt;/li&gt;
&lt;li&gt;Q2：次低的20%；&lt;/li&gt;
&lt;li&gt;Q3：中间20%；&lt;/li&gt;
&lt;li&gt;Q4：次高的20%；&lt;/li&gt;
&lt;li&gt;Q5：概率最高的20%。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;多空组合 = 做多Q5 + 做空Q1。如果Q5未来涨得比Q1多，说明模型具备横截面排序能力。&lt;/p&gt;
&lt;h4&gt;零成本 vs 扣成本&lt;/h4&gt;
&lt;p&gt;零成本场景用于检验模型“原本的预测能力”，即不考虑交易摩擦。扣成本场景在每笔交易中扣除10 bps费用，用于检验模型的“经济可实现价值”。两者的差值反映了交易成本对利润的侵蚀程度。&lt;/p&gt;
&lt;h4&gt;半年度滚动测试窗口&lt;/h4&gt;
&lt;p&gt;测试期从2022年上半年到2025年下半年，每半年作为一个测试窗口，共8个窗口。每个窗口之前半年为验证窗口，用于选择超参数；验证窗口之前的所有数据作为扩展训练集。这样做的目的是保证模型在测试时只能使用测试期之前的信息，避免数据泄漏和过拟合。&lt;/p&gt;
&lt;h4&gt;样本剔除规则&lt;/h4&gt;
&lt;p&gt;如果某个样本的“未来收益计算窗口”跨越了验证期或测试期，这个样本会被直接剔除。例如，如果预测目标是未来5天收益，而某天的未来5天包含了下半年的开始，那么该样本会被丢弃。这是为了防止标签信息与测试期重叠，保证外样本预测的纯净性。&lt;/p&gt;
&lt;h4&gt;OHLC Image CNN与Raw OHLCV CNN&lt;/h4&gt;
&lt;p&gt;OHLC Image CNN把过去20个交易日的开盘价、最高价、最低价、收盘价（OHLC）转换成图像或张量，然后交给CNN学习。这种表示方式保留了价格路径的空间形态，比如连续上涨、跳空、波动放大等。&lt;/p&gt;
&lt;p&gt;Raw OHLCV CNN则直接把原始的价格—成交量数值序列作为输入，不做图像化处理。两者的区别在于“表示方式”不同，而CNN架构相同。通过比较两者，可以判断优势究竟来自“图像表示”还是“深度学习模型本身”。&lt;/p&gt;
&lt;h4&gt;年化收益与夏普比率&lt;/h4&gt;
&lt;p&gt;年化收益就是把区间收益折算成一年期的收益率，方便不同时间长度之间比较。夏普比率是衡量“承担每单位风险能获得多少超额收益”的指标。夏普比率越高，说明在相同风险下收益越好；一般认为大于1是较好的表现，大于0.5是可用水平。论文中5天OHLC Image CNN扣费后净夏普0.761，属于中上水平。&lt;/p&gt;

&lt;!-- zab:slot:chapter_ch4:end --&gt;
&lt;hr/&gt;
&lt;!-- zab:slot:chapter_ch5:done --&gt;
&lt;h2&gt;结论&lt;/h2&gt;
&lt;h3&gt;本章作用&lt;/h3&gt;
&lt;p&gt;结论（Conclusion）是整篇论文的收束章节。它的作用不是继续展示数据或模型细节，而是把第4章实证检验的结果提炼成最终的判断题：不同层次的技术信息到底有没有用？能不能在扣除交易成本后变成真实可拿到的钱？同时，它也对研究边界做出清晰说明，告诉读者“本文结论在什么条件下成立、不适用于什么场景”。读者如果没有时间读完全文，只需要读这一章，就能迅速把握文章的核心结论和主要贡献。&lt;/p&gt;
&lt;h3&gt;关键概念、论证或技术细节&lt;/h3&gt;
&lt;h4&gt;1. 增量价值的最终判断：结构化技术信息的边际价值有限&lt;/h4&gt;
&lt;p&gt;结论首先回到全文的核心研究问题。作者指出，基础的价格—成交量信息本身已经包含大量的短期预测信息。在此基础上，依次加入传统技术指标（Set2）、市场状态变量（Set3）、StockJump和VPIN微观结构变量（Set4），并没有带来一致的组合收益提升。作者对这一结果给出了明确解释：很多传统技术指标本质上是对价格、收益、成交量、波动率等基础信息的“二次加工”，并不是独立的原始信息源。因此，在日频横截面的预测框架下，它们很难在全面控制基础变量之后继续提供增量信息。&lt;/p&gt;
&lt;p&gt;这不是说这些指标完全没用，而是说它们的大部分信息已经被Set1的基础变量覆盖；剩余的边际贡献不足以转化为稳定的组合收益。&lt;/p&gt;
&lt;h4&gt;2. 核心证据：5天OHLC Image CNN具有经济价值&lt;/h4&gt;
&lt;p&gt;结论用一句话概括全文最重要的实证发现：5天OHLC Image CNN模型，在扣除10 bps单边交易成本后，仍然保持9.34%的多空净年化收益，净夏普比率为0.761。这一表现显著优于所有结构化特征模型，也优于作为对照组的Raw OHLCV CNN。&lt;/p&gt;
&lt;p&gt;这个结果支持了一个关键论点：把过去20个交易日的开盘价、最高价、最低价、收盘价路径转化为图像表示，能够保留传统人工指标难以提取的非线性“形态信息”。同时，5天预测周期比1天更长，换手率大幅下降，使得预测信号能够扛过交易成本的消耗，最终被转化为可实施的投资收益。&lt;/p&gt;
&lt;h4&gt;3. 对照实验的价值：优势来自表示方式，不是CNN架构&lt;/h4&gt;
&lt;p&gt;作者在结论中再次强调，Raw OHLCV CNN同样使用CNN架构，但输入的是原始的价格—成交量数值序列。它的扣费后多空收益为负，明显弱于OHLC Image CNN。这个对照实验排除了“深度学习架构本身有效”的可能解释，说明5天图像模型的优势来自“图像化价格路径表示”这一表示方式，而不是模型复杂度。&lt;/p&gt;
&lt;h4&gt;4. 对未来研究的展望&lt;/h4&gt;
&lt;p&gt;结论最后提到三个未来方向：扩大样本范围（不只研究沪深300成分股）、进一步分析市场状态（regime）的异质性、以及增强模型的可解释性。&lt;/p&gt;
&lt;p&gt;需要注意的是，最后这一点实际上也在提醒读者：本文结论是基于特定样本和特定任务得出的，不能无限制地外推到其他市场、其他频率或其他资产类别。&lt;/p&gt;
&lt;h3&gt;读者理解全文结论必须掌握的内容&lt;/h3&gt;
&lt;h4&gt;1. 统计预测能力不等于经济价值&lt;/h4&gt;
&lt;p&gt;这是全文最重要的思想，也是结论再次强调的。AUC接近0.5（接近随机水平）并不代表模型没有投资价值；反过来，AUC略微提高也不代表能赚钱。真正决定组合收益的是模型对预测概率的“横截面排序”能力，而不是“预测对了多少个”。因此，用分类准确率评价技术指标的增量价值，会造成严重误导。&lt;/p&gt;
&lt;h4&gt;2. 增量价值的比较基准是Set1，不是绝对收益&lt;/h4&gt;
&lt;p&gt;结论中的“增量价值有限”，意思是相对于只使用基础价格—成交量信息（Set1）的模型，加入传统技术指标、市场状态变量、微观结构变量之后，组合收益并没有显著改善。读者不能把这句话理解为“技术指标完全没用”——在没有任何基准的简单模型里，技术指标可能仍然有预测力；但在一套已经控制基本价格、收益、成交量、波动率的基础变量之上，它的额外信息贡献很小。&lt;/p&gt;
&lt;h4&gt;3. 1天与5天的核心区别是换手率压力&lt;/h4&gt;
&lt;p&gt;1天任务在零成本下有不小的多空收益，但扣掉10 bps成本后几乎全部消失；5天任务虽然零成本收益不如1天，但扣费后仍然保持正收益。造成这种差异的根本原因不是预测难度，而是换手率：1天任务的换手率在1.16–1.22之间，持仓几乎每天全部更换一次，成本迅速吞噬利润；5天任务的换手率只有0.517，成本压力显著下降。&lt;/p&gt;
&lt;h4&gt;4. 多空组合是学术评价工具，不是可直接操作的实盘策略&lt;/h4&gt;
&lt;p&gt;结论中所有“多空收益”都是按学术惯例构建的标准化组合——做多预测概率最高的Q5组、做空预测概率最低的Q1组，目的是剥除市场整体涨跌，纯粹衡量模型对股票相对表现的排序能力。这个组合在A股实操中可能面临做空限制、融券成本、冲击成本等问题，不能直接当作可交易的策略。&lt;/p&gt;
&lt;h4&gt;5. 结论的适用范围是CSI 300与日频数据&lt;/h4&gt;
&lt;p&gt;本文所有结论都基于2019年至2025年沪深300成分股的日频样本。样本范围、预测频率、交易成本假设等条件共同决定了结论的边界。读者不应把“价格路径图像有效”泛化为“所有股票市场、所有频率下都有效”，否则就是过度解读。&lt;/p&gt;
&lt;h3&gt;公式、实验设置或定义解释&lt;/h3&gt;
&lt;p&gt;总结章节本身没有出现新的数学公式，但包含多个关键术语和实验设置，用通俗语言解释如下。&lt;/p&gt;
&lt;h4&gt;净年化收益&lt;/h4&gt;
&lt;p&gt;“净”的意思是扣除交易成本之后剩下的收益。年化收益就是把一个较短区间内的收益率折算成一年期的收益率，方便不同长度预测周期之间比较。例如，某模型在5天预测任务中扣除10 bps交易成本后，年化多空收益为9.34%，意味着如果一年内保持这种表现，投资者大约能拿到9.34%的额外收益。&lt;/p&gt;
&lt;h4&gt;净夏普比率&lt;/h4&gt;
&lt;p&gt;夏普比率衡量“每承担一单位风险，能得到多少额外收益”。净夏普比率就是扣除交易成本后的年化收益除以年化波动率。本文中5天OHLC Image CNN的净夏普为0.761，属于中上水平——它意味着模型在不额外增加太多波动的情况下，提供了可观的风险调整后收益。&lt;/p&gt;
&lt;h4&gt;10 bps交易成本&lt;/h4&gt;
&lt;p&gt;10 bps就是0.1%的单边交易费用。假设你买入100元股票，需要额外支付0.1元费用；卖出时同样支付0.1%。这个假设相对保守和现实，但在高频换手的策略中，每天0.1%的成本一年累积下来会非常可观——这正是1天任务利润被吞噬的原因。&lt;/p&gt;
&lt;h4&gt;换手率&lt;/h4&gt;
&lt;p&gt;换手率衡量投资组合在单位时间内更换持仓的比例。如果换手率为1.16，意味着一年内组合持仓相当于完全更换了1.16次；换手率越高，交易越频繁，交易成本越大。5天任务的换手率0.517远低于1天任务的1.16–1.22，这是5天任务扣费后仍能盈利的关键原因。&lt;/p&gt;
&lt;h4&gt;多空组合&lt;/h4&gt;
&lt;p&gt;每天把所有股票按照模型预测的上涨概率从低到高排序，平均分成五组（Q1到Q5）。多空组合就是做多Q5组、做空Q1组。如果Q5未来的平均收益高于Q1，说明模型具备横截面排序能力。这种组合同时剔除了市场整体涨跌的影响，因此能更干净地反映模型的选股能力。&lt;/p&gt;
&lt;h4&gt;5天预测任务&lt;/h4&gt;
&lt;p&gt;5天预测不是预测“下一天涨还是跌”，而是预测“未来5个交易日累计收益是否为正”。它的好处是：持仓相对稳定，不需要每天都调整，因此换手率较低，交易成本对收益的侵蚀也较小。&lt;/p&gt;

&lt;!-- zab:slot:chapter_ch5:end --&gt;
&lt;!-- zab:slot:q_core_contribution:done --&gt;
&lt;h2&gt;核心贡献判断&lt;/h2&gt;
&lt;h3&gt;核心贡献&lt;/h3&gt;
&lt;p&gt;本文最核心的贡献在于：&lt;strong&gt;以组合经济价值（而非传统分类精度）为核心评价标准，在一个统一框架内系统比较了不同层次技术信息对中国A股市场股票收益的增量预测能力，并识别出可实际交易的经济价值来源。&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;具体而言，该框架从最基本的量价信息（Set1）出发，依次叠加传统技术指标（Set2）、市场状态变量（Set3）、微观结构变量（Set4），并与基于OHLC价格路径图像的CNN模型以及原始数据输入的Raw OHLCV CNN进行对比。在此基础上，论文采用滚动扩窗的样本外预测，通过构建五分位多空组合，重点考察长空收益、夏普比率、换手率以及扣除10个基点交易成本后的净表现，而非简单依赖AUC、Accuracy等统计指标。&lt;/p&gt;
&lt;p&gt;在此基础上，论文发现：传统技术指标、市场状态变量以及微观结构变量（如StockJump和VPIN）在全面控制基本量价信息后，几乎不提供额外的增量价值；而&lt;strong&gt;5天期OHLC图像CNN模型在扣除10bps交易成本后，仍能保持9.34%的年化多空净收益和0.761的净夏普比率&lt;/strong&gt;，显著优于结构化特征模型和Raw OHLCV CNN。该结果进一步被半年度稳定性分析验证，表明其收益并非由单一市场阶段驱动。&lt;/p&gt;
&lt;h3&gt;为什么重要&lt;/h3&gt;
&lt;p&gt;这一贡献的重要性体现在以下三个方面：&lt;/p&gt;
&lt;p&gt;第一，&lt;strong&gt;它弥合了统计预测能力与投资可实施性之间的缺口&lt;/strong&gt;。现有技术指标研究多依赖AUC、Accuracy等分类指标，但本文指出，这些指标无法反映换手率和交易成本对真实收益的侵蚀。例如，1天期预测任务中，即使OHLC图像CNN在零成本下能获得20.29%的多空年化收益，叠加10bps交易成本后净收益几乎为零。这种“有信号但无价值”的现象只有在组合层面评估时才会显现。因此，本文提供了一个以投资绩效为导向的评价范式，更贴合资产定价和量化投资的真实需求。&lt;/p&gt;
&lt;p&gt;第二，&lt;strong&gt;它系统厘清了不同层次技术信息的边际贡献，为技术分析的有效性提供了更精确的边界&lt;/strong&gt;。论文通过渐进式特征集设计表明，许多传统技术指标本质上是价格、收益率、成交量和波动率的二次加工，信息含量有限；而基于价格路径图像的非线性表示能够提取结构化特征所遗漏的形态信息。这一结论对技术指标的研究和应用具有重要的理论指导意义，提示研究者不应盲目堆叠指标，而应关注信息的独立性和非线性表达能力。&lt;/p&gt;
&lt;p&gt;第三，&lt;strong&gt;它验证了图像化价格路径表示结合更长预测期限的实用价值&lt;/strong&gt;。论文通过OHLC图像CNN与Raw OHLCV CNN的对比表明，CNN架构本身并非性能的来源，真正的增量来自图像表示所保留的空间形态信息。同时，5天预测期限显著降低了换手率，使得信号能够转化为净收益。这一发现为深度学习在金融预测中的应用提供了具体方向：关注数据表示方式与任务时间尺度的匹配，而非单纯追求模型复杂度。&lt;/p&gt;
&lt;p&gt;综上所述，本文的核心贡献不仅在于给出了一个可转换的、经过成本检验的实用交易信号，更在于确立了“以组合经济价值评价技术信息”的研究方法论，为后续技术分析、机器学习与量化投资研究提供了重要参考。&lt;/p&gt;

&lt;!-- zab:slot:q_core_contribution:end --&gt;
&lt;hr/&gt;
&lt;!-- zab:slot:q_limits_questions:done --&gt;
&lt;h2&gt;局限与疑问&lt;/h2&gt;
&lt;h3&gt;主要局限、风险与未解决的问题&lt;/h3&gt;
&lt;h4&gt;样本范围仅限 CSI 300 成分股，结论外推性存疑&lt;/h4&gt;
&lt;p&gt;本文的实证样本仅覆盖中国 A 股市场中的沪深 300 指数成分股，且时间窗口为 2019 年 4 月至 2025 年 12 月。该样本具有市值偏大、流动性较好、机构参与度高等特征，因此研究结论是否适用于中小市值股票、其他板块（如创业板、科创板）、其他新兴市场或成熟市场，仍然缺乏证据。作者在结论部分也承认，未来需要将样本扩展至 CSI 300 之外，这表明当前结果的外部有效性（external validity）还未得到验证。&lt;/p&gt;
&lt;h4&gt;交易成本设定较为单一，未覆盖真实交易中的多种摩擦&lt;/h4&gt;
&lt;p&gt;本文在成本调整中仅采用固定的 10 bps（基点）交易成本，且假设多空组合可无摩擦做空、可按收盘价成交。然而，中国 A 股市场存在如下现实约束：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;融券做空成本远高于 10 bps，且并非所有股票均可融券；&lt;/li&gt;
&lt;li&gt;涨跌停板制度导致部分信号在极端行情下无法成交；&lt;/li&gt;
&lt;li&gt;冲击成本（impact cost）与订单规模相关，而本文的等权组合并未考虑市值权重；&lt;/li&gt;
&lt;li&gt;印花税、佣金、滑点等在不同投资者类型下差异巨大。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;因此，实际可实现的净收益可能低于本文报告的水平，尤其是对于资金规模较大的机构投资者。&lt;/p&gt;
&lt;h4&gt;1 日预测任务在成本后完全丧失经济价值，但论文未提出改进方案&lt;/h4&gt;
&lt;p&gt;实证结果显示，所有模型（包括表现最好的 OHLC Image CNN）在 1 天预测任务中，经 10 bps 成本调整后，多空年化收益均接近零或为负（OHLC Image CNN 的净收益仅为 0.05%，净 Sharpe 为 0.004）。这说明短期技术信号的高换手率是致命缺陷，但论文并未尝试降低换手率的有效方法，例如持仓期加权、交易信号平滑、组合收缩或成本敏感的目标函数。因此，该问题仍是技术信息在实际量化投资中能否落地的核心障碍。&lt;/p&gt;
&lt;h4&gt;市场状态变量仅作为特征加入，未进行完整的机制或状态切换分析&lt;/h4&gt;
&lt;p&gt;尽管论文在文献综述中引用了市场状态（market states）和体制转换（regime-switching）的重要性，但在实证设计中，市场状态变量只是被作为 Set3 中的一类特征线性地加入 SGD 逻辑回归模型，并未采用 HMM、聚类或任何状态依赖的预测模型。这意味着：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;市场状态与个股收益预测之间的关系可能具有非线性或交互效应，而当前模型无法捕捉；&lt;/li&gt;
&lt;li&gt;不同市场状态下的策略表现差异未被系统检验；&lt;/li&gt;
&lt;li&gt;论文中提到的“跨周期稳健性”仅通过半年度窗口统计体现，并未真正区分牛市、熊市、震荡市或高/低波动状态。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;因此，市场状态对技术信息有效性的调节作用仍是一个未解决的研究问题。&lt;/p&gt;
&lt;h4&gt;OHLC 图像 CNN 的可解释性几乎缺失，难以判断其经济含义&lt;/h4&gt;
&lt;p&gt;虽然 OHLC Image CNN 在 5 天预测任务中取得了最优的经成本调整后收益，但论文并未分析模型到底从价格路径图像中提取了何种特征。传统技术指标（如 MACD、RSI）具有明确的经济含义，而 CNN 从 20 日 OHLC 图像中习得的模式对投资者而言是黑箱。此外，论文未讨论图像特征是否与已知的市场异象（如动量、反转、波动率聚集）重合或独立。因此，该模型的高收益可能来自对某种市场摩擦或数据瑕疵的过拟合，缺乏可解释性的支撑使其实际应用的风险较高。&lt;/p&gt;
&lt;h4&gt;特征集之间的比较存在潜在的信息重叠与数据最小化问题&lt;/h4&gt;
&lt;p&gt;论文发现 Set2（传统技术指标）和 Set3（市场状态）相对 Set1 的增量收益极为有限，并将原因归结为“传统指标本质上是对价格、成交量、波动率的再次加工”。然而，Set1 本身已经包含 13 个基础变量，且覆盖了收益率、波动率、成交量和换手率等维度。由于传统技术指标（如 RSI、MACD、ATR）在这些基础变量上仅做确定性函数的变换，SGD 逻辑回归又无法自动构造交互项，因此所谓的“增量”本来就是理论上受限的。这并不意味着技术指标在非线性模型或不同特征构造方式下没有价值。论文未能探讨在神经网络框架下这些结构化特征可能如何与图像特征互补。&lt;/p&gt;
&lt;h4&gt;样本期内的极端波动或结构性变化可能影响稳健性&lt;/h4&gt;
&lt;p&gt;样本时间跨度包含了 2020 年疫情冲击、2022 年市场调整、2024—2025 年可能的政策与市场结构变化。虽然论文报告了半年度窗口的稳健性统计，但部分模型的窗口极值差异巨大（如 Raw OHLCV CNN 1 天任务的最小净年化收益为 -49.94%）。这表明某些模型在特定市场阶段可能发生严重亏损。论文并未采用多因子模型或风险调整后的因子收益（如 Fama-French 五因子），也未报告最大回撤、Calmar 比率等风险指标，因此对下行风险的评估仍不充分。&lt;/p&gt;
&lt;h4&gt;评估指标仍以多空组合为主，未考虑实际 A 股卖空限制&lt;/h4&gt;
&lt;p&gt;论文明确提到“Long-Short 组合是一种标准学术组合构建方式，而非可直接实施的 A 股交易策略”，这一点十分关键。但由于中国 A 股市场对个股卖空有严格限制，融券规模有限且成本较高，因此多空组合的“可实现性”较低。论文未给出仅做多（Long-only）Q5 组合在经成本调整后的表现，也未讨论仅用“剔除 Q1 或低配 Q1”等替代策略的经济价值。这使得主要结论的市场实践意义有限。&lt;/p&gt;
&lt;h4&gt;模型超参数选择仅基于前半年验证集，可能存在滚动窗口内的过拟合&lt;/h4&gt;
&lt;p&gt;论文使用动态扩窗、以测试窗口前半年作为验证集来选择超参数。但在每个半年度滚动窗口中，验证集仅包含一个半年的数据，其市场状态可能无法代表下一个测试窗口。此外，对于 CNN 模型，作者仅提到“最多 5 个训练周期”，未报告学习率、正则化、网络结构、数据增强等关键超参数的选择过程和敏感性分析。若这些超参数在多个滚动窗口中被反复调整，仍存在轻度数据窥探（data snooping）风险。&lt;/p&gt;
&lt;h4&gt;AUC 与组合收益之间的脱节缺乏更深入的诊断&lt;/h4&gt;
&lt;p&gt;论文发现所有模型的 AUC 都接近 0.50，但 OHLC Image CNN 的组合收益远高于其他模型。论文将其解释为“排序能力与分类准确率并不等价”，这确实是一个重要洞见。然而，论文未进一步分析以下问题：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;AUC 是否为评估排序能力的合适指标？为什么不用 Rank IC 或 Spearman 相关系数？&lt;/li&gt;
&lt;li&gt;图像模型是否在特定子样本（如低波动、高流动性股票）中具有更高的排序能力？&lt;/li&gt;
&lt;li&gt;不同模型在生成概率分布上的差异（如离散程度、尾部行为）是否直接导致组合收益差异？&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;缺乏这些诊断，使“图像表达优于结构化特征”这一结论的解释力受限。&lt;/p&gt;
&lt;h4&gt;未考虑因子收益率与系统性风险的区分&lt;/h4&gt;
&lt;p&gt;OHLC 图像 CNN 的 9.34% 净年化多空收益可能包含一定的市场风格暴露（如小市值、高波动、流动性溢价等），而不是纯粹的技术信号 alpha。论文未采用常见资产定价模型（如 Fama-French、Carhart 四因子、五因子）对组合收益进行风险调整，也未报告这些收益在所有市场状态下是否稳健。因此，无法确定该策略是否承担了未补偿的风险，其收益的真 alpha 部分仍是不明确的。&lt;/p&gt;

&lt;!-- zab:slot:q_limits_questions:end --&gt;</rdf:value>
        <dc:subject>AI-DeepRead</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_17">
        <rdf:value>&lt;!-- AI_BUTLER_LLM_BLOCK_BEGIN::v1::llm-summary-mt5kv3sq-kiqnz8huh4::fwn1elr3tq --&gt;
&lt;!-- AI_BUTLER_LLM_META_B64URL::v1:: --&gt;
&lt;h2&gt;AI 总结 - Do Technical Indicators Generate Tradable Value? Evidence from Market States, Price-Path Images, and...&lt;/h2&gt;

&lt;p data-ai-butler-llm-source=&quot;v1&quot; data-ai-butler-llm-block-id=&quot;llm-summary-mt5kv3sq-kiqnz8huh4&quot; data-ai-butler-llm-meta=&quot;&quot; style=&quot;margin: 0 0 12px 0; padding: 6px 8px; border-left: 3px solid #59c0bc; background: #f4fbfb; color: #3d5f5d; font-size: 12px; line-height: 1.45;&quot;&gt;&lt;strong&gt;AI 来源：&lt;/strong&gt;供应商：DeepSeek · 模型：deepseek-v4-pro · 生成时间：&lt;span title=&quot;2026-08-23T09:01:12.314Z&quot;&gt;2026/8/23 17:01:12&lt;/span&gt;&lt;/p&gt;
&lt;div&gt;&lt;p&gt;这篇论文的核心内容是：在考虑交易成本约束的前提下，系统检验不同层级的“技术信息”能否产生具有经济意义的股票组合收益。作者以沪深300成分股2019—2025年的日度数据为样本，从基本量价变量出发，逐层加入传统技术指标、市场状态变量、微观结构变量（StockJump和VPIN），并进一步引入基于OHLC价格路径图像的卷积神经网络（CNN）模型，考察这些信息在1日与5日方向预测中的横截面排序能力、多空组合收益、夏普比率、换手率以及扣除10个基点交易成本后的净表现。结果发现，传统技术指标、市场状态变量和微观结构变量在基本量价信息之上的增量价值非常有限；1日预测虽然有一定的排序能力，但高换手导致收益被交易成本完全侵蚀；而基于5日预测的OHLC图像CNN在扣除成本后仍能保持9.34%的多空净年化收益率和0.761的净夏普比率，显著优于结构化特征模型和直接使用原始量价序列的CNN，说明图像化的价格路径表示能够捕捉传统结构化特征难以表达的非线性形态信息，尤其是在较长预测期限下更具经济可行性。&lt;/p&gt;
&lt;hr&gt;
&lt;h2&gt;一、研究背景与核心问题&lt;/h2&gt;
&lt;p&gt;技术分析在股票筛选、择时和量化交易中一直应用广泛。近年来不少研究表明技术指标仍可能含有预测信息：例如Shi et al.重新检验技术指标对股票收益的预测能力，Mostafavi et al.将技术指标按趋势、动量、波动率和成交量分类，Wang et al.将技术指标与筹码因子、新闻结合。然而，对量化投资而言，关键问题不只是技术指标能否提高统计上的预测准确率，而是能否在实际交易成本约束下形成稳定的组合收益。&lt;/p&gt;
&lt;p&gt;本文指出现有研究存在三个空白：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;许多研究主要依赖Accuracy、AUC等分类指标来评价模型，而较少关注横截面排序能力和扣除交易成本后的组合经济价值。Neuhierl et al.曾强调，概率预测应在资产定价和组合排序框架下评估，而不是只看分类精度。&lt;/li&gt;
&lt;li&gt;传统技术指标本质上是价格和成交量的二次加工，可能丢失价格路径中蕴含的非线性信息。&lt;/li&gt;
&lt;li&gt;收益可预测性可能随市场环境变化，Cakici et al.和Horvath et al.均表明市场条件和状态结构会影响预测关系。&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;本文的目标就是在一个统一框架下，系统比较不同层次的技术信息，并在交易成本约束下评价其组合层面的经济价值。&lt;/p&gt;
&lt;hr&gt;
&lt;h2&gt;二、文献综述与本文定位&lt;/h2&gt;
&lt;p&gt;论文从五个方面回顾了相关文献，并明确了自身的位置。&lt;/p&gt;
&lt;h3&gt;2.1 股票收益预测与概率预测&lt;/h3&gt;
&lt;p&gt;收益预测是资产定价和量化投资的核心问题，其基本思想是从高维数据中提取能够解释或预测横截面收益差异的有效信号。Kelly et al.指出，数据中的非线性关系和交互项可能包含线性模型无法捕捉的信息，这为使用复杂模型提供了理论动机。Cakici et al.和Hanauer et al.分别研究了国际市场和新兴市场中机器学习在横截面收益预测中的应用，发现收益可预测性高度依赖市场环境和样本敏感性。&lt;/p&gt;
&lt;p&gt;方法论上，Neuhierl et al.提出概率预测视角，强调模型的预测概率可以直接用于组合排序和资产定价，而不是仅仅作为分类准确率评估的对象。Chen et al.进一步说明模型设计和样本外表现才是机器学习收益预测的关键，而不是固定测试集上的预测精度。本文受到这些研究的启发，使用模型输出的上涨概率进行横截面排序，构建多空组合来评估预测能力，并进一步考察扣除交易成本后的经济价值。&lt;/p&gt;
&lt;h3&gt;2.2 技术指标与技术分析&lt;/h3&gt;
&lt;p&gt;技术指标常用于股票筛选、择时和量化投资。已有研究显示技术指标中仍存在信息：Shi et al.探索了技术指标对收益的预测能力；Mostafavi et al.将技术指标分为趋势、动量、波动率和成交量四类；Wang et al.将技术指标与筹码因子和新闻结合；Albahli et al.使用DenseNet模型整合技术指标进行股票预测，证明深度学习可以从技术指标中挖掘非线性信息。但本文强调，对量化投资而言，更重要的是技术指标能否在组合层面产生稳定收益，而不是分类准确率本身。&lt;/p&gt;
&lt;h3&gt;2.3 机器学习与深度学习在金融预测中的应用&lt;/h3&gt;
&lt;p&gt;机器学习和深度学习能够建模高维非线性关系和复杂特征交互，在金融预测中得到广泛应用。Saberironaghi et al.和Giantsidi et al.综述了其在股价预测中的应用，强调数据集特征和评估程序的重要性。Wang et al.指出，模型复杂性本身不是关键，与任务的一致性才是关键。因此本文使用CNN的目的不是为了追求模型复杂度，而是为了从OHLC价格路径中学习局部形态模式。同时引入Raw OHLCV CNN作为对照，以分离图像表示与CNN架构各自的作用。&lt;/p&gt;
&lt;h3&gt;2.4 市场状态与状态依赖性&lt;/h3&gt;
&lt;p&gt;越来越多的研究表明，股票市场并非始终处于均匀稳定的状态，收益形成机制、风险水平和投资者行为可能随市场状态而变化。Kijkarncharoensin et al.和Gupta et al.使用隐马尔可夫模型等方法识别市场状态，Horvath et al.使用Wasserstein距离聚类证明市场结构具有非平稳性。这些研究促使本文在收益预测中引入市场状态变量。不过本文的市场状态仅作为Set3中的一个额外特征组，而不是进行完整的区制转换分析。&lt;/p&gt;
&lt;h3&gt;2.5 本文的相对定位&lt;/h3&gt;
&lt;p&gt;现有文献从多个角度讨论了收益预测问题，但仍有改进空间：第一，传统技术指标、市场状态变量、微观结构变量和价格路径图像表示很少在统一框架内进行系统比较，不同层级技术信息的边际增量价值缺乏一致结论；第二，现有研究多以预测精度或无成本的预测能力为评价标准，较少关注交易成本、组合换手率以及多空组合的实际经济价值，导致统计可预测性与可实施性之间存在脱节；第三，技术信息在不同预测期限和市场状态下的稳定性仍需检验。本文正是针对这些空白，构建从Set1到Set4再到OHLC图像CNN和Raw OHLCV CNN的统一比较框架，从预测能力、组合经济价值和跨期稳定性三个方面进行系统分析。&lt;/p&gt;
&lt;hr&gt;
&lt;h2&gt;三、方法论&lt;/h2&gt;
&lt;h3&gt;3.1 研究问题与实证设计&lt;/h3&gt;
&lt;p&gt;本文研究沪深300成分股在1日向前（1-day-ahead）和5日向前（5-day-ahead）的方向性波动预测。核心假设是：传统技术指标、市场状态变量和微观结构非线性高阶信息是否在基本量价信息之外具有增量预测能力，以及这些信息能否用于构建具有经济意义的投资组合。因此本文的关注点是样本外组合表现和交易成本调整后的经济价值，而非单纯的统计准确率。&lt;/p&gt;
&lt;p&gt;根据信息维度和构造逻辑，本文将技术信息分为四个递进层级：基本量价信息、传统技术指标信息、市场状态宏观信息，以及包含StockJump、VPIN和价格路径图像在内的非线性高阶技术信息。为精确隔离各类技术信息的边际贡献，本文统一采用扩展窗口滚动的样本外预测框架。在评价上，不再依赖AUC、统计准确率等拟合指标，而是基于样本外上涨概率对股票进行横截面排序，构建标准化多头组合和多空对冲组合，并结合零成本和含交易成本两种情景下的风险收益表现，综合评价技术信息的真实增量价值和经济可行性。&lt;/p&gt;
&lt;h3&gt;3.2 数据来源与样本构建&lt;/h3&gt;
&lt;p&gt;数据为沪深300成分股2019—2025年的日度个股数据，核心字段包括开盘价、最高价、最低价、收盘价、成交量、日收益率、换手率等基本量价指标，最终构建股票-日非平衡面板样本。&lt;/p&gt;
&lt;p&gt;方向预测标签基于个股在未来区间的复合收益定义。设股票&lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt;在交易日&lt;span class=&quot;math&quot;&gt;$t$&lt;/span&gt;的日收益为&lt;span class=&quot;math&quot;&gt;$r_{i,t}$&lt;/span&gt;，未来&lt;span class=&quot;math&quot;&gt;$k$&lt;/span&gt;个交易日的复合收益定义为：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$$R_{i,t}^{(h)} = \prod_{k=1}^{h}(1 + r_{i,t+k}) - 1, \quad h \in \{1,5\}$$&lt;/pre&gt;
&lt;p&gt;在此基础上构建二分类方向标签：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$$y_{i,t}^{(h)} = \mathbf{1}(R_{i,t}^{(h)} &amp;gt; 0), \quad h \in \{1,5\}$$&lt;/pre&gt;
&lt;p&gt;即如果股票在未来&lt;span class=&quot;math&quot;&gt;$k$&lt;/span&gt;个交易日实现正复合收益，标签为1；否则为0。&lt;/p&gt;
&lt;p&gt;除基本量价变量外，本文还引入两类高阶微观交易变量：StockJump和VPIN。StockJump是股价跳跃特征指标，VPIN（Volume-Synchronized Probability of Informed Trading，成交量同步知情交易概率）反映短期资金竞争强度和交易情绪。两类指标按行业标准方法计算，作为传统量价指标之外的微观结构信息补充。&lt;/p&gt;
&lt;p&gt;数据整合采用股票代码和交易日期为唯一匹配键，将基本日度量价数据、衍生技术指标、市场状态变量、StockJump和VPIN高阶微观交易数据精确对齐，删除缺失字段、异常代码或日期错位的观测，并剔除历史窗口不足、特征缺失、异常交易间隔或未来收益窗口跨越验证/测试边界的样本，以避免前视偏差和样本重叠。&lt;/p&gt;
&lt;h3&gt;3.3 特征集系统设计&lt;/h3&gt;
&lt;p&gt;为逐步隔离不同技术信息的边际贡献，本文设计了四个递进特征集，如表1所示。&lt;/p&gt;
&lt;table style=&quot;max-width:100%; width:auto; table-layout:auto; overflow-wrap:anywhere; word-break:break-word;&quot;&gt;
&lt;thead&gt;
&lt;tr&gt;
&lt;th&gt;特征集&lt;/th&gt;
&lt;th&gt;内容&lt;/th&gt;
&lt;th&gt;功能&lt;/th&gt;
&lt;th&gt;特征数量&lt;/th&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;&lt;tr&gt;
&lt;td&gt;Set1&lt;/td&gt;
&lt;td&gt;基本量价变量&lt;/td&gt;
&lt;td&gt;控制收益、波动率、成交量、换手率、流动性等基本信息&lt;/td&gt;
&lt;td&gt;13&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Set2&lt;/td&gt;
&lt;td&gt;Set1 + 传统技术指标&lt;/td&gt;
&lt;td&gt;检验传统技术指标是否在基本量价信息之上提供增量&lt;/td&gt;
&lt;td&gt;30&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Set3&lt;/td&gt;
&lt;td&gt;Set2 + 市场状态变量&lt;/td&gt;
&lt;td&gt;检验整体市场收益、波动率和交易状态是否提供额外信息&lt;/td&gt;
&lt;td&gt;38&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Set4&lt;/td&gt;
&lt;td&gt;Set3 + StockJump + VPIN&lt;/td&gt;
&lt;td&gt;检验跳跃和订单流不平衡是否提供额外信息&lt;/td&gt;
&lt;td&gt;77&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;p&gt;需要注意，Set1并非未经处理的原始数据，而是经过筛选、清洗和标准化的基线控制变量组，涵盖个股收益、波动率、交易流动性、市值等核心交易维度，为增量检验提供严格统一的基准。&lt;/p&gt;
&lt;p&gt;从指标构造逻辑上看，Set2相对于Set1的弱增量具有理论合理性：传统技术指标本质上是基本价格、收益、成交量和波动率信息的二次加工，没有独立的信息来源。例如RSI基于历史涨跌差异计算，MACD基于不同周期均线差构建，布林带宽度直接映射历史波动率，ATR刻画日内价格振幅。由于Set1已经覆盖了收益、波动率、成交量和日内交易等底层信息，传统技术指标的信息内容在很大程度上已被Set1变量解释和包含，因此难以产生额外的边际收益。&lt;/p&gt;
&lt;h3&gt;3.4 模型设定与滚动训练机制&lt;/h3&gt;
&lt;p&gt;论文使用SGD Logistic模型作为统一预测模型，标准化输入格式、预测输出和训练过程，以保证不同特征集和不同时间范围下实证结果的可比性。具体设置为：输入特征为个股过去20个交易日的数据，输出为1日向前和5日向前的短期方向分类。测试期从2022年上半年开始到2025年下半年，按半年度滚动。&lt;/p&gt;
&lt;p&gt;为防止过拟合和数据窥探，采用动态扩展窗口划分数据集。在每个半年度测试窗口中，紧邻测试窗口的前半年作为验证窗口，用于选择模型超参数和最优模型结构；所有更早的样本作为扩展训练集。数据预处理阶段使用日内横截面分位数排名进行特征标准化，避免变量量纲和极端值问题；用于标准化的缩放器仅在训练集样本上拟合，从而避免测试集信息泄露。同时样本选择规则严格：如果计算预测目标收益的周期与验证/测试期重叠，则直接丢弃该样本，避免前视偏差。&lt;/p&gt;
&lt;h3&gt;3.5 图像价格路径扩展模型&lt;/h3&gt;
&lt;p&gt;为了克服结构化特征的信息局限性，本文进一步将过去20个交易日的OHLC价格信息转化为图像或张量形式，并使用CNN学习价格路径信息。在这种方法中，个股的时间序列交易信息被转换为标准化图像，以数据驱动的方式自动发现价格路径特征，无需预先定义技术图形规则。这种表示可以捕捉价格波动结构、日内振幅特征以及量价匹配关系，这些是传统技术指标难以覆盖的。&lt;/p&gt;
&lt;p&gt;图像模型使用每只股票过去20个交易日的OHLC信息作为主要输入，表示短期价格路径。Raw OHLCV CNN作为对照模型，直接使用原始量价序列作为输入，以区分CNN架构本身的贡献与基于图像的价格路径表示的贡献。两个模型都预测1日和5日方向，其样本外上涨概率进入统一的组合回测框架。训练过程遵循与全篇一致的半年度滚动扩展窗口样本外框架，时间序列划分、样本选择、防数据泄露限制和基础模型完全一致。训练依赖硬件条件，优先使用GPU加速，否则回退到CPU训练，每个滚动周期最多训练5个epoch。&lt;/p&gt;
&lt;h3&gt;3.6 评估指标体系&lt;/h3&gt;
&lt;p&gt;针对统计预测与实际经济价值之间的脱节，本文采用双重评估方法：以组合表现为主，分类指标为辅。对每个模型输出的样本外上涨概率，对样本中的股票进行排序，等分为五个分位数组，最高概率组记为Q5，最低概率组记为Q1。&lt;/p&gt;
&lt;p&gt;基于排序构建两个等权组合：一是仅持有Q5的多头组合，衡量信号的正向选股能力；二是做多Q5、做空Q1的多空组合，用于提取模型横截面排序带来的超额收益，同时降低市场整体波动的影响。实证报告AUC、Accuracy和F1作为辅助预测诊断，但这些指标无法反映交易成本、换手率或实际组合价值。因此主要评估指标为多头和多空组合的年化收益率、夏普比率、扣除交易成本后的净收益以及组合换手率。多空组合被解释为标准学术组合构造，而非可直接实施的A股交易策略。&lt;/p&gt;
&lt;hr&gt;
&lt;h2&gt;四、实证结果与分析&lt;/h2&gt;
&lt;h3&gt;4.1 零交易成本下的预测能力与横截面排序能力&lt;/h3&gt;
&lt;p&gt;首先在不引入交易摩擦的情况下检验各层级技术信息的预测和排序能力。此时组合收益直接反映模型识别未来收益横截面差异的能力。&lt;/p&gt;
&lt;p&gt;从1日向前预测结果看，Set1至Set4四个结构化特征模型均表现出一定程度的横截面排序能力，但收益并未随着信息层级的扩展而稳定提高。作为基线，Set1仅使用基本量价信息就获得10.26%的多空年化收益率和0.550的夏普比率，说明基本交易信息本身已包含短期可预测成分。加入传统技术指标后，Set2的组合收益上升至11.48%，夏普比率为0.689；进一步加入市场状态变量形成Set3，多空年化收益为11.75%，夏普比率为0.687，改善依然有限。值得注意的是，当进一步加入StockJump和VPIN形成Set4时，组合收益反而下降至2.79%，夏普比率仅为0.187。这表明传统技术指标、市场状态变量和高阶微观交易特征虽然扩大了特征维度，但并未显著提升模型识别未来收益横截面差异的能力。大量传统技术指标本质上是价格、收益、成交量和波动率的函数变换，其增量信息含量有限；市场状态变量引入了市场级环境信息，但对个股相对排序的贡献同样较弱；StockJump和VPIN可能包含较强噪声，在当前框架下未能转化为稳定的排序优势。&lt;/p&gt;
&lt;p&gt;然而，当从结构化特征表示转向数据驱动的特征学习时，结果出现明显差异。OHLC图像CNN在1日向前任务中实现了20.29%的多空年化收益率和1.486的夏普比率，超过所有结构化特征模型。与Set1至Set4不同，图像模型不依赖预先构建的技术指标体系，而是直接从价格路径中提取模式特征。这一发现说明价格轨迹中包含了传统结构化变量难以捕捉的非线性信息，而OHLC图像CNN能够有效建模这些信息。&lt;/p&gt;
&lt;p&gt;图2展示了不同回测设置下的累计多空收益，可视化结果与此处数值一致。&lt;/p&gt;
&lt;h3&gt;4.2 交易成本约束下的经济价值检验&lt;/h3&gt;
&lt;p&gt;预测能力并不等同于投资能力。所有预测信号必须经过实际交易才能转化为利润，而交易离不开换手率和交易成本。本文在确认技术信息具有一定排序能力后，引入10个基点的交易成本假设，检验其经济可行性。&lt;/p&gt;
&lt;p&gt;在1日向前任务中，各模型表现出预测能力与经济价值之间的显著差距。加入10bps交易成本后，所有结构化特征模型的多空组合收益均转为负值。具体而言，Set1的多空年化收益从10.26%降至-19.01%，Set2降至-17.85%，Set3降至-17.61%，Set4降至-27.96%。同时，各模型的多空换手率介于1.16至1.22之间，说明调仓非常频繁。交易成本几乎完全抵消了毛收益。即使是表现最好的OHLC图像CNN也难以避免这一问题：其多空年化收益从20.29%骤降至0.05%，净夏普比率仅为0.004。这表明尽管图像模型能够发现更强的短期预测信号，但由于预测期限过短，相应组合面临极高的换手率，绝大多数超额收益最终被交易成本吞噬。&lt;/p&gt;
&lt;p&gt;这一结果并不意味着图像模型无效，而是揭示了一个重要事实：信号的存在并不等于其具有经济价值。1日预测的结果说明，价格路径图像可以改善横截面排序能力，但这种能力不足以克服高频交易带来的成本壁垒。&lt;/p&gt;
&lt;p&gt;基于上述问题，本文进一步考察5日向前预测任务。更长的预测期限意味着更低的组合换手率。结果显示，虽然结构化模型在零成本下仍保持一定收益，但扣除成本后大部分收益完全消失。10bps条件下，Set1至Set4的多空年化收益分别为-2.63%、-2.72%、-0.99%和-0.32%，均未形成稳定的超额收益。&lt;/p&gt;
&lt;p&gt;相比之下，OHLC图像CNN在5日向前任务中表现出明显优势。零成本下，其多空年化收益为11.94%，夏普比率为0.974；加入10bps交易成本后，仍保留9.34%的净年化收益和0.761的净夏普比率。其多空换手率仅为0.517，显著低于1日任务。这说明图像模型提取的价格路径信息在扣除交易成本后仍能保持为正，并在较长的预测期限下具有更好的经济可行性。值得注意的是，虽然Raw OHLCV CNN也使用了CNN架构，但其成本后多空收益为-1.71%，远弱于OHLC图像CNN。这意味着CNN架构本身并非业绩的唯一来源，更重要的因素是基于图像的价格路径表示，它保留了原始数值序列难以捕捉的空间和形态信息。&lt;/p&gt;
&lt;h3&gt;4.3 分类指标与组合收益的关系&lt;/h3&gt;
&lt;p&gt;为了进一步说明模型预测能力与投资收益之间的关系，论文同时报告了AUC、Accuracy和F1等传统分类指标，如表2所示。&lt;/p&gt;
&lt;p&gt;总体来看，所有模型的AUC值都在0.50附近，最好的AUC值也仅为1日向前任务中Raw OHLCV CNN的0.516和5日向前任务中OHLC图像CNN的0.514。按照传统机器学习标准，这样的分类表现相当平庸。但与此同时，OHLC图像CNN在组合收益上却明显优于其他模型。这一结果表明，在股票横截面预测任务中，分类表现与投资价值之间并不存在直接对应关系。原因在于组合构建并不依赖于分类结果，而是依赖于预测概率的横截面排序。如果模型能够正确排序未来表现较好和较差的股票，即使分类准确率没有显著提升，也仍然能够产生多空收益。&lt;/p&gt;
&lt;p&gt;从表2中可以看出，结构化模型与图像模型在AUC上并无显著差距，但在组合收益层面的差距却很大。这再次说明传统分类性能指标不足以评价预测信号的投资价值。在资产定价和量化投资领域，更重要的指标是组合收益、夏普比率以及扣除交易成本后的净收益。&lt;/p&gt;
&lt;h3&gt;4.4 半年度稳定性分析&lt;/h3&gt;
&lt;p&gt;确认OHLC图像CNN具有经济价值后，论文进一步检验其在不同市场阶段的稳定性。为避免整体样本结果受特定时期异常表现的影响，论文按半年度滚动窗口计算各模型在各测试区间的收益表现，并通过窗口级收益分布衡量模型稳健性。&lt;/p&gt;
&lt;p&gt;结果表明，5日向前的OHLC图像CNN并非完全由单一测试窗口驱动，表现出一定的跨期稳健性。在8个半年度窗口中，有6个窗口产生正收益，平均净年化收益为9.43%，平均净夏普比率为0.777。相比之下，Raw OHLCV CNN仅在4个窗口产生正收益，平均净年化收益为-1.63%。结构化模型在成本后的平均表现也较弱。例如Set2在1日任务中仅有1/8的窗口产生正收益，平均净年化收益为-18.11%；Set4在1日任务中没有任何窗口产生正收益，平均净年化收益为-28.20%。这些结果进一步支持了5日OHLC图像CNN的稳健性。&lt;/p&gt;
&lt;h3&gt;4.5 小结&lt;/h3&gt;
&lt;p&gt;综合以上分析，可以形成一条完整的证据链：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;在零交易成本下，传统技术指标、市场状态变量和微观结构变量相对于基本量价信息的增量预测能力有限，而OHLC图像CNN显著提升了横截面排序能力。&lt;/li&gt;
&lt;li&gt;引入交易成本后，1日预测信号因高换手率而被大量侵蚀，说明预测能力并不必然转化为投资价值。&lt;/li&gt;
&lt;li&gt;当预测期限延长至5日时，OHLC图像CNN在扣除成本后仍保持正收益，并表现出一定的跨期稳健性。&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;因此，传统技术指标、市场状态变量和高阶微观交易变量的整体增量价值有限，而基于价格路径图像的非线性特征提取方法能够更有效地识别未来收益的横截面差异，并最终形成具有实际投资意义的超额收益。5日OHLC图像CNN的稳定表现构成了技术信息具有增量价值的核心经验证据。&lt;/p&gt;
&lt;hr&gt;
&lt;h2&gt;五、结论与未来方向&lt;/h2&gt;
&lt;p&gt;本文从统计预测能力能否转化为组合收益的视角，检验了不同层级技术信息在股票方向预测中的增量价值。结果显示，基本量价变量已经包含相当多的短期可预测信息。在此基础上加入传统技术指标、市场状态变量以及StockJump和VPIN等微观结构变量，并未带来一致的组合收益提升。这表明许多结构化技术指标不过是现有价格、收益、成交量和波动率信息的再加工，在全面的基线控制下，其边际价值在当前日频横截面框架内较为有限。&lt;/p&gt;
&lt;p&gt;本文的主要结果来自5日向前的OHLC图像CNN模型。即使在10bps交易成本的假设下，该模型仍保持9.34%的净年化收益和0.761的净夏普比率，显著优于结构化特征模型和原始OHLCV CNN。这一结果说明，基于图像的价格路径表示能够保留传统人工信号难以提取的形态信息，而较长的预测期限有助于降低换手压力。&lt;/p&gt;
&lt;p&gt;未来研究可以扩展样本范围至沪深300之外，进一步研究市场状态的异质性和模型的可解释性，以更全面地理解技术信息的投资价值。&lt;/p&gt;
&lt;/div&gt;
&lt;!-- AI_BUTLER_LLM_BLOCK_END::v1::llm-summary-mt5kv3sq-kiqnz8huh4::40d79b89 --&gt;</rdf:value>
