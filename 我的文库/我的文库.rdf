        <rdf:value>&lt;!-- zab:deep-read-plan:%7B%22templateId%22%3A%22default-v2-chapter-reading%22%2C%22template%22%3A%7B%22id%22%3A%22default-v2-chapter-reading%22%2C%22name%22%3A%22%E9%BB%98%E8%AE%A4%EF%BC%9A%E5%8F%8C%E9%98%B6%E6%AE%B5%E9%80%90%E7%AB%A0%E7%B2%BE%E8%AF%BB%22%2C%22description%22%3A%22%E5%85%88%E8%A7%A3%E6%9E%90%E7%AB%A0%E8%8A%82%20JSON%EF%BC%8C%E5%86%8D%E6%8C%89%E7%AB%A0%E8%8A%82%E9%A1%BA%E5%BA%8F%E9%80%90%E7%AB%A0%E7%B2%BE%E8%AF%BB%EF%BC%9B%E7%AC%AC%E4%BA%8C%E9%98%B6%E6%AE%B5%E7%94%A8%E9%87%8D%E7%82%B9%E8%BF%BD%E9%97%AE%E8%A1%A5%E5%85%85%E8%AE%BA%E6%96%87%E7%90%86%E8%A7%A3%E3%80%82%22%2C%22version%22%3A2%2C%22phases%22%3A%5B%7B%22id%22%3A%22chapter_reading%22%2C%22title%22%3A%22%E9%98%B6%E6%AE%B5%E4%B8%80%EF%BC%9A%E9%80%90%E7%AB%A0%E7%B2%BE%E8%AF%BB%22%2C%22type%22%3A%22sequential_dynamic%22%2C%22description%22%3A%22%E5%85%88%E8%AE%A9%20AI%20%E8%AF%86%E5%88%AB%E8%AE%BA%E6%96%87%E7%AB%A0%E8%8A%82%E7%BB%93%E6%9E%84%EF%BC%8C%E5%86%8D%E6%8A%8A%E7%AB%A0%E8%8A%82%E6%A0%87%E9%A2%98%E6%B8%B2%E6%9F%93%E8%BF%9B%E7%AB%A0%E8%8A%82%E7%B2%BE%E8%AF%BB%E6%8F%90%E7%A4%BA%E8%AF%8D%EF%BC%8C%E6%8C%89%E9%A1%BA%E5%BA%8F%E5%86%99%E5%85%A5%E7%B2%BE%E8%AF%BB%E7%AC%94%E8%AE%B0%E3%80%82%22%2C%22contextStrategy%22%3A%22last_round%22%2C%22fixedPrompts%22%3A%5B%5D%2C%22planningPrompt%22%3A%22%E8%AF%B7%E9%98%85%E8%AF%BB%E5%85%A8%E6%96%87%E5%85%A8%E6%96%87%EF%BC%8C%E8%AF%86%E5%88%AB%E8%AE%BA%E6%96%87%E7%9A%84%E4%B8%BB%E8%A6%81%E7%AB%A0%E8%8A%82%E7%BB%93%E6%9E%84%EF%BC%8C%E5%B9%B6%E5%8F%AA%E8%BF%94%E5%9B%9E%20JSON%EF%BC%8C%E4%B8%8D%E8%A6%81%E8%BE%93%E5%87%BA%E8%A7%A3%E9%87%8A%E6%96%87%E5%AD%97%E3%80%82%5Cn%5Cn%E8%BF%94%E5%9B%9E%E6%A0%BC%E5%BC%8F%E5%BF%85%E9%A1%BB%E6%98%AF%EF%BC%9A%5Cn%7B%5Cn%20%20%5C%22chapters%5C%22%3A%20%5B%5Cn%20%20%20%20%7B%20%5C%22id%5C%22%3A%20%5C%22ch1%5C%22%2C%20%5C%22title_zh%5C%22%3A%20%5C%22%E5%BC%95%E8%A8%80%5C%22%2C%20%5C%22title_en%5C%22%3A%20%5C%22Introduction%5C%22%20%7D%2C%5Cn%20%20%20%20%7B%20%5C%22id%5C%22%3A%20%5C%22ch2%5C%22%2C%20%5C%22title_zh%5C%22%3A%20%5C%22%E7%AC%AC%E4%BA%8C%E7%AB%A0%5C%22%2C%20%5C%22title_en%5C%22%3A%20%5C%22Related%20Work%20%E6%88%96%20Method%5C%22%20%7D%5Cn%20%20%5D%5Cn%7D%5Cn%5Cn%E8%A6%81%E6%B1%82%EF%BC%9A%5Cn1.%20%E4%BC%98%E5%85%88%E4%BD%BF%E7%94%A8%E8%AE%BA%E6%96%87%E5%8E%9F%E6%96%87%E4%B8%AD%E7%9A%84%E7%AB%A0%E8%8A%82%E6%A0%87%E9%A2%98%E3%80%82%5Cn2.%20%E5%A6%82%E6%9E%9C%E8%AE%BA%E6%96%87%E6%A0%87%E9%A2%98%E4%B8%8D%E6%98%AF%E4%B8%AD%E6%96%87%EF%BC%8C%E8%AF%B7%E7%BB%99%E5%87%BA%E7%AE%80%E7%9F%AD%E4%B8%AD%E6%96%87%E8%AF%91%E5%90%8D%E5%92%8C%E8%8B%B1%E6%96%87%E5%8E%9F%E5%90%8D%E3%80%82%5Cn3.%20%E8%87%B3%E5%B0%91%E8%BF%94%E5%9B%9E%E4%B8%A4%E4%B8%AA%E7%AB%A0%E8%8A%82%EF%BC%9B%E5%A6%82%E6%9E%9C%E7%BB%93%E6%9E%84%E4%B8%8D%E6%B8%85%E6%99%B0%EF%BC%8C%E5%B0%B1%E8%BF%94%E5%9B%9E%E2%80%9C%E5%BC%95%E8%A8%80%E2%80%9D%E5%92%8C%E2%80%9C%E7%AC%AC%E4%BA%8C%E7%AB%A0%E2%80%9D%E3%80%82%5Cn4.%20JSON%20%E5%AD%97%E6%AE%B5%E4%BC%9A%E7%9B%B4%E6%8E%A5%E7%94%A8%E4%BA%8E%E9%80%90%E7%AB%A0%E7%B2%BE%E8%AF%BB%E6%8F%90%E7%A4%BA%E8%AF%8D%E6%A8%A1%E6%9D%BF%EF%BC%9Atitle_zh%20%E5%AF%B9%E5%BA%94%20%7B%7Btitle_zh%7D%7D%EF%BC%8Ctitle_en%20%E5%AF%B9%E5%BA%94%20%7B%7Btitle_en%7D%7D%EF%BC%8Cid%20%E4%BB%85%E7%94%A8%E4%BA%8E%E5%86%85%E9%83%A8%E6%A0%87%E8%AF%86%E3%80%82%22%2C%22chapterTemplate%22%3A%22%E8%AF%B7%E7%B2%BE%E8%AF%BB%E8%AE%BA%E6%96%87%E4%B8%AD%E7%9A%84%E2%80%9C%7B%7Btitle_zh%7D%7D%EF%BC%88%7B%7Btitle_en%7D%7D%EF%BC%89%E2%80%9D%E8%BF%99%E4%B8%80%E7%AB%A0%E3%80%82%5Cn%5Cn%E8%AF%B7%E5%9B%B4%E7%BB%95%E4%B8%8B%E9%9D%A2%E9%97%AE%E9%A2%98%E7%BB%84%E7%BB%87%E5%9B%9E%E7%AD%94%EF%BC%9A%5Cn1.%20%E8%BF%99%E4%B8%80%E7%AB%A0%E5%9C%A8%E5%85%A8%E6%96%87%E4%B8%AD%E7%9A%84%E4%BD%9C%E7%94%A8%E6%98%AF%E4%BB%80%E4%B9%88%EF%BC%9F%5Cn2.%20%E8%BF%99%E4%B8%80%E7%AB%A0%E6%8F%90%E5%87%BA%E4%BA%86%E5%93%AA%E4%BA%9B%E5%85%B3%E9%94%AE%E6%A6%82%E5%BF%B5%E3%80%81%E8%AE%BA%E8%AF%81%E6%88%96%E6%8A%80%E6%9C%AF%E7%BB%86%E8%8A%82%EF%BC%9F%5Cn3.%20%E5%93%AA%E4%BA%9B%E5%86%85%E5%AE%B9%E6%98%AF%E8%AF%BB%E8%80%85%E7%90%86%E8%A7%A3%E5%90%8E%E7%BB%AD%E7%AB%A0%E8%8A%82%E5%BF%85%E9%A1%BB%E6%8E%8C%E6%8F%A1%E7%9A%84%EF%BC%9F%5Cn4.%20%E5%A6%82%E6%9E%9C%E8%BF%99%E4%B8%80%E7%AB%A0%E6%9C%89%E5%85%AC%E5%BC%8F%E3%80%81%E5%AE%9E%E9%AA%8C%E8%AE%BE%E7%BD%AE%E6%88%96%E5%AE%9A%E4%B9%89%EF%BC%8C%E8%AF%B7%E7%94%A8%E9%80%9A%E4%BF%97%E4%B8%AD%E6%96%87%E8%A7%A3%E9%87%8A%E3%80%82%5Cn%5Cn%E8%BE%93%E5%87%BA%E8%A6%81%E6%B1%82%EF%BC%9A%5Cn-%20%E4%BD%BF%E7%94%A8%20Markdown%E3%80%82%5Cn-%20%E4%B8%8D%E8%A6%81%E5%AF%92%E6%9A%84%EF%BC%8C%E4%B8%8D%E8%A6%81%E9%87%8D%E5%A4%8D%E9%A2%98%E7%9B%AE%E3%80%82%5Cn-%20%E6%A0%87%E9%A2%98%E5%B1%82%E7%BA%A7%E4%BB%8E%E4%B8%89%E7%BA%A7%E6%A0%87%E9%A2%98%E5%BC%80%E5%A7%8B%EF%BC%8C%E4%BE%8B%E5%A6%82%E2%80%9C%23%23%23%20%E6%9C%AC%E7%AB%A0%E4%BD%9C%E7%94%A8%E2%80%9D%E3%80%82%5Cn-%20%E5%B0%BD%E9%87%8F%E8%AE%A9%E6%B2%A1%E6%9C%89%E8%AF%A5%E5%B0%8F%E6%96%B9%E5%90%91%E8%83%8C%E6%99%AF%E7%9A%84%E8%AF%BB%E8%80%85%E4%B9%9F%E8%83%BD%E7%9C%8B%E6%87%82%E3%80%82%22%7D%2C%7B%22id%22%3A%22deep_questions%22%2C%22title%22%3A%22%E9%98%B6%E6%AE%B5%E4%BA%8C%EF%BC%9A%E9%87%8D%E7%82%B9%E8%BF%BD%E9%97%AE%22%2C%22type%22%3A%22independent%22%2C%22description%22%3A%22%E6%AF%8F%E4%B8%AA%E8%BF%BD%E9%97%AE%E7%8B%AC%E7%AB%8B%E9%98%85%E8%AF%BB%E5%85%A8%E6%96%87%E5%85%A8%E6%96%87%EF%BC%8C%E4%B8%8D%E6%90%BA%E5%B8%A6%E5%85%B6%E4%BB%96%E8%BD%AE%E6%AC%A1%E4%B8%8A%E4%B8%8B%E6%96%87%E3%80%82%22%2C%22parallelizable%22%3Afalse%2C%22maxConcurrency%22%3A1%2C%22prompts%22%3A%5B%7B%22id%22%3A%22q_core_contribution%22%2C%22title%22%3A%22%E6%A0%B8%E5%BF%83%E8%B4%A1%E7%8C%AE%E5%88%A4%E6%96%AD%22%2C%22prompt%22%3A%22%E8%AF%B7%E5%9F%BA%E4%BA%8E%E8%AE%BA%E6%96%87%E5%85%A8%E6%96%87%EF%BC%8C%E7%94%A8%E4%B8%AD%E6%96%87%E5%88%A4%E6%96%AD%E6%9C%AC%E6%96%87%E6%9C%80%E6%A0%B8%E5%BF%83%E7%9A%84%E8%B4%A1%E7%8C%AE%E6%98%AF%E4%BB%80%E4%B9%88%EF%BC%8C%E5%B9%B6%E8%AF%B4%E6%98%8E%E5%AE%83%E4%B8%BA%E4%BB%80%E4%B9%88%E9%87%8D%E8%A6%81%E3%80%82%E8%BE%93%E5%87%BA%20Markdown%EF%BC%8C%E6%A0%87%E9%A2%98%E5%B1%82%E7%BA%A7%E4%BB%8E%E4%B8%89%E7%BA%A7%E6%A0%87%E9%A2%98%E5%BC%80%E5%A7%8B%E3%80%82%22%2C%22order%22%3A1%7D%2C%7B%22id%22%3A%22q_limits_questions%22%2C%22title%22%3A%22%E5%B1%80%E9%99%90%E4%B8%8E%E7%96%91%E9%97%AE%22%2C%22prompt%22%3A%22%E8%AF%B7%E5%9F%BA%E4%BA%8E%E8%AE%BA%E6%96%87%E5%85%A8%E6%96%87%EF%BC%8C%E7%94%A8%E4%B8%AD%E6%96%87%E5%88%97%E5%87%BA%E6%9C%AC%E6%96%87%E6%9C%80%E5%80%BC%E5%BE%97%E6%B3%A8%E6%84%8F%E7%9A%84%E5%B1%80%E9%99%90%E3%80%81%E9%A3%8E%E9%99%A9%E6%88%96%E4%BB%8D%E6%9C%AA%E8%A7%A3%E5%86%B3%E7%9A%84%E9%97%AE%E9%A2%98%E3%80%82%E8%BE%93%E5%87%BA%20Markdown%EF%BC%8C%E6%A0%87%E9%A2%98%E5%B1%82%E7%BA%A7%E4%BB%8E%E4%B8%89%E7%BA%A7%E6%A0%87%E9%A2%98%E5%BC%80%E5%A7%8B%E3%80%82%22%2C%22order%22%3A2%7D%5D%7D%5D%2C%22prompts%22%3A%5B%5D%7D%2C%22chapters%22%3A%5B%7B%22id%22%3A%22ch1%22%2C%22title_zh%22%3A%22%E5%BC%95%E8%A8%80%22%2C%22title_en%22%3A%22Introduction%22%7D%2C%7B%22id%22%3A%22ch2%22%2C%22title_zh%22%3A%22%E6%96%B9%E6%B3%95%22%2C%22title_en%22%3A%22Methods%22%7D%2C%7B%22id%22%3A%22ch3%22%2C%22title_zh%22%3A%22%E6%95%B0%E6%8D%AE%E4%B8%8E%E5%88%86%E6%9E%90%22%2C%22title_en%22%3A%22Data%20and%20Analysis%22%7D%2C%7B%22id%22%3A%22ch4%22%2C%22title_zh%22%3A%22%E7%BB%93%E6%9E%9C%22%2C%22title_en%22%3A%22Results%22%7D%2C%7B%22id%22%3A%22ch5%22%2C%22title_zh%22%3A%22%E6%A8%A1%E5%9E%8B%E8%AE%A8%E8%AE%BA%E4%B8%8E%E6%AF%94%E8%BE%83%22%2C%22title_en%22%3A%22Model%20Discussion%20and%20Comparison%22%7D%2C%7B%22id%22%3A%22ch6%22%2C%22title_zh%22%3A%22%E7%BB%93%E8%AE%BA%22%2C%22title_en%22%3A%22Conclusion%22%7D%5D%7D --&gt;
&lt;h1&gt;AI 精读 - How Much Can Machines Learn Finance from Chinese Text Data?&lt;/h1&gt;
&lt;h2&gt;章节解析&lt;/h2&gt;
&lt;p&gt;第1章：引言（Introduction）&lt;/p&gt;
&lt;p&gt;第2章：方法（Methods）&lt;/p&gt;
&lt;p&gt;第3章：数据与分析（Data and Analysis）&lt;/p&gt;
&lt;p&gt;第4章：结果（Results）&lt;/p&gt;
&lt;p&gt;第5章：模型讨论与比较（Model Discussion and Comparison）&lt;/p&gt;
&lt;p&gt;第6章：结论（Conclusion）&lt;/p&gt;
&lt;!-- zab:slot:chapter_ch1:done --&gt;
&lt;h2&gt;引言&lt;/h2&gt;
&lt;h3&gt;本章作用&lt;/h3&gt;
&lt;p&gt;引言在全文中的作用可以概括为“提出问题、批判旧方法、给出新框架、预告证据”。它首先说明文本数据对金融研究的重要性：新闻、媒体评论等能反映市场参与者的态度、观点和情绪，因此有潜力预测资产价格。接着指出传统做法——尤其是基于人工词典的“情感词计数法”——虽然简单可复制，但严重依赖人类先验知识，容易产生主观偏差。作者回顾了现有机器学习文本分析的几条路线，例如词选择模型、主题模型、词向量聚类模型等，并指出它们各自的局限：有的依赖预定义词典，有的依赖生成过程的强假设，有的只使用降维后的主题而丢弃个股特有信息。&lt;/p&gt;
&lt;p&gt;在此基础上，引言提出本文的核心方法 FarmPredict，即“因子增强的稀疏正则化预测”框架。它的关键特征是：不需要预定义词典或预训练模型，而是让机器直接从新闻文本中无监督地提取信息。引言还概括了 FarmPredict 的三个步骤：用主成分分析从高频词中学习潜在因子和残差；根据这些残差与股票超额收益的相关性筛选“情绪词”；最后用惩罚回归同时使用因子和残差进行预测。&lt;/p&gt;
&lt;p&gt;引言还预告了实证应用：以中国新浪财经新闻为数据，预测中国股市个股收益。它概括了主要发现：正情绪新闻平均带来 83 个基点的个股超额收益，负情绪新闻带来约 26 个基点的负面冲击；正负影响不对称，与中国市场卖空限制一致。基于情绪分数的多空组合在考虑了交易成本后，等权组合年化收益最高可达 54%，夏普比率 4.30，显著优于多种基准模型。引言最后给出全文结构安排，为后文的方法、数据、结果、讨论和结论提供路线图。&lt;/p&gt;
&lt;h3&gt;本章提出的关键概念、论证与技术细节&lt;/h3&gt;
&lt;p&gt;引言虽然没有给出编号公式，但为后文第 2 节的方法建立了核心概念。&lt;/p&gt;
&lt;h4&gt;1. 预测目标：beta-adjusted return&lt;/h4&gt;
&lt;p&gt;文章的核心学习目标是 &lt;strong&gt;beta-adjusted return&lt;/strong&gt;，即“超额收益”。通俗地说，个股收益中有一部分是大盘涨跌带来的系统性收益，应当剔除，剩下的才是新闻可能影响的特异性收益。这个概念在引言中反复出现，是理解全文结果的基础。&lt;/p&gt;
&lt;h4&gt;2. 文本数据的稀疏高维问题&lt;/h4&gt;
&lt;p&gt;文章将每篇新闻表示为一个词频向量。中文新闻数据中词汇量非常大，但单篇文章用到的词很少，因此词频矩阵高度稀疏。传统回归直接使用所有词会面临“维数灾难”和多重共线性问题。作者假设只有少数词对收益有预测力，这些词被称为 &lt;strong&gt;sentiment-charged words&lt;/strong&gt;，其余词是中性噪声。这一假设为后续降维和变量选择提供了依据。&lt;/p&gt;
&lt;h4&gt;3. FarmPredict 的三步流程&lt;/h4&gt;
&lt;p&gt;引言将 FarmPredict 概括为三个步骤：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;strong&gt;无监督学习因子与残差&lt;/strong&gt;：把高维词频向量 &lt;span class=&quot;math&quot;&gt;$X_i$&lt;/span&gt; 分解为潜在因子 &lt;span class=&quot;math&quot;&gt;$f_i$&lt;/span&gt; 和特质残差 &lt;span class=&quot;math&quot;&gt;$u_i$&lt;/span&gt;。可以通俗理解为：把文章拆成“共同主题部分”和“单个词特有部分”。因子捕捉的是词汇之间的共现结构，例如宏观经济主题、基金主题、公司治理主题；残差则是某个词不能被共同主题解释的独特信息。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;条件筛选情绪词&lt;/strong&gt;：先剔除共同因子对收益的解释，再看每个残差词与剩余收益的相关性。这样选出的词是在共同主题之外仍有预测力的“情绪词”。这一步是可选但能显著降低计算量。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;惩罚回归联合预测&lt;/strong&gt;：用潜在因子和筛选后的残差一起对收益做回归，施加 LASSO 或其他稀疏惩罚，自动选择最重要的变量。模型可以写成 &lt;span class=&quot;math&quot;&gt;$Y_i = \alpha + \beta^T f_i + \gamma^T u_i + \epsilon_i$&lt;/span&gt; 的直觉形式，其中回归系数受惩罚项约束。&lt;/li&gt;
&lt;/ol&gt;
&lt;h4&gt;4. “双稳健”特征&lt;/h4&gt;
&lt;p&gt;这是 FarmPredict 最重要的论证之一。传统方法要么走“词选择”路线，要么走“主题/聚类”路线。FarmPredict 同时保留因子和残差，因此具有 &lt;strong&gt;double-robust&lt;/strong&gt; 性质：如果收益完全可以由少数关键词预测，模型会自动退化到接近 LASSO 的情形，少用甚至不用因子；如果收益主要由主题驱动，模型会自动更多利用因子。这样，无论数据真实结构偏向哪条路线，模型都能保持较好表现，避免只使用主成分导致的信息损失。&lt;/p&gt;
&lt;h4&gt;5. 文献定位与批判&lt;/h4&gt;
&lt;p&gt;引言回顾了几条重要文献：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;词典法：Loughran and McDonald 等提出的人工情感词典，虽然能发现情感与收益相关，但依赖主观人类经验。&lt;/li&gt;
&lt;li&gt;词选择法：如 MNIR（Taddy 2013）、文本回归（Jegadeesh and Wu 2013）、支持向量机（Manela and Moreira 2017）等，通常用惩罚回归选词，但可能忽略词间相关性和公共主题。&lt;/li&gt;
&lt;li&gt;主题模型：如 LDA、SESTM（Ke et al. 2019）等，假设文档由主题生成，但依赖先验分布假设，适应性有限。&lt;/li&gt;
&lt;li&gt;词向量聚类：如 Cong et al. 2019 使用 word2vec 将词向量化后聚类成文本因子，但聚类过程依赖预训练模型。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;作者认为这些方法未能充分回答“机器能从文本中学到多少金融信息”。FarmPredict 的设计正是为了减少这些人为限制。&lt;/p&gt;
&lt;h4&gt;6. 中国市场特殊性的论证&lt;/h4&gt;
&lt;p&gt;引言强调，中国股市散户占比高，市场监管和交易限制与美国不同，尤其是卖空限制较严。这带来一个可检验的预测：正面新闻可能被提前泄露并反映在股价上涨中，而负面新闻因为难以做空，往往在事件发生当天才突然下跌。引言预告事件研究将检验这一不对称性，并借此验证模型捕捉到的情绪是否具有真实金融含义。&lt;/p&gt;
&lt;h3&gt;理解后续章节必须掌握的内容&lt;/h3&gt;
&lt;p&gt;要理解后文的方法、数据和实证结果，读者需要掌握以下内容。&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;核心问题的数学化表示&lt;/strong&gt;：把新闻转化为词频向量 &lt;span class=&quot;math&quot;&gt;$X_i$&lt;/span&gt;，目标变量 &lt;span class=&quot;math&quot;&gt;$Y_i$&lt;/span&gt; 是新闻发布时对应的股票 beta-adjusted return。后续方法节会在此基础上建立因子模型 &lt;span class=&quot;math&quot;&gt;$X_i = B f_i + u_i$&lt;/span&gt; 和预测模型 &lt;span class=&quot;math&quot;&gt;$Y_i = \alpha + \beta^T f_i + \gamma^T u_i + \epsilon_i$&lt;/span&gt;。理解“因子 + 残差”的拆解是理解 FarmPredict 的前提。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;为什么需要 beta-adjusted return&lt;/strong&gt;：因为目标是学习新闻对个股的特有影响，而不是大盘涨跌。面板回归和事件研究都使用这个口径，后文组合收益也基于它。读者需要明白：正的 beta-adjusted return 意味着股票跑赢了大盘预期，负的则跑输。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;条件筛选的含义&lt;/strong&gt;：筛选情绪词不是简单地看词与收益的相关性，而是先扣除因子的解释力，再看残差词与剩余收益的相关性。这避免了把那些只是与其他主题词共现的词误选进来。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;实验设置的基本框架&lt;/strong&gt;：数据来自新浪财经新闻，经过清洗、股票匹配、中文分词后得到约 91.4 万篇文章。训练和测试采用滚动窗口，使用 2015—2019 年作为测试期。组合策略是做多情绪分数最高的 50 只股票、做空最低的 50 只股票，等权或市值加权。中国市场交易成本约 13 个基点，涨跌停限制 10%，这些会影响实际收益的上下界。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;关键的实证量级&lt;/strong&gt;：正情绪事件当天平均 83 bps 超额收益，负情绪为 -26 bps；正新闻的影响可持续数天，负新闻影响也持续数天。等权多空组合在考虑交易成本但不受涨跌停限制时年化收益 54%，夏普比率 4.30。这些数字为后文第 4、5 节的模型比较和稳健性分析提供了参照。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;情绪词的非直觉性&lt;/strong&gt;：引言举例“敢死队”在传统词典中不是负面情绪词，但在中国股市新闻中具有强烈负面预测力。这说明机器自动选词能捕捉到人工词典遗漏的语境含义。读者应预期后文中选出的词并不都是“高兴/悲伤”这类通用情感词。&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;h3&gt;实验设置与关键术语通俗解释&lt;/h3&gt;
&lt;p&gt;引言没有正式编号公式，但包含若干实验设置和术语，需要通俗解释。&lt;/p&gt;
&lt;h4&gt;实验设置&lt;/h4&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;数据来源&lt;/strong&gt;：新浪财经新闻网站。作者通过广度优先爬虫下载网页，提取正文、标题、发布时间，并将文章与股票进行匹配。文章数量巨大，经过清洗和降采样后约 91.4 万篇用于分析。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;中文分词&lt;/strong&gt;：使用 Jieba 分词工具，基于隐马尔可夫模型将连续的中文文本切成词语。例如“股票上涨”会被切成“股票”和“上涨”。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;收益口径&lt;/strong&gt;：使用 beta-adjusted return，即股票收益减去 β 倍的大盘收益。β 由 2005—2014 年个股日收益对上海证券综合指数回归得到。这样处理后，新闻的情绪分数主要解释个股特有波动，而不是大盘涨跌。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;训练与测试&lt;/strong&gt;：调参阶段使用 2000—2010 年作为训练集、2011—2014 年作为验证集；正式测试使用 2015—2019 年数据，并采用六个月滚动窗口，避免使用未来信息。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;交易限制&lt;/strong&gt;：中国股市有大约 13 个基点的双边交易成本，包括印花税、过户费和佣金；同时有 ±10% 的涨跌停限制。组合收益报告区分了是否考虑涨跌停限制的上下界。&lt;/li&gt;
&lt;/ul&gt;
&lt;h4&gt;关键术语通俗解释&lt;/h4&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;潜在因子&lt;/strong&gt;：隐藏在大量词汇背后的共同主题。例如“宏观经济”“基金”“公司治理”等。它们不是人工预先指定的，而是通过主成分分析从词频矩阵中自动提取出来的。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;特质残差&lt;/strong&gt;：某个词中不能被共同因子解释的部分。可以理解为“这个词的个性”。例如“敢死队”这个表达，可能不会出现在宏观主题因子中，但它对负面收益有独特预测力。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;情绪词&lt;/strong&gt;：对股票超额收益有预测力的词。注意这里的“情绪”是数据驱动定义的，不必然是传统意义上的情感词。它可能是交易术语、特定隐喻、甚至看起来中性的词。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;调整特征值阈值&lt;/strong&gt;：一种确定因子个数的方法。大致做法是计算词频相关矩阵的特征值，看哪些特征值显著大于某个临界值，就认为存在多少个重要因子。引言中提到选择 &lt;span class=&quot;math&quot;&gt;$C = 150$&lt;/span&gt;，最终得到 9 个因子。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;LASSO&lt;/strong&gt;：一种线性回归方法，目标函数里加了一项“所有回归系数绝对值之和”的惩罚。这会使大量不重要的系数被压缩到 0，从而实现自动选词。惩罚强度通过交叉验证选择。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;double-robust&lt;/strong&gt;：字面意思是“双重稳健”。在本文中指模型同时使用因子和残差，因此无论“词选择”还是“主题聚类”哪条路更正确，模型都能自动适应，不会因为只走一条路而失效。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;事件研究&lt;/strong&gt;：把新闻发布视为一个“事件”，观察事件前后股票收益的平均变化。例如正新闻发生前 7 天收益是否已经上升，新闻当天是否有跳升，之后是否回落。这用于验证新闻是否真的传递了新信息。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;卖空限制&lt;/strong&gt;：中国股市对做空股票有严格限制，借券卖出成本高、难度大。这意味着投资者难以提前对负面消息进行做空交易，所以负面新闻往往在披露当天才反映为股价下跌，而正面新闻可能因为内部信息泄露或预期提前而逐步上涨。&lt;/li&gt;
&lt;/ul&gt;

&lt;!-- zab:slot:chapter_ch1:end --&gt;
&lt;hr/&gt;
&lt;!-- zab:slot:chapter_ch2:done --&gt;
&lt;h2&gt;方法&lt;/h2&gt;
&lt;h3&gt;本章作用&lt;/h3&gt;
&lt;p&gt;方法章是全文的技术核心，把引言中提出的 FarmPredict 从概念落实为可操作的算法流程。它的作用是：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;strong&gt;形式化研究问题&lt;/strong&gt;：明确新闻文本如何变成结构化的词频向量 &lt;span class=&quot;math&quot;&gt;$X_i$&lt;/span&gt;，以及预测目标 &lt;span class=&quot;math&quot;&gt;$Y_i$&lt;/span&gt; 是新闻发布日对应的个股 beta-adjusted return。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;给出完整建模步骤&lt;/strong&gt;：从频繁词筛选、因子分解、因子个数选择、情绪词条件筛选，到 LASSO 拟合和新文章评分，构成一条可复现的文本预测流水线。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;建立 FarmPredict 的核心机制&lt;/strong&gt;：说明为什么同时使用“共同因子”和“特质残差”能获得 double-robust 性质，避免单纯选词或单纯主题模型的信息损失。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;为后续实证提供统一口径&lt;/strong&gt;：后续第 3 节的数据处理、第 4 节的验证与组合表现、第 5 节的模型比较，都直接依赖这一章定义的变量、超参数和评分方式。&lt;/li&gt;
&lt;/ol&gt;
&lt;h3&gt;本章提出的关键概念、论证与技术细节&lt;/h3&gt;
&lt;h4&gt;1. 问题设定：从新闻到高维稀疏词向量&lt;/h4&gt;
&lt;p&gt;设共有 &lt;span class=&quot;math&quot;&gt;$n$&lt;/span&gt; 篇文章，所有可能的中文词构成集合 &lt;span class=&quot;math&quot;&gt;$\mathcal D$&lt;/span&gt;。第 &lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt; 篇文章用一个词频向量 &lt;span class=&quot;math&quot;&gt;$d_i \in \mathbb N^{|\mathcal D|}$&lt;/span&gt; 表示，其中 &lt;span class=&quot;math&quot;&gt;$d_{i,k}$&lt;/span&gt; 表示第 &lt;span class=&quot;math&quot;&gt;$k$&lt;/span&gt; 个词在第 &lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt; 篇文章中出现的次数。&lt;/p&gt;
&lt;p&gt;每篇文章还对应一个学习目标 &lt;span class=&quot;math&quot;&gt;$Y_i$&lt;/span&gt;，即该新闻所匹配股票在新闻发布日的 beta-adjusted return。这里的 beta-adjusted return 是个股收益减去 &lt;span class=&quot;math&quot;&gt;$\beta_i$&lt;/span&gt; 倍的大盘收益，用来剔除大盘涨跌，保留新闻可能影响的个股特有收益。&lt;/p&gt;
&lt;p&gt;这类数据有两个典型特征：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;高维&lt;/strong&gt;：本文数据中有超过 118 万个不同词。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;稀疏&lt;/strong&gt;：一篇新闻通常只使用几百个词，词频向量中绝大多数位置为零。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;因此，文章假设只有少数词真正影响收益，称为 &lt;strong&gt;sentiment-charged words&lt;/strong&gt;，记作集合 &lt;span class=&quot;math&quot;&gt;$\mathcal S$&lt;/span&gt;；其余词是 &lt;strong&gt;sentiment-neutral words&lt;/strong&gt;，记作集合 &lt;span class=&quot;math&quot;&gt;$\mathcal N$&lt;/span&gt;。这个假设是整个模型降维和变量选择的起点。&lt;/p&gt;
&lt;h4&gt;2. FarmPredict 的核心思想：因子 + 残差&lt;/h4&gt;
&lt;p&gt;传统文本分析方法大致分两类：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;词选择法&lt;/strong&gt;：从高维词中选出少数有预测力的词，然后做回归，例如 LASSO。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;主题聚类法&lt;/strong&gt;：把词聚成少数主题或因子，再用主题做预测，例如 LDA、词向量聚类。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;FarmPredict 的关键论证是：&lt;strong&gt;这两类方法各有信息损失，应当同时保留因子和残差&lt;/strong&gt;。&lt;/p&gt;
&lt;p&gt;文章假设词频向量由一个近似因子模型生成：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$X_i = B f_i + u_i,$&lt;/pre&gt;
&lt;p&gt;其中：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$f_i \in \mathbb R^k$&lt;/span&gt; 是第 &lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt; 篇文章的 &lt;span class=&quot;math&quot;&gt;$k$&lt;/span&gt; 个潜在因子，可以理解为共同主题；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$B$&lt;/span&gt; 是因子载荷矩阵，反映每个词在不同主题上的重要性；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$u_i$&lt;/span&gt; 是特质残差，表示某个词不能由共同主题解释的独特信息。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;随后，模型同时把因子 &lt;span class=&quot;math&quot;&gt;$f_i$&lt;/span&gt; 和残差 &lt;span class=&quot;math&quot;&gt;$u_i$&lt;/span&gt; 作为预测变量：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$Y_i = a + b^T f_i + \beta^T u_i + \epsilon_i.$&lt;/pre&gt;
&lt;p&gt;这里为了区分两个系数向量，我们用 &lt;span class=&quot;math&quot;&gt;$b$&lt;/span&gt; 表示因子系数，&lt;span class=&quot;math&quot;&gt;$\beta$&lt;/span&gt; 表示残差系数；原文因排版原因两者都显示为 &lt;span class=&quot;math&quot;&gt;$b$&lt;/span&gt;，读者应理解为两个不同的系数向量。&lt;/p&gt;
&lt;p&gt;这种设计带来 &lt;strong&gt;double-robust&lt;/strong&gt; 性质：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;如果收益完全可以由少数关键词解释，模型会把因子系数压缩到零，自动退化为 LASSO；&lt;/li&gt;
&lt;li&gt;如果收益主要由主题驱动，模型会更多使用因子；&lt;/li&gt;
&lt;li&gt;如果两者都有信息，模型会自动在两者之间取得平衡。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;同时，因为因子和残差张成的线性空间与原词向量空间相同，&lt;strong&gt;因子增强不会丢失原始特征空间的信息&lt;/strong&gt;，只是换了一种更便于建模的表示方式。&lt;/p&gt;
&lt;h4&gt;3. FarmPredict 的六步流程&lt;/h4&gt;
&lt;h5&gt;第一步：频繁词筛选&lt;/h5&gt;
&lt;p&gt;原始词表中有大量只出现一两次的词，这些词既难估计，也难以在新文章中再次出现。因此，FarmPredict 先保留出现频次足够高的词。&lt;/p&gt;
&lt;p&gt;设第 &lt;span class=&quot;math&quot;&gt;$j$&lt;/span&gt; 个词在 &lt;span class=&quot;math&quot;&gt;$k_j$&lt;/span&gt; 篇文章中出现过。给定阈值 &lt;span class=&quot;math&quot;&gt;$\kappa$&lt;/span&gt;，保留的频繁词集合为：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$\mathcal D_{\text{freq}} = \{ \text{第 } j \text{ 个词} : k_j \ge \kappa \}.$&lt;/pre&gt;
&lt;p&gt;阈值 &lt;span class=&quot;math&quot;&gt;$\kappa$&lt;/span&gt; 是超参数，用来平衡“保留足够多词”和“减少低频噪声”。本文中 &lt;span class=&quot;math&quot;&gt;$\kappa$&lt;/span&gt; 从所有词频的 80%–96% 分位数中选择，最终保留大约 3,000 到 15,000 个词。&lt;/p&gt;
&lt;h5&gt;第二步：因子建模&lt;/h5&gt;
&lt;p&gt;设 &lt;span class=&quot;math&quot;&gt;$X_i$&lt;/span&gt; 是文章 &lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt; 在 &lt;span class=&quot;math&quot;&gt;$\mathcal D_{\text{freq}}$&lt;/span&gt; 上的特征向量，可以是原始词频，也可以是二元出现标记。假设 &lt;span class=&quot;math&quot;&gt;$X_i$&lt;/span&gt; 服从近似因子模型：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$X_i = B f_i + u_i.$&lt;/pre&gt;
&lt;p&gt;写成矩阵形式：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$X = F B^T + U,$&lt;/pre&gt;
&lt;p&gt;其中：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$X$&lt;/span&gt; 是 &lt;span class=&quot;math&quot;&gt;$n \times |\mathcal D_{\text{freq}}|$&lt;/span&gt; 的词特征矩阵；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$F$&lt;/span&gt; 是 &lt;span class=&quot;math&quot;&gt;$n \times k$&lt;/span&gt; 的因子矩阵；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$B$&lt;/span&gt; 是载荷矩阵；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$U$&lt;/span&gt; 是残差矩阵。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;在因子模型中，只有 &lt;span class=&quot;math&quot;&gt;$X$&lt;/span&gt; 可观测，&lt;span class=&quot;math&quot;&gt;$F$&lt;/span&gt;、&lt;span class=&quot;math&quot;&gt;$B$&lt;/span&gt;、&lt;span class=&quot;math&quot;&gt;$U$&lt;/span&gt; 都需要通过主成分分析来估计。&lt;/p&gt;
&lt;h5&gt;第三步：用 PCA 估计因子和残差&lt;/h5&gt;
&lt;p&gt;对给定的因子个数 &lt;span class=&quot;math&quot;&gt;$k$&lt;/span&gt;，通过最小二乘拟合近似因子模型，等价于主成分分析。具体估计为：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$\hat F = \sqrt{n} \times X X^T$&lt;/span&gt; 的最大 &lt;span class=&quot;math&quot;&gt;$k$&lt;/span&gt; 个特征值对应的特征向量；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$\hat B = X^T \hat F / n$&lt;/span&gt;；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$\hat U = X - \hat F \hat B^T$&lt;/span&gt;。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;通俗地说，&lt;span class=&quot;math&quot;&gt;$\hat F$&lt;/span&gt; 是文章在主题空间中的坐标，&lt;span class=&quot;math&quot;&gt;$\hat B$&lt;/span&gt; 是每个词与主题的关系，&lt;span class=&quot;math&quot;&gt;$\hat U$&lt;/span&gt; 是每篇文章中每个词不能被主题解释的剩余部分。&lt;/p&gt;
&lt;h5&gt;第四步：因子个数选择&lt;/h5&gt;
&lt;p&gt;为了确定 &lt;span class=&quot;math&quot;&gt;$k$&lt;/span&gt;，文章采用调整特征值阈值方法。其思想是：计算词特征相关矩阵的校正特征值，如果某个校正特征值显著大于 1，就认为存在一个额外因子。&lt;/p&gt;
&lt;p&gt;具体规则为：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$\hat k = \max \left\{ j &amp;lt; |\mathcal D_{\text{freq}}| : \hat \lambda_j^C &amp;gt; 1 + C \sqrt{\frac{|\mathcal D_{\text{freq}}|}{n-1}} \right\}.$&lt;/pre&gt;
&lt;p&gt;其中 &lt;span class=&quot;math&quot;&gt;$\hat \lambda_j^C$&lt;/span&gt; 是相关矩阵第 &lt;span class=&quot;math&quot;&gt;$j$&lt;/span&gt; 大特征值的偏差校正估计量，&lt;span class=&quot;math&quot;&gt;$C$&lt;/span&gt; 是控制阈值的超参数。&lt;span class=&quot;math&quot;&gt;$C$&lt;/span&gt; 越大，阈值越高，选出的因子数越少。&lt;/p&gt;
&lt;p&gt;本文选择 &lt;span class=&quot;math&quot;&gt;$C = 150$&lt;/span&gt;，在训练数据上得到 &lt;span class=&quot;math&quot;&gt;$\hat k = 9$&lt;/span&gt; 个因子。后续所有模型比较都固定 &lt;span class=&quot;math&quot;&gt;$C = 150$&lt;/span&gt;。&lt;/p&gt;
&lt;h5&gt;第五步：条件筛选情绪词&lt;/h5&gt;
&lt;p&gt;在估计出因子 &lt;span class=&quot;math&quot;&gt;$\hat F$&lt;/span&gt; 和残差 &lt;span class=&quot;math&quot;&gt;$\hat U$&lt;/span&gt; 后，FarmPredict 进一步筛选出具有预测力的情绪词。&lt;/p&gt;
&lt;p&gt;首先，将收益 &lt;span class=&quot;math&quot;&gt;$Y$&lt;/span&gt; 对因子 &lt;span class=&quot;math&quot;&gt;$\hat F$&lt;/span&gt; 做线性回归，得到残差 &lt;span class=&quot;math&quot;&gt;$\hat Y_u$&lt;/span&gt;。这个残差表示：&lt;strong&gt;去掉共同主题解释后，收益中剩下的部分&lt;/strong&gt;。&lt;/p&gt;
&lt;p&gt;然后，对每个词的残差列 &lt;span class=&quot;math&quot;&gt;$\hat U_j$&lt;/span&gt; 计算其与 &lt;span class=&quot;math&quot;&gt;$\hat Y_u$&lt;/span&gt; 的相关性。给定阈值 &lt;span class=&quot;math&quot;&gt;$\alpha$&lt;/span&gt;，情绪词集合为：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$\hat S = \{ j : |\operatorname{corr}(\hat U_j, \hat Y_u)| &amp;gt; \alpha \} \cap \{ j : k_j \ge \kappa \}.$&lt;/pre&gt;
&lt;p&gt;这个步骤的关键是“条件在因子上”。它不是简单看词与收益的相关性，而是看&lt;strong&gt;在剔除共同主题之后，单个词的独特信息是否仍然与收益相关&lt;/strong&gt;。这样可以避免选入那些只是因为主题共现而与收益相关的词。&lt;/p&gt;
&lt;p&gt;当 &lt;span class=&quot;math&quot;&gt;$\alpha = 0$&lt;/span&gt; 时，相当于不做情绪词筛选，保留所有残差词。&lt;/p&gt;
&lt;h5&gt;第六步：LASSO 拟合与新文章评分&lt;/h5&gt;
&lt;p&gt;在筛选出的情绪词上，FarmPredict 求解惩罚最小二乘：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$(\hat a, \hat b, \hat \beta) = \arg \min_{a, b, \beta}
\left\{
\frac{1}{n} \sum_{i=1}^n \left( Y_i - a - b^T f_i - \beta^T u_{i,\hat S} \right)^2
+ \lambda \|b\|_1 + \lambda \|\beta\|_1
\right\}.$&lt;/pre&gt;
&lt;p&gt;其中：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$u_{i,\hat S}$&lt;/span&gt; 表示第 &lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt; 篇文章中属于情绪词集合 &lt;span class=&quot;math&quot;&gt;$\hat S$&lt;/span&gt; 的残差分量；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$\|b\|_1$&lt;/span&gt; 和 &lt;span class=&quot;math&quot;&gt;$\|\beta\|_1$&lt;/span&gt; 是 L1 惩罚，会把不重要系数压缩到零；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$\lambda$&lt;/span&gt; 控制惩罚强度，通常通过交叉验证选择。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;对于一篇新文章，其特征向量为 &lt;span class=&quot;math&quot;&gt;$X_{\text{new}}$&lt;/span&gt;。利用训练好的载荷矩阵 &lt;span class=&quot;math&quot;&gt;$\hat B$&lt;/span&gt;，先求解因子的最小二乘估计：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$f_{\text{new}} = (\hat B^T \hat B)^{-1} \hat B^T X_{\text{new}},$&lt;/pre&gt;
&lt;p&gt;然后计算残差：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$u_{\text{new}} = X_{\text{new}} - \hat B f_{\text{new}}.$&lt;/pre&gt;
&lt;p&gt;最后，文章的情感分数为：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$\hat Y_{\text{new}} = \hat a + \hat b^T f_{\text{new}} + \hat \beta^T u_{\text{new}, \hat S}.$&lt;/pre&gt;
&lt;p&gt;这个 &lt;span class=&quot;math&quot;&gt;$\hat Y_{\text{new}}$&lt;/span&gt; 就是文章对应股票的预期 beta-adjusted return，后续组合策略正是根据这个分数对股票排序。&lt;/p&gt;
&lt;h4&gt;4. FarmPredict 的模型变体&lt;/h4&gt;
&lt;p&gt;方法章还强调 FarmPredict 是一个灵活框架，而不是一个固定模型。可以替换的模块包括：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;响应变量&lt;/strong&gt;：&lt;span class=&quot;math&quot;&gt;$Y$&lt;/span&gt; 可以是连续 beta-adjusted return，也可以是正负收益的二分类变量。后者可以用惩罚逻辑回归代替惩罚最小二乘。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;特征形式&lt;/strong&gt;：&lt;span class=&quot;math&quot;&gt;$X_i$&lt;/span&gt; 可以是原始词频，也可以是 0/1 二元出现标记。二元特征下，因子载荷也可以改用逻辑回归估计。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;预测模型&lt;/strong&gt;：线性模型可以被非线性模型替代，例如神经网络或结构化非参数模型。因子的学习和残差的构造不变，但最后一步可以用 &lt;span class=&quot;math&quot;&gt;$g(f_i, u_{i,S})$&lt;/span&gt; 来拟合 &lt;span class=&quot;math&quot;&gt;$Y_i$&lt;/span&gt;。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;因此，FarmPredict 更像一个“因子增强 + 稀疏预测”的分析框架，可以适应不同的输入、筛选方式和预测模型。&lt;/p&gt;
&lt;h3&gt;理解后续章节必须掌握的内容&lt;/h3&gt;
&lt;p&gt;要理解后文的实证结果，读者需要掌握以下内容。&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;输入输出关系&lt;/strong&gt;：&lt;span class=&quot;math&quot;&gt;$X_i$&lt;/span&gt; 是文章的词特征向量，&lt;span class=&quot;math&quot;&gt;$Y_i$&lt;/span&gt; 是对应股票的 beta-adjusted return。后续所有预测和组合收益都建立在这个口径上。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;情绪分数不是词频的简单线性组合&lt;/strong&gt;，而是先分解成因子和残差，再在残差词上做 LASSO 得到的 &lt;span class=&quot;math&quot;&gt;$\hat Y_{\text{new}}$&lt;/span&gt;。后续构建多空组合时，就是用这个分数排序。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;超参数的来源和取值&lt;/strong&gt;：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$C = 150$&lt;/span&gt;，得到 9 个因子；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$\kappa$&lt;/span&gt; 从词频 80%–96% 分位数中选择；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$\alpha$&lt;/span&gt; 控制情绪词数量为 500、1,000 或 2,000；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$\lambda$&lt;/span&gt; 由交叉验证选择。&lt;br&gt;这些超参数在 2000–2010 年训练、2011–2014 年验证的阶段确定，并在 2015–2019 年测试中保持不变。后续模型比较时，基准模型也使用相同的调参流程。&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;情绪词是条件筛选得到的&lt;/strong&gt;。这意味着读者在后文看到“涨停”“走强”等词时，应当理解这些词是在控制共同主题后仍然能解释收益的独特词，而不是简单高频词。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;因子与残差的区别&lt;/strong&gt;：因子捕捉共同主题，例如基金、公司治理、宏观经济；残差捕捉单个词的独特信息。后续第 5 节会比较“只看因子”和“只看残差”的表现，以说明 FarmPredict 的优势来自两者结合。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;滚动窗口测试&lt;/strong&gt;：方法章只给出模型，训练和测试的滚动方式在第 3 节详细说明，但它的基础是 FarmPredict 可以在每个窗口内独立完成因子提取、情绪词筛选和 LASSO 拟合。理解这一点有助于看懂后续样本外结果为何用 2015–2019 年作为测试期。&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;h3&gt;公式、实验设置与定义通俗解释&lt;/h3&gt;
&lt;h4&gt;公式通俗解释&lt;/h4&gt;
&lt;ul&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;频繁词筛选 (2.1)&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;math&quot;&gt;$\mathcal D_{\text{freq}} = \{ \text{第 } j \text{ 个词} : k_j \ge \kappa \}$&lt;/span&gt;&lt;br&gt;含义：只保留在至少 &lt;span class=&quot;math&quot;&gt;$\kappa$&lt;/span&gt; 篇文章中出现过的词。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;因子模型 (2.2)&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;math&quot;&gt;$X_i = B f_i + u_i$&lt;/span&gt;&lt;br&gt;含义：一篇文章的词特征可以拆成“共同主题部分 &lt;span class=&quot;math&quot;&gt;$B f_i$&lt;/span&gt;”和“单个词独特部分 &lt;span class=&quot;math&quot;&gt;$u_i$&lt;/span&gt;”。类似把一个人说的话拆成“他正在讨论的话题”和“他个人特有的用词习惯”。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;预测模型 (2.3)&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;math&quot;&gt;$Y_i = a + b^T f_i + \beta^T u_i + \epsilon_i$&lt;/span&gt;&lt;br&gt;含义：收益由共同主题、独特用词和随机噪声共同决定。普通 LASSO 只用 &lt;span class=&quot;math&quot;&gt;$X_i$&lt;/span&gt;，相当于只用 &lt;span class=&quot;math&quot;&gt;$B f_i + u_i$&lt;/span&gt; 的整体；FarmPredict 则把 &lt;span class=&quot;math&quot;&gt;$f_i$&lt;/span&gt; 和 &lt;span class=&quot;math&quot;&gt;$u_i$&lt;/span&gt; 分开，让模型分别学习主题和独特词的贡献。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;因子个数选择 (2.4)&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;math&quot;&gt;$\hat k = \max \{ j : \hat \lambda_j^C &amp;gt; 1 + C \sqrt{|\mathcal D_{\text{freq}}|/(n-1)} \}$&lt;/span&gt;&lt;br&gt;含义：如果校正后的相关矩阵特征值明显大于 1，就认为存在一个重要因子。&lt;span class=&quot;math&quot;&gt;$C$&lt;/span&gt; 控制“明显”的程度。本文选 &lt;span class=&quot;math&quot;&gt;$C=150$&lt;/span&gt;，相当于把阈值设得较高，最终保留 9 个因子。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;条件情绪词筛选 (2.5)&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;math&quot;&gt;$\hat S = \{ j : |\operatorname{corr}(\hat U_j, \hat Y_u)| &amp;gt; \alpha \} \cap \{ j : k_j \ge \kappa \}$&lt;/span&gt;&lt;br&gt;含义：先把收益中能被因子解释的部分去掉，得到“剩余收益”&lt;span class=&quot;math&quot;&gt;$\hat Y_u$&lt;/span&gt;；然后看每个词的残差 &lt;span class=&quot;math&quot;&gt;$\hat U_j$&lt;/span&gt; 与这个剩余收益的相关性。相关性超过 &lt;span class=&quot;math&quot;&gt;$\alpha$&lt;/span&gt; 的词进入情绪词集合。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;LASSO 拟合 (2.6)&lt;/strong&gt;&lt;br&gt;目标函数包含两项：第一项是普通最小二乘误差，第二项是 &lt;span class=&quot;math&quot;&gt;$\lambda(\|b\|_1 + \|\beta\|_1)$&lt;/span&gt;。&lt;br&gt;含义：既要让预测误差尽量小，又要让因子系数和残差系数的绝对值之和尽量小。L1 惩罚会使很多系数变成零，从而自动筛选变量。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;新文章打分 (2.7)–(2.8)&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;math&quot;&gt;$f_{\text{new}} = (\hat B^T \hat B)^{-1}\hat B^T X_{\text{new}}$&lt;/span&gt;，&lt;span class=&quot;math&quot;&gt;$u_{\text{new}} = X_{\text{new}} - \hat B f_{\text{new}}$&lt;/span&gt;。&lt;br&gt;含义：用训练好的“词典—主题”关系 &lt;span class=&quot;math&quot;&gt;$\hat B$&lt;/span&gt;，把新文章投影到主题空间得到 &lt;span class=&quot;math&quot;&gt;$f_{\text{new}}$&lt;/span&gt;，实际词向量减去主题部分得到残差 &lt;span class=&quot;math&quot;&gt;$u_{\text{new}}$&lt;/span&gt;。最后代入 &lt;span class=&quot;math&quot;&gt;$\hat Y_{\text{new}} = \hat a + \hat b^T f_{\text{new}} + \hat \beta^T u_{\text{new},\hat S}$&lt;/span&gt;，得到情感分数。&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;h4&gt;关键定义通俗解释&lt;/h4&gt;
&lt;ul&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;beta-adjusted return&lt;/strong&gt;：个股收益率减去 &lt;span class=&quot;math&quot;&gt;$\beta_i$&lt;/span&gt; 倍的大盘收益率。正的 beta-adjusted return 表示股票跑赢了大盘该有的水平，负的表示跑输。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;sentiment-charged words&lt;/strong&gt;：对 beta-adjusted return 有预测力的词。注意这里的“情绪”是数据驱动定义的，不一定是传统意义上的“高兴/悲伤”，也可能是“涨停”“敢死队”等交易术语或隐喻。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;潜在因子&lt;/strong&gt;：隐藏在大量词背后的共同主题，由 PCA 自动提取，不依赖人工定义。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;特质残差&lt;/strong&gt;：词频中不能由共同主题解释的部分，保留词的独特信息。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;调整特征值阈值&lt;/strong&gt;：一种根据相关矩阵特征值大小确定因子个数的方法。它先对特征值做偏差校正，再看是否超过某个临界值。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;LASSO&lt;/strong&gt;：带 L1 惩罚的线性回归，能把大量不重要系数压缩为零，实现自动变量选择。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;double-robust&lt;/strong&gt;：字面意思是“双重稳健”。本文指模型同时使用因子和残差，因此无论真实结构是“词选择”还是“主题聚类”占主导，模型都能自动适应。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;滚动窗口&lt;/strong&gt;：每六个月测试一次，每次用过去十年数据重新训练模型，然后向前滚动。这样保证测试期不包含未来信息。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;beta-adjusted return 的有效收益口径&lt;/strong&gt;：使用覆盖新闻发布时间的 close-to-close return。例如新闻在交易时段内发布，则使用前一天收盘到今天收盘的收益作为 &lt;span class=&quot;math&quot;&gt;$Y_i$&lt;/span&gt;。&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;

&lt;!-- zab:slot:chapter_ch2:end --&gt;
&lt;hr/&gt;
&lt;!-- zab:slot:chapter_ch3:done --&gt;
&lt;h2&gt;数据与分析&lt;/h2&gt;
&lt;h3&gt;本章作用&lt;/h3&gt;
&lt;p&gt;数据与分析章在全文中的功能是把方法章定义的 FarmPredict 从抽象模型变成可以在真实数据上运行、验证和比较的具体实验。它的作用可以概括为四点：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;strong&gt;提供可复现的数据基础&lt;/strong&gt;：明确数据从哪里来（新浪财经新闻）、如何爬取、如何清洗、如何与股票和收益匹配，以及为什么最终保留 914,070 篇文章。后续所有实证都建立在这份数据之上。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;定义真实预测目标口径&lt;/strong&gt;：把学习方法时要预测的 &lt;span class=&quot;math&quot;&gt;$Y_i$&lt;/span&gt; 从“beta-adjusted return”这个一般概念，落实到“覆盖新闻发布时间的 close-to-close return”这一具体计算规则。这是衔接方法章和结果章的关键桥梁。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;确定模型之外的全部实验设置&lt;/strong&gt;：包括超参数如何调、训练/验证/测试区间如何划分、滚动窗口怎样推进。这些设置决定了后续结果是否可信，也是不同模型公平比较的共同基础。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;说明数据的现实约束&lt;/strong&gt;：文章数量年际不平衡、中文文本高维稀疏、A 股涨跌停和交易成本等，直接影响后续事件研究和组合收益的解释。&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;简言之，方法章回答了“FarmPredict 怎么做”，本章回答“用哪些数据做、怎样准备数据、怎样设置实验”，从而让第 4 节的结果和第 5 节的模型比较具有可解释性和可重复性。&lt;/p&gt;
&lt;h3&gt;本章提出的关键概念、论证与技术细节&lt;/h3&gt;
&lt;h4&gt;1. 数据收集：广度优先爬取新浪财经&lt;/h4&gt;
&lt;p&gt;数据源是新浪财经网站，覆盖大量中国股票相关新闻。爬取策略是&lt;strong&gt;广度优先遍历&lt;/strong&gt;：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;从新浪财经和新浪财经频道的主页开始；&lt;/li&gt;
&lt;li&gt;下载网页 HTML，提取页面中的所有链接；&lt;/li&gt;
&lt;li&gt;只保留属于 &lt;code style=&quot;white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word;&quot;&gt;finance.sina.com.cn&lt;/code&gt; 或 &lt;code style=&quot;white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word;&quot;&gt;cj.sina.com.cn&lt;/code&gt; 域名的链接，加入队列；&lt;/li&gt;
&lt;li&gt;逐个访问队列中的链接，循环进行。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;爬虫程序从 2019 年底运行到 2020 年，共访问 630 万个链接，其中 580 万个是有效新闻文章。这种方式带有一定随机性，导致不同年份抓取到的新闻数量并不完全相同。但爬取过程在样本外测试期之后进行，不涉及用未来信息训练模型的问题。&lt;/p&gt;
&lt;h4&gt;2. 预处理流水线：把网页变成可建模的“词—收益”样本&lt;/h4&gt;
&lt;p&gt;预处理包含多个环环相扣的步骤：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;去重&lt;/strong&gt;：如果两篇文章在去除特殊字符后标题相同，而且发布日期相同，则只保留一篇。目的是删除转载、重复发布带来的冗余。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;清洗&lt;/strong&gt;：仅保留中文字符，剥离 HTML 标签、数字、英文标点和其他非中文内容。这样后续分词和词频统计只聚焦中文文本。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;匹配股票&lt;/strong&gt;：每篇文章需要对应到一只 A 股。优先利用新浪官方在 HTML 中标注的股票代码；如果没有官方标注，则扫描文章内容，匹配股票名称或代码。匹配不到或匹配到多只股票的文章被删除。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;匹配有效收益&lt;/strong&gt;：每篇文章与对应股票在新闻发布日的 beta-adjusted return 配对。若股票当天无有效收益（例如停牌），该文章被删除。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;降采样&lt;/strong&gt;：由于爬虫导致各年文章数量差异巨大，例如 2019 年下载超过 70 万篇，而 2012 年仅约 1 万篇，作者将每天文章数随机限制为最多 300 篇。最终得到 914,070 篇文章，各日分布更均匀。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;表 1 展示了每个步骤后剩余的文章数：从 5,880,943 篇有效新闻逐步降到 914,070 篇，说明清洗和匹配过程过滤掉了大量不适用的样本。&lt;/p&gt;
&lt;h4&gt;3. 分词：用隐马尔可夫模型处理中文&lt;/h4&gt;
&lt;p&gt;中文文本没有空格分词，因此需要自动切分词语。作者使用 &lt;strong&gt;Jieba 分词&lt;/strong&gt;，其核心是隐马尔可夫模型（HMM）：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;每个汉字被标注为四种状态之一：&lt;strong&gt;B&lt;/strong&gt;（词的开始）、&lt;strong&gt;M&lt;/strong&gt;（词的中间）、&lt;strong&gt;E&lt;/strong&gt;（词的结尾）、&lt;strong&gt;S&lt;/strong&gt;（单字词）；&lt;/li&gt;
&lt;li&gt;利用预先估计的发射概率和转移概率，通过 &lt;strong&gt;Viterbi 算法&lt;/strong&gt;找到最可能的状态序列；&lt;/li&gt;
&lt;li&gt;根据状态序列把连续汉字切分成词语。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;选择 Jieba 的原因有两点：能处理未登录词（比如“敢死队”这类非常用搭配），以及时间复杂度与字符数呈线性关系，处理海量文本速度快。&lt;/p&gt;
&lt;h4&gt;4. 有效收益口径：beta-adjusted return 的具体定义&lt;/h4&gt;
&lt;p&gt;本章给出了预测目标 &lt;span class=&quot;math&quot;&gt;$Y_i$&lt;/span&gt; 的精确计算方法。对股票 &lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt; 在时间 &lt;span class=&quot;math&quot;&gt;$t$&lt;/span&gt; 的 beta-adjusted return 定义为：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$\text{Beta-adjusted Return}_{it} = \text{Dividend Adjusted Return}_{it} - \beta_i \cdot \text{SSEC Return}_t$&lt;/pre&gt;
&lt;p&gt;其中：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Dividend Adjusted Return&lt;/strong&gt; 是个股在考虑分红、送股、拆股后的实际收益率；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;SSEC Return&lt;/strong&gt; 是上证综指收益率，代表市场整体涨跌；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$\beta_i$&lt;/span&gt; 是股票 &lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt; 对市场的敏感度，用 2005 年至 2014 年的日收益率对 SSEC 日收益率回归得到。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这个定义的含义是：把股票收益中由大盘涨跌解释的部分剔除掉，留下新闻可能影响的个股特质收益。&lt;/p&gt;
&lt;p&gt;更重要的是，&lt;strong&gt;收益时间范围&lt;/strong&gt;必须覆盖新闻发布时刻。本章采用 &lt;strong&gt;close-to-close return covering the article’s publish time&lt;/strong&gt;，例如：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;新闻在周二下午 1 点交易时段发布，则使用周一收盘到周二收盘的收益；&lt;/li&gt;
&lt;li&gt;新闻在周五下午 6 点收盘后发布，则使用周五收盘到下周一收盘的收益。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这样选取的收益能反映新闻发布后的即时价格冲击，而不是提前或滞后的无关波动。&lt;/p&gt;
&lt;h4&gt;5. 基本统计：高维稀疏性与样本分布&lt;/h4&gt;
&lt;p&gt;最终数据有 914,070 篇文章，全部词表包含 1,181,000 个不同词（和短语）。但绝大多数词非常罕见：只有 71,000 个词在至少 50 篇文章中出现过。因此，后续所有模型都基于这 71,000 个词。&lt;/p&gt;
&lt;p&gt;词频矩阵极度稀疏。每篇文章的中位数为：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;309 个总词；&lt;/li&gt;
&lt;li&gt;209 个不同词；&lt;/li&gt;
&lt;li&gt;在 71,000 维词向量中，非零元素比例仅约 0.29%。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这一统计直接说明为什么要使用因子模型和稀疏正则化来降维和选词。&lt;/p&gt;
&lt;p&gt;样本的时间分布也有特点：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;每天文章数在降采样后基本均匀，除三大长假外，每天约 300 篇左右；&lt;/li&gt;
&lt;li&gt;新闻发布时间集中在上午 9 点开盘前后和下午收盘前后，体现了财经新闻的时效性；&lt;/li&gt;
&lt;li&gt;表 2 展示了 2015–2019 年测试期每日文章数、覆盖股票数、上证综指收益和正收益新闻比例等统计量。&lt;/li&gt;
&lt;/ul&gt;
&lt;h4&gt;6. 超参数调优与固定&lt;/h4&gt;
&lt;p&gt;FarmPredict 中有几个不能由模型自动学习的超参数，需要通过验证集确定。调优策略如下：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;数据划分&lt;/strong&gt;：使用 2000–2010 年作为训练集，2011–2014 年作为验证集；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;目标函数&lt;/strong&gt;：选择使等权组合累计日收益最大化的超参数组合；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;固定 C&lt;/strong&gt;：通过调整特征值图发现两个较强因子和七个较弱因子，选择 &lt;span class=&quot;math&quot;&gt;$C=150$&lt;/span&gt;，得到因子数 &lt;span class=&quot;math&quot;&gt;$\hat k=9$&lt;/span&gt;，之后全篇固定不变；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;调 &lt;span class=&quot;math&quot;&gt;$\kappa$&lt;/span&gt;&lt;/strong&gt;：从所有词 &lt;span class=&quot;math&quot;&gt;$k_j$&lt;/span&gt; 的 80% 到 96% 分位数中选择，每次增加 2%，对应频繁词集合约 3,000 到 15,000 个词；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;调 &lt;span class=&quot;math&quot;&gt;$\alpha$&lt;/span&gt;&lt;/strong&gt;：控制情绪词集合大小，使 &lt;span class=&quot;math&quot;&gt;$\hat S$&lt;/span&gt; 恰好包含 500、1,000 或 2,000 个词；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;调 &lt;span class=&quot;math&quot;&gt;$\lambda$&lt;/span&gt;&lt;/strong&gt;：在 LASSO 中通过交叉验证选择。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这些超参数只在训练和验证阶段使用，测试期从 2015 年开始完全固定，避免根据测试结果再调整参数造成的过拟合。&lt;/p&gt;
&lt;h4&gt;7. 滚动窗口测试设计&lt;/h4&gt;
&lt;p&gt;为了模拟真实投资环境，所有模型都使用&lt;strong&gt;滚动窗口&lt;/strong&gt;进行样本外测试：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;每个窗口用 10 年数据训练，随后 6 个月数据测试；&lt;/li&gt;
&lt;li&gt;测试后窗口整体向前滚动 6 个月，重新训练和测试；&lt;/li&gt;
&lt;li&gt;第一个窗口用 2005–2014 年训练，2015 年 1–6 月测试；&lt;/li&gt;
&lt;li&gt;最后一个窗口的测试期为 2019 年 7–12 月；&lt;/li&gt;
&lt;li&gt;共 10 个窗口，覆盖 2015–2019 年每一个交易日。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这样设计既能保证训练和测试数据量稳定，又能避免在测试期内使用任何未来信息。训练文章数在各窗口为 428,000 到 529,000 篇，输入词数在 761,000 到 863,000 个。&lt;/p&gt;
&lt;h3&gt;理解后续章节必须掌握的内容&lt;/h3&gt;
&lt;p&gt;要理解第 4 节的结果和第 5 节的模型比较，读者必须记住以下内容：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;strong&gt;数据来源与样本期&lt;/strong&gt;：所有结果来自新浪财经新闻，样本期为 2000–2019 年，其中 2000–2014 年用于训练和调参，2015–2019 年用于样本外测试。后续所有组合收益、事件研究都基于测试期。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;有效收益口径&lt;/strong&gt;：&lt;span class=&quot;math&quot;&gt;$Y_i$&lt;/span&gt; 是覆盖新闻发布时间的 close-to-close beta-adjusted return。这个定义决定了后续事件研究为何以新闻发布日为第 1 天，也决定了组合构建为何在新闻发布后一天进行交易。它剔除了大盘涨跌，因此新闻情绪对个股的预测不应当与市场收益显著相关（第 4.1.2 节会检验这一点）。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;数据预处理规则&lt;/strong&gt;：文章必须匹配且仅匹配一只股票，并且有有效收益。这意味着数据集的文章都是与特定个股直接相关的，不能用于预测大盘指数。后续表 5 中情绪分数与市场收益不显著，正是这一口径的自然结果。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;超参数固定值&lt;/strong&gt;：&lt;span class=&quot;math&quot;&gt;$C=150$&lt;/span&gt;，&lt;span class=&quot;math&quot;&gt;$\hat k=9$&lt;/span&gt;，&lt;span class=&quot;math&quot;&gt;$\kappa$&lt;/span&gt; 从 80%–96% 分位数选择，&lt;span class=&quot;math&quot;&gt;$\alpha$&lt;/span&gt; 控制情绪词为 500/1,000/2,000，&lt;span class=&quot;math&quot;&gt;$\lambda$&lt;/span&gt; 交叉验证。这些设定在测试期保持不变，且基准模型也使用相同的调参流程。读者看到第 5 节模型比较时，应当知道所有方法都经历了同样的调参和滚动窗口测试。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;滚动窗口机制&lt;/strong&gt;：每 6 个月测试一次，用过去 10 年训练。这解释了为何后文样本外预测从 2015 年 1 月一直延伸到 2019 年 12 月，并且各窗口独立运行。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;A 股市场制度约束&lt;/strong&gt;：交易成本约为 13 个基点（印花税、过户费、佣金合计），以及 10% 涨跌停限制。第 4.2 节的组合收益区分了是否考虑交易成本和涨跌停，并提供了上限和下限。读者看到 54% 和 4.30% 的差异时，需要理解这是涨跌停极端假设造成的，不是模型不稳定。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;数据稀疏性和高维性&lt;/strong&gt;：每篇文章在 71,000 维词向量中只有约 0.29% 非零元素。这一统计是理解后续 LASSO、因子模型和情绪词筛选必要性的基础。&lt;/li&gt;
&lt;/ol&gt;
&lt;h3&gt;公式、实验设置与定义通俗解释&lt;/h3&gt;
&lt;h4&gt;公式通俗解释&lt;/h4&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Beta-adjusted Return 公式&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$\text{Beta-adjusted Return}_{it} = \text{Dividend Adjusted Return}_{it} - \beta_i \cdot \text{SSEC Return}_t$&lt;/pre&gt;
&lt;p&gt;  含义：股票实际收益去掉两个部分：一是分红、送股等造成的“名义收益”与实际价值变化不符的部分，二是大盘涨跌带来的同步波动。剩下的是股票自身在新闻发生日的特有收益。可以理解为：假设当天大盘涨了 1%，这只股票历史上有 &lt;span class=&quot;math&quot;&gt;$\beta_i=1.2$&lt;/span&gt; 的市场敏感度，那么理论上它应当涨 1.2%。如果它实际涨了 2%，那么多出来的 0.8% 就是新闻可能带来的额外影响。&lt;/p&gt;
&lt;h4&gt;关键定义通俗解释&lt;/h4&gt;
&lt;ul&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;close-to-close return covering the article’s publish time&lt;/strong&gt;：指从新闻发布前一个收盘价到发布后最近的收盘价之间的收益率。比如新闻在周二盘中发布，就用周一收盘价到周二收盘价的收益。这样设计是为了让收益尽量反映新闻发布后的价格变化，而不是数天前的旧信息。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;广度优先抓取&lt;/strong&gt;：像剥洋葱一样，先访问首页，把首页上的所有链接都记下来，然后依次访问这些链接，再把新页面的链接加入队列。这样可以快速覆盖网站的大部分内容，而且不依赖人工指定栏目。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;Jieba 分词和隐马尔可夫模型&lt;/strong&gt;：中文句子是一串连续的汉字，计算机不知道词与词的边界在哪里。Jieba 通过观察每个字在词中的位置（开头、中间、结尾、单字）来切分句子。例如“股票上涨”可能被切为“股票/上涨”，而“敢死队”会被识别为一个完整词，因为“敢”“死”“队”分别对应 B、M、E 状态的概率很高。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;有效收益匹配&lt;/strong&gt;：每篇文章必须能对应到一只股票，并且这只股票在新闻发布日要有可交易的收益数据。如果股票停牌或文章涉及多只股票，就删掉。这样确保每个训练样本都是“一条新闻 + 一只股票 + 一个当天特有收益”。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;&lt;span class=&quot;math&quot;&gt;$\kappa$&lt;/span&gt; 和 &lt;span class=&quot;math&quot;&gt;$\alpha$&lt;/span&gt; 的作用&lt;/strong&gt;：&lt;span class=&quot;math&quot;&gt;$\kappa$&lt;/span&gt; 决定一个词至少要在多少篇文章中出现过才被保留，从而过滤掉只出现一两次的噪声词。&lt;span class=&quot;math&quot;&gt;$\alpha$&lt;/span&gt; 决定一个词的残差与收益残差的相关性要多强才进入情绪词集合，从而把残差词数量从数万降到数百或数千。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;&lt;span class=&quot;math&quot;&gt;$C=150$&lt;/span&gt; 与因子数 9&lt;/strong&gt;：调整特征值方法中，&lt;span class=&quot;math&quot;&gt;$C$&lt;/span&gt; 越大，判定“存在因子”的门槛越高，选出的因子越少。作者通过特征值图发现前两个因子明显较强、后七个较弱，选择 &lt;span class=&quot;math&quot;&gt;$C=150$&lt;/span&gt; 恰好保留 9 个因子。这个 &lt;span class=&quot;math&quot;&gt;$C$&lt;/span&gt; 在调参阶段确定后就固定不变，防止在不同窗口产生不同因子数带来的不可比性。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;滚动窗口&lt;/strong&gt;：可以理解为移动的望远镜。先站在 2015 年初，用前十年数据训练模型，预测未来六个月；然后向前移动六个月，再重新训练和预测。这样测试期永远在训练期之后，符合真实投资中“不能用未来数据”的原则。&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;总之，数据与分析章为 FarmPredict 的实际运行提供了完整的数据生产和实验流程。它把高维稀疏的新闻文本转化为可用于监督学习的“词频—收益”样本，并明确了所有超参数和测试方式，是后续实证结果可信度的基础。&lt;/p&gt;

&lt;!-- zab:slot:chapter_ch3:end --&gt;
&lt;hr/&gt;
&lt;!-- zab:slot:chapter_ch4:done --&gt;
&lt;h2&gt;结果&lt;/h2&gt;
&lt;h3&gt;本章作用&lt;/h3&gt;
&lt;p&gt;“结果”这一章是全文的实证核心。方法章提出了 FarmPredict 的建模思路，数据章准备了可运行的新闻—收益样本，而本章则用这些样本回答全文最关键的问题：&lt;strong&gt;机器到底从中文财经新闻中学到了什么？学到的东西是否真实、可解释、能赚钱？&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;具体来说，这一章有四个作用：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;验证情绪分数的经济含义&lt;/strong&gt;：FarmPredict 输出的不是抽象分数，而是每篇文章对个股的情绪预测。本章先看模型选出的“情绪词”是否有道理，再用面板回归检验情绪分数能否预测对应的个股收益。其目的是证明模型学到的是股票特质信息，而不是市场整体信息或噪声。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;揭示新闻影响市场的动态机制&lt;/strong&gt;：通过事件研究，观察新闻发布前后若干天里股票收益的变化轨迹，说明正面新闻和负面新闻如何不对称地影响 A 股。这一机制解释不是简单证明“有用”，而是说明“为什么有用”。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;评估模型在真实投资中的价值&lt;/strong&gt;：把情绪分数转化为多空组合，在考虑中国股市交易成本、涨跌停限制后报告年化收益和 Sharpe 比率。这回答了“学习结果是否具有可交易的经济价值”，而不仅仅是统计显著性。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;为后续模型比较建立基准&lt;/strong&gt;：这一章确定了组合构建、成本假设、收益分解等统一标准。第 5 节将各种基准模型放在同一套评估体系下比较，其参照系就是本章的 FarmPredict 结果。&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;概言之，这一章从“语义是否合理”“统计是否显著”“机制是否可信”“经济上是否可行”四个层面，系统验证了 FarmPredict 的有效性。&lt;/p&gt;
&lt;h3&gt;本章的关键概念、论证与技术细节&lt;/h3&gt;
&lt;h4&gt;1. 情绪词验证：模型学到了真正的中文财经表达&lt;/h4&gt;
&lt;p&gt;FarmPredict 从残差词中选出对收益有预测力的词，并按回归系数判断正、负情绪强度。图 4 和表 3 展示了排名靠前的正、负面词。&lt;/p&gt;
&lt;p&gt;正面词包括：涨停、走强、涨、抢反弹、拉升、早盘、快讯、预增等。负面词包括：跌停、敢死队、跌、减持、跌幅、大跌、涉嫌、终止等。&lt;/p&gt;
&lt;p&gt;这些词有几个值得注意的特征：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;很多词不是传统情感词典中的通用情绪词，而是中国股市语境中的特定表达。例如“敢死队”在词典中并不是负面词，但在财经新闻中常用来比喻敢于在弱市中追涨或接盘的资金，往往与后续下跌有关。FarmPredict 能从数据中自动学到这类搭配和隐喻。&lt;/li&gt;
&lt;li&gt;正面词更偏向“交易类”信息，如涨停、拉升、抢反弹；负面词中则包含更多“价值类”和“法律类”信息，如减持、涉嫌、终止。这说明中国股市的正面消息更容易通过交易行为传播，与散户占比较高、羊群效应较强的市场结构一致；而负面消息则更多与公司基本面或合规问题相关。&lt;/li&gt;
&lt;li&gt;这种正负不对称与 A 股的卖空限制高度相关。负面信息难以通过做空迅速反映到价格中，因此负面情绪词的预测力更多来自基本面恶化，而不是交易博弈。&lt;/li&gt;
&lt;/ul&gt;
&lt;h4&gt;2. 个股层面：情绪分数显著预测个股收益&lt;/h4&gt;
&lt;p&gt;为了直接检验情绪分数的预测能力，作者构建了如下面板回归：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$Return_{it} = Sentiment_{i,t-1} + Return_{i,t-s} + X_{it} + \mu_t + \epsilon_{it}$&lt;/pre&gt;
&lt;p&gt;其中 &lt;span class=&quot;math&quot;&gt;$Return_{it}$&lt;/span&gt; 是股票 &lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt; 在第 &lt;span class=&quot;math&quot;&gt;$t$&lt;/span&gt; 天的 beta-adjusted return，&lt;span class=&quot;math&quot;&gt;$Sentiment_{i,t-1}$&lt;/span&gt; 是股票 &lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt; 在第 &lt;span class=&quot;math&quot;&gt;$t-1$&lt;/span&gt; 天的情绪分数。模型中逐步加入滞后收益、公司特征、盈利惊喜和时间固定效应。&lt;/p&gt;
&lt;p&gt;表 4 显示，情绪分数前一个交易日对当日 beta-adjusted return 有显著正相关，系数在加入各种控制变量后仍为约 &lt;span class=&quot;math&quot;&gt;$0.193$&lt;/span&gt;，统计上高度显著。这说明情绪分数包含了对个股未来收益的独立预测信息，而不是仅仅重复过去收益或公司特征。&lt;/p&gt;
&lt;h4&gt;3. 市场层面：情绪分数不预测大盘收益&lt;/h4&gt;
&lt;p&gt;作者担心一点：模型是否只是学到了市场整体涨跌的信息，而不是个股特质信息？为此，作者把每天的个股情绪分数取平均，得到市场层面的平均情绪分数 &lt;span class=&quot;math&quot;&gt;$AveSentiment_{t-1}$&lt;/span&gt;，并用 CSI 300 指数收益作为被解释变量进行时间序列回归：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$Return_t = AveSentiment_{t-1} + DISP_{t-1} + Return_{t-s} + Return_{t-l} + X_t + D_{year} + D_{month} + \epsilon_t$&lt;/pre&gt;
&lt;p&gt;表 5 显示，无论是否加入市场估值、利率、滞后收益等控制变量，&lt;span class=&quot;math&quot;&gt;$AveSentiment$&lt;/span&gt; 和 &lt;span class=&quot;math&quot;&gt;$DISP$&lt;/span&gt; 的系数都不显著。这说明 FarmPredict 的情绪分数只与个股特质收益相关，与市场整体收益无关。&lt;/p&gt;
&lt;p&gt;把表 4 和表 5 放在一起看，结论很清楚：&lt;strong&gt;模型学到的是“这只股票发生了什么事”，而不是“整个市场今天怎么样”&lt;/strong&gt;。这与数据章中 &lt;span class=&quot;math&quot;&gt;$Y_i$&lt;/span&gt; 采用 beta-adjusted return 的设计完全一致。&lt;/p&gt;
&lt;h4&gt;4. 事件研究：正面与负面新闻的不对称影响&lt;/h4&gt;
&lt;p&gt;作者把新闻发布看作一个“事件”，以新闻发布日为第 1 天，用事件研究回归：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$Return_{it} = \sum_{p=-13}^{14} \beta_p Day_{ip} + \delta_i + \mu_t + \epsilon_{it}$&lt;/pre&gt;
&lt;p&gt;其中 &lt;span class=&quot;math&quot;&gt;$Day_{ip}$&lt;/span&gt; 是相对事件日第 &lt;span class=&quot;math&quot;&gt;$p$&lt;/span&gt; 天的虚拟变量，&lt;span class=&quot;math&quot;&gt;$\delta_i$&lt;/span&gt; 和 &lt;span class=&quot;math&quot;&gt;$\mu_t$&lt;/span&gt; 分别控制个股和时间固定效应。回归系数 &lt;span class=&quot;math&quot;&gt;$\beta_p$&lt;/span&gt; 表示在事件日前第 &lt;span class=&quot;math&quot;&gt;$p$&lt;/span&gt; 天或事件日后第 &lt;span class=&quot;math&quot;&gt;$p$&lt;/span&gt; 天，股票的平均 beta-adjusted return 相对于基准水平的变化。&lt;/p&gt;
&lt;p&gt;图 5 展示了正面新闻和负面新闻在事件窗口内的收益轨迹，核心发现如下：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;正面新闻&lt;/strong&gt;：股票收益在新闻发布前约 7 天就开始上升，到新闻发布日达到峰值，全样本平均当日收益约为 &lt;span class=&quot;math&quot;&gt;$83$&lt;/span&gt; bps。新闻发布后，正面影响还会持续约 2 天。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;负面新闻&lt;/strong&gt;：新闻发布前没有出现收益提前下降的趋势，发布当日平均下跌约 &lt;span class=&quot;math&quot;&gt;$26$&lt;/span&gt; bps。发布后的负面影响持续约 3 天。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;不对称性&lt;/strong&gt;：正面新闻的影响幅度远大于负面新闻。这与美国市场通常发现的“坏消息影响更大”不同，但与中国市场的卖空约束高度一致。因为个股难以被做空，负面信息即使提前泄露，投资者也很难通过交易获利，因此价格不会提前明显下跌。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这一事件研究提供了一个重要的机制解释：情绪分数之所以能带来投资机会，一方面是因为正面信息存在提前泄露和交易扩散，另一方面是因为负面信息在发布后才开始被价格吸收，且吸收不完全。&lt;/p&gt;
&lt;h4&gt;5. 安慰剂检验：结果不是偶然波动&lt;/h4&gt;
&lt;p&gt;为了排除事件研究的结果是数据挖掘或偶然波动所致，作者进行了安慰剂检验。具体做法是：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;对每只股票随机选取一段不包含真实事件期的连续 28 天；&lt;/li&gt;
&lt;li&gt;把这段随机窗口当作“伪事件期”，重新估计事件研究回归；&lt;/li&gt;
&lt;li&gt;重复 200 次，得到 200 条伪事件收益曲线。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;图 6 显示，这些随机样本的收益曲线围绕零附近波动，均值几乎为零。而图 5 中的真实事件收益曲线明显高出于安慰剂分布之外。这说明原事件研究中的显著收益确实是由新闻事件本身引起的，而不是任何随机窗口都能产生的现象。&lt;/p&gt;
&lt;h4&gt;6. 组合构建：把情绪分数变成交易策略&lt;/h4&gt;
&lt;p&gt;作者按照以下规则构建多空组合：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;每个交易日 &lt;span class=&quot;math&quot;&gt;$t$&lt;/span&gt;，收集从前一交易日收盘（&lt;span class=&quot;math&quot;&gt;$t-1$&lt;/span&gt; 的下午 3 点）到当天收盘（&lt;span class=&quot;math&quot;&gt;$t$&lt;/span&gt; 的下午 3 点）之间发布的所有文章；&lt;/li&gt;
&lt;li&gt;用 FarmPredict 给每篇文章对应的股票打分；&lt;/li&gt;
&lt;li&gt;做多分数最高的 50 只股票，做空分数最低的 50 只股票；&lt;/li&gt;
&lt;li&gt;如果符合条件的股票不足 50 只，剩余资金保持现金，不额外加杠杆；&lt;/li&gt;
&lt;li&gt;在 &lt;span class=&quot;math&quot;&gt;$t$&lt;/span&gt; 日收盘集合竞价时建仓，在 &lt;span class=&quot;math&quot;&gt;$t+1$&lt;/span&gt; 日收盘集合竞价时平仓；&lt;/li&gt;
&lt;li&gt;等权组合（EW）中，每只在多空两侧各占 &lt;span class=&quot;math&quot;&gt;$1\%$&lt;/span&gt; 的总资本；价值加权组合（VW）中，权重与个股前一日总市值成正比。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这个策略的逻辑是：新闻在 &lt;span class=&quot;math&quot;&gt;$t$&lt;/span&gt; 日收盘前已经发布，但价格可能尚未完全反映信息，因此 &lt;span class=&quot;math&quot;&gt;$t$&lt;/span&gt; 日收盘建仓、次日收盘平仓，捕捉新闻发布后的滞后反应。&lt;/p&gt;
&lt;h4&gt;7. 中国市场的交易成本与涨跌停限制&lt;/h4&gt;
&lt;p&gt;中国的交易成本较高，作者将其归纳为三部分，合计约 &lt;span class=&quot;math&quot;&gt;$13$&lt;/span&gt; bps：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;印花税&lt;/strong&gt;：卖出金额的 &lt;span class=&quot;math&quot;&gt;$0.1\%$&lt;/span&gt;，折合 &lt;span class=&quot;math&quot;&gt;$10$&lt;/span&gt; bps；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;过户费&lt;/strong&gt;：每 &lt;span class=&quot;math&quot;&gt;$1,000$&lt;/span&gt; 股约 &lt;span class=&quot;math&quot;&gt;$1$&lt;/span&gt; 元人民币，买卖双方都收取，对典型价格股票约 &lt;span class=&quot;math&quot;&gt;$1$&lt;/span&gt; bps；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;交易佣金&lt;/strong&gt;：每笔交易约 &lt;span class=&quot;math&quot;&gt;$0.01\%$&lt;/span&gt; 至 &lt;span class=&quot;math&quot;&gt;$0.02\%$&lt;/span&gt;，买卖双方都收取，合计约 &lt;span class=&quot;math&quot;&gt;$2$&lt;/span&gt; bps。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这意味着一次“今天买入、明天卖出”的完整换手，平均需要支付约 &lt;span class=&quot;math&quot;&gt;$13$&lt;/span&gt; bps 的成本。对于日频策略而言，这已经是非常高的门槛。&lt;/p&gt;
&lt;p&gt;此外，A 股实行 &lt;span class=&quot;math&quot;&gt;$10\%$&lt;/span&gt; 的日涨跌停限制。当股票到达涨跌停板时，通常很难成交。这会影响组合中恰好触及涨跌停的股票能否按策略成交。由于作者没有高频订单数据，无法精确计算涨跌停对成交的影响，因此采用上下界方式：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;上界&lt;/strong&gt;：假设所有涨跌停股票都能顺利成交；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;下界&lt;/strong&gt;：假设所有涨跌停股票都无法成交。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;真实表现应当落在这两个界之间。这种处理方式在学术上是一种透明的稳健性表述。&lt;/p&gt;
&lt;h4&gt;8. 组合表现：多空策略在经济上可行&lt;/h4&gt;
&lt;p&gt;表 6 报告了 FarmPredict 组合 2015—2019 年的业绩。以等权多空组合为例：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;在不考虑交易成本和涨跌停限制的理想情况下，年化收益率（APR）可达 &lt;span class=&quot;math&quot;&gt;$105.16\%$&lt;/span&gt;，Sharpe 比率为 &lt;span class=&quot;math&quot;&gt;$8.51$&lt;/span&gt;；&lt;/li&gt;
&lt;li&gt;扣除交易成本后，年化收益率降至 &lt;span class=&quot;math&quot;&gt;$54.35\%$&lt;/span&gt;，Sharpe 比率为 &lt;span class=&quot;math&quot;&gt;$5.32$&lt;/span&gt;；&lt;/li&gt;
&lt;li&gt;再考虑涨跌停下界后，年化收益率降为 &lt;span class=&quot;math&quot;&gt;$4.30\%$&lt;/span&gt;，Sharpe 比率为 &lt;span class=&quot;math&quot;&gt;$0.21$&lt;/span&gt;。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这说明交易成本会显著侵蚀收益，但即便在最悲观假设下，组合仍保持正收益。涨跌停的影响更大，因为策略捕捉到的强信号股票往往也更容易触及涨跌停，这些股票无法成交时，策略会失去很大一部分利润。&lt;/p&gt;
&lt;p&gt;价值加权组合的表现明显弱于等权组合：扣除成本和涨跌停下界后，年化收益率为 &lt;span class=&quot;math&quot;&gt;$-14.11\%$&lt;/span&gt;。这意味着大市值股票对新闻的反应较小，新闻情绪主要在小市值股票中产生超额收益，这与大市值股票信息效率更高、套利者更多的常识一致。&lt;/p&gt;
&lt;h4&gt;9. 收益分解：组合主要赚的是 alpha，不是市场风险&lt;/h4&gt;
&lt;p&gt;为了弄清组合收益是来自承担系统性风险还是真正的选股能力，作者使用 Carhart 四因子模型：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$R_{p,t} - R_f = \alpha + \beta_1 MKT_t + \beta_2 SMB_t + \beta_3 HML_t + \beta_4 MOM_t + \epsilon_{it}$&lt;/pre&gt;
&lt;p&gt;其中 &lt;span class=&quot;math&quot;&gt;$MKT$&lt;/span&gt; 是市场因子，&lt;span class=&quot;math&quot;&gt;$SMB$&lt;/span&gt; 是规模因子，&lt;span class=&quot;math&quot;&gt;$HML$&lt;/span&gt; 是价值因子，&lt;span class=&quot;math&quot;&gt;$MOM$&lt;/span&gt; 是动量因子。回归截距 &lt;span class=&quot;math&quot;&gt;$\alpha$&lt;/span&gt; 表示剔除这些常见风险暴露后的超额收益。&lt;/p&gt;
&lt;p&gt;表 7 显示，等权多空组合的 alpha 年化约为 &lt;span class=&quot;math&quot;&gt;$51.06\%$&lt;/span&gt;，与原始收益 &lt;span class=&quot;math&quot;&gt;$54.35\%$&lt;/span&gt; 非常接近。为了量化市场风险暴露占比，作者定义了：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$R^2_{factor} = \frac{\sum_t (\beta_1 MKT_t + \beta_2 SMB_t + \beta_3 HML_t + \beta_4 MOM_t + R_f)^2}{\sum_t [R_{p,t} - \bar{R}_{p,t}]^2}$&lt;/pre&gt;
&lt;p&gt;等权多空组合的 &lt;span class=&quot;math&quot;&gt;$R^2_{factor}$&lt;/span&gt; 只有 &lt;span class=&quot;math&quot;&gt;$6.92\%$&lt;/span&gt;。这说明组合收益中只有约 &lt;span class=&quot;math&quot;&gt;$7\%$&lt;/span&gt; 的波动来自常见风险因子，其余大部分来自模型选股能力。多头和空头各自的市场暴露较大，但多空对冲后市场风险被大幅抵消。图 8 也显示，原始收益曲线和因子调整后收益曲线几乎重合，进一步证明组合几乎是市场中性策略。&lt;/p&gt;
&lt;h4&gt;10. 情绪词、事件研究和组合表现的内在一致&lt;/h4&gt;
&lt;p&gt;这一章的各部分不是孤立的，它们共同构成一个逻辑链：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;情绪词表明模型捕捉到中国股市独特的交易文化；&lt;/li&gt;
&lt;li&gt;面板回归表明情绪分数能预测个股收益；&lt;/li&gt;
&lt;li&gt;市场回归表明模型没有混入市场噪声；&lt;/li&gt;
&lt;li&gt;事件研究揭示了正面和负面新闻的不同传导机制；&lt;/li&gt;
&lt;li&gt;安慰剂检验排除了偶然性；&lt;/li&gt;
&lt;li&gt;组合表现证明这种预测能力可以转化为正的交易利润；&lt;/li&gt;
&lt;li&gt;因子分解证明利润主要来自 alpha，而不是市场风格暴露。&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;这条链完整回答了“机器学到了什么、为什么能赚钱”的问题。&lt;/p&gt;
&lt;h3&gt;理解后续章节必须掌握的内容&lt;/h3&gt;
&lt;p&gt;要理解第 5 节模型比较和第 6 节结论，读者必须掌握以下内容：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;组合评估标准&lt;/strong&gt;：后续所有基准模型都使用相同的组合构建方法，即做多 Top 50、做空 Bottom 50、等权或市值加权、持有一天。比较的指标是同一口径下的年化收益率、Sharpe 比率和每日收益差值。因此，本章的 FarmPredict 结果是后文的比较基准。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;交易成本假设&lt;/strong&gt;：所有模型在比较时默认承担 &lt;span class=&quot;math&quot;&gt;$13$&lt;/span&gt; bps 的买卖交易成本。如果读者看到第 5 节中某个模型收益为负，需要意识到这个负值是扣除高成本后的结果，不是模型本身完全没有预测力。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;涨跌停上下界&lt;/strong&gt;：本章提供了上界和下界两种收益口径。第 5 节模型比较中也常常同时展示“有涨跌停限制”和“无涨跌停限制”的结果。理解上下界的含义，才能正确解释不同模型在涨跌停极端假设下的表现差异。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;正负新闻不对称机制&lt;/strong&gt;：事件研究中正面新闻约 &lt;span class=&quot;math&quot;&gt;$83$&lt;/span&gt; bps、负面新闻约 &lt;span class=&quot;math&quot;&gt;$26$&lt;/span&gt; bps，以及正面信息提前反应、负面信息不提前反应的结果，是解释为什么多空组合的多头贡献远大于空头、为什么空头腿在价值加权组合中甚至为负的关键背景。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;收益主要来自 alpha&lt;/strong&gt;：等权多空组合的 &lt;span class=&quot;math&quot;&gt;$R^2_{factor}$&lt;/span&gt; 约 &lt;span class=&quot;math&quot;&gt;$6.92\%$&lt;/span&gt;，说明策略接近市场中性。后续比较其他模型时，读者应关注其收益是否同样来自 alpha，还是仅仅暴露了某些市场风格因子。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;情绪分数从 t-1 日预测 t 日收益&lt;/strong&gt;：面板回归中使用滞后情绪分数，而事件研究中使用当日新闻。两者并不矛盾：情绪分数既有提前预测能力，也有当日事件冲击效应。理解这一点有助于解释第 5 节中模型比较时为何既看回归 &lt;span class=&quot;math&quot;&gt;$R^2$&lt;/span&gt;，也看组合收益。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;等权与价值加权的差异&lt;/strong&gt;：FarmPredict 在等权组合中表现优异，但在价值加权组合中表现大幅下降，说明新闻情绪主要影响小市值股票。后续比较其他模型时，通常以等权组合为主，但价值加权组合的差异也是评价模型稳健性的重要维度。&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;h3&gt;公式、实验设置与定义通俗解释&lt;/h3&gt;
&lt;h4&gt;公式通俗解释&lt;/h4&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;事件研究回归&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$Return_{it} = \sum_{p=-13}^{14} \beta_p Day_{ip} + \delta_i + \mu_t + \epsilon_{it}$&lt;/pre&gt;
&lt;p&gt;  可以把 &lt;span class=&quot;math&quot;&gt;$\beta_p$&lt;/span&gt; 理解为：在新闻发布前 13 天到发布后 14 天的每一天，股票平均比正常情况多涨或少涨多少。&lt;span class=&quot;math&quot;&gt;$p=1$&lt;/span&gt; 是新闻发布当天。&lt;span class=&quot;math&quot;&gt;$\delta_i$&lt;/span&gt; 和 &lt;span class=&quot;math&quot;&gt;$\mu_t$&lt;/span&gt; 分别扣除了每只股票长期平均水平和每天市场整体的共同波动，所以剩下的 &lt;span class=&quot;math&quot;&gt;$\beta_p$&lt;/span&gt; 更接近新闻带来的“净效应”。例如，若正面新闻的 &lt;span class=&quot;math&quot;&gt;$\beta_1 = 0.83\%$&lt;/span&gt;，就表示新闻发布当天，这些股票平均比正常水平多涨了 &lt;span class=&quot;math&quot;&gt;$83$&lt;/span&gt; bps。&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Carhart 四因子模型&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$R_{p,t} - R_f = \alpha + \beta_1 MKT_t + \beta_2 SMB_t + \beta_3 HML_t + \beta_4 MOM_t + \epsilon_{it}$&lt;/pre&gt;
&lt;p&gt;  这个模型把组合收益拆成两部分：一部分是承担市场风险、规模风险、价值风险、动量风险所获得的补偿；另一部分是剔除这些风险后仍然剩下的收益，即 &lt;span class=&quot;math&quot;&gt;$\alpha$&lt;/span&gt;。可以通俗理解为：如果一只基金涨了 &lt;span class=&quot;math&quot;&gt;$20\%$&lt;/span&gt;，但其中 &lt;span class=&quot;math&quot;&gt;$18\%$&lt;/span&gt; 是因为大盘涨了，那么它的 &lt;span class=&quot;math&quot;&gt;$\alpha$&lt;/span&gt; 只有 &lt;span class=&quot;math&quot;&gt;$2\%$&lt;/span&gt;。本章中 &lt;span class=&quot;math&quot;&gt;$R_{p,t} - R_f$&lt;/span&gt; 的 &lt;span class=&quot;math&quot;&gt;$\alpha$&lt;/span&gt; 很大，说明 FarmPredict 组合赚的不是“风口上的钱”，而是真正的选股钱。&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;&lt;span class=&quot;math&quot;&gt;$R^2_{factor}$&lt;/span&gt;&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$R^2_{factor} = \frac{\sum_t (\beta_1 MKT_t + \beta_2 SMB_t + \beta_3 HML_t + \beta_4 MOM_t + R_f)^2}{\sum_t [R_{p,t} - \bar{R}_{p,t}]^2}$&lt;/pre&gt;
&lt;p&gt;  这个指标衡量：组合收益波动中，有多大比例可以被四个风险因子解释。数值越接近 &lt;span class=&quot;math&quot;&gt;$1$&lt;/span&gt;，说明组合越像普通的风格暴露组合；越接近 &lt;span class=&quot;math&quot;&gt;$0$&lt;/span&gt;，说明组合越接近市场中性，收益更多来自因子无法解释的部分。FarmPredict 等权多空组合的 &lt;span class=&quot;math&quot;&gt;$R^2_{factor}$&lt;/span&gt; 只有 &lt;span class=&quot;math&quot;&gt;$6.92\%$&lt;/span&gt;，说明它和传统风险因子的关系很弱。&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;换手率公式&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$Average \; Turnover \; Ratio := \frac{1}{2(T-1)} \sum_{t=1}^{T-1} \| w_t - w_{t+1} \|_1$&lt;/pre&gt;
&lt;p&gt;  其中 &lt;span class=&quot;math&quot;&gt;$\| w_t - w_{t+1} \|_1$&lt;/span&gt; 表示两天投资组合权重变化的总绝对值。如果组合完全不变，这个值为 &lt;span class=&quot;math&quot;&gt;$0$&lt;/span&gt;；如果全部股票都变了，这个值最大为 &lt;span class=&quot;math&quot;&gt;$2$&lt;/span&gt;。除以 &lt;span class=&quot;math&quot;&gt;$2$&lt;/span&gt; 后，换手率可以理解为“每天平均有百分之多少的组合被替换”。换手率越高，交易成本越大。本节用这个公式计算实际交易费用，而不是假设每天全部换手。&lt;/p&gt;
&lt;h4&gt;关键实验设置通俗解释&lt;/h4&gt;
&lt;ul&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;新闻窗口&lt;/strong&gt;：组合在交易日的收盘前收集过去约 24 小时内的所有新闻。例如，周二下午 3 点建仓时，使用周一 3 点到周二 3 点之间发布的新闻。这样保证信息在决策时已经公开，不存在未来信息。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;做多与做空&lt;/strong&gt;：做多 50 只股票，是指买入这 50 只股票，期望它们上涨；做空 50 只股票，是指卖出这 50 只股票，期望它们下跌。在等权组合中，每只股票占 &lt;span class=&quot;math&quot;&gt;$1\%$&lt;/span&gt;，所以多空各占 &lt;span class=&quot;math&quot;&gt;$50\%$&lt;/span&gt; 的资本，合计 &lt;span class=&quot;math&quot;&gt;$100\%$&lt;/span&gt;。如果没有足够符合条件的股票，剩余资金保留为现金，不额外加杠杆。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;持有期一天&lt;/strong&gt;：在新闻发生后的第一个交易日收盘建仓，第二个交易日收盘平仓。这样交易节奏最快，最能反映新闻的短期冲击，但受交易成本影响也最大。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;涨跌停上下界&lt;/strong&gt;：上界假设“即使涨停或跌停的股票也能正常买卖”，这是最乐观的情况；下界假设“涨跌停板上的股票完全无法买卖”，这是最悲观的情况。真实情景介于两者之间，取决于涨跌停板上实际成交的数量。这样报告结果既透明又保守。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;安慰剂检验&lt;/strong&gt;：在每只股票的历史中随机截取一个不包含新闻事件的 28 天窗口，当作“假事件期”，重复 200 次。如果这些随机窗口也能产生和真实事件期一样大的收益，那么原结果就不可信；如果随机窗口平均收益为零，则说明原结果是新闻事件引起的。这是检验“结果是不是碰巧”的常用方法。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;市场中性解释&lt;/strong&gt;：多空组合同时买入和卖空股票，两者对市场涨跌的方向相反。当市场上涨时，多头赚钱、空头亏钱；市场下跌时，多头亏钱、空头赚钱。因此，多空组合抵消了市场整体的影响，只剩多空两腿相对强弱带来的收益。这就是为什么组合的 &lt;span class=&quot;math&quot;&gt;$R^2_{factor}$&lt;/span&gt; 很低、alpha 占主导。&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;总之，结果章通过多个相互印证的实验，证明 FarmPredict 从中文财经新闻中学到了真实、可解释且具有经济价值的个股情绪信息。它为后续模型比较提供了基准，也为全文结论提供了最核心的实证支撑。&lt;/p&gt;

&lt;!-- zab:slot:chapter_ch4:end --&gt;
&lt;hr/&gt;
&lt;!-- zab:slot:chapter_ch5:done --&gt;
&lt;h2&gt;模型讨论与比较&lt;/h2&gt;
&lt;h3&gt;本章作用&lt;/h3&gt;
&lt;p&gt;“模型讨论与比较”这一章在全文中承担的是“从有效性验证走向方法优势解释”的桥梁作用。结果章已经证明 FarmPredict 能从中文财经新闻中提取出具有经济价值的情绪信号，但还没有说明：这个优势究竟来自 FarmPredict 的哪个设计？它相对已有模型是否真的更好？好多少？&lt;/p&gt;
&lt;p&gt;具体而言，本章有四个作用：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;拆解 FarmPredict 的内部机制&lt;/strong&gt;：FarmPredict 的核心创新在于同时使用“因子”和“特质残差”进行预测。本章通过只使用因子、只使用残差、同时使用两者三种设定，量化各部分对预测和组合收益的贡献，验证“因子增强预测”这一设计不是可有可无的。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;解释因子内容的可读性&lt;/strong&gt;：通过展示九个因子的词云，说明 FarmPredict 从文本中无监督提取出的因子可以对应到公司、经济、基金、治理、IPO、盈利、激励、重组等主题。这增强了模型的可解释性，同时也解释了为什么单纯提取主题因子不足以预测收益。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;建立统一的模型比较基准&lt;/strong&gt;：本章以“等权组合、扣除交易成本、不考虑涨跌停限制”为统一口径，将 FarmPredict 与词选择模型、词聚类模型、动量策略和深度学习模型放在同一体系下比较，回答“FarmPredict 是否显著优于现有方法”。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;为结论章提供直接证据&lt;/strong&gt;：结论章将总结 FarmPredict 的方法价值与实证表现。本章的比较结果，尤其是表 9 的汇总，构成结论中“FarmPredict 在预测精度和组合表现上均优于其他模型”这一判断的实证依据。&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;概言之，这一章从“内部贡献来自哪里”“因子是什么意思”“相比传统模型和前沿模型是否更好”三个层面，解释了 FarmPredict 的优势来源与边界。&lt;/p&gt;
&lt;h3&gt;关键概念、论证与技术细节&lt;/h3&gt;
&lt;h4&gt;1. 因子与残差的贡献拆解&lt;/h4&gt;
&lt;p&gt;FarmPredict 的预测模型可以简单理解为：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$Y_i \approx \alpha + \beta^{\top} f_i + \gamma^{\top} u_i$&lt;/pre&gt;
&lt;p&gt;其中 &lt;span class=&quot;math&quot;&gt;$f_i$&lt;/span&gt; 是从全部词频中提取的少数几个隐藏因子，&lt;span class=&quot;math&quot;&gt;$u_i$&lt;/span&gt; 是每个词去除因子影响后的特质残差。本章的关键问题是：预测能力主要来自 &lt;span class=&quot;math&quot;&gt;$f_i$&lt;/span&gt; 还是 &lt;span class=&quot;math&quot;&gt;$u_i$&lt;/span&gt;？&lt;/p&gt;
&lt;p&gt;作者用三种设定进行对比：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;完整模型&lt;/strong&gt;：同时使用因子和残差；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;仅因子模型&lt;/strong&gt;：只用隐藏因子 &lt;span class=&quot;math&quot;&gt;$f_i$&lt;/span&gt;；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;仅残差模型&lt;/strong&gt;：只用特质残差 &lt;span class=&quot;math&quot;&gt;$u_i$&lt;/span&gt;。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;结果非常清晰。在测试集上，完整模型的 &lt;span class=&quot;math&quot;&gt;$R^2$&lt;/span&gt; 为 &lt;span class=&quot;math&quot;&gt;$4.21\%$&lt;/span&gt;，每日收益为 &lt;span class=&quot;math&quot;&gt;$17.8$&lt;/span&gt; bps；仅因子模型的 &lt;span class=&quot;math&quot;&gt;$R^2$&lt;/span&gt; 为 &lt;span class=&quot;math&quot;&gt;$-0.12\%$&lt;/span&gt;，每日收益为 &lt;span class=&quot;math&quot;&gt;$-8.2$&lt;/span&gt; bps，与完整模型相差 &lt;span class=&quot;math&quot;&gt;$26$&lt;/span&gt; bps；仅残差模型的 &lt;span class=&quot;math&quot;&gt;$R^2$&lt;/span&gt; 为 &lt;span class=&quot;math&quot;&gt;$4.21\%$&lt;/span&gt;，每日收益为 &lt;span class=&quot;math&quot;&gt;$16.4$&lt;/span&gt; bps，与完整模型相差 &lt;span class=&quot;math&quot;&gt;$1$&lt;/span&gt; bps。&lt;/p&gt;
&lt;p&gt;这说明：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;在本文的中文财经新闻数据中，&lt;strong&gt;残差部分贡献了绝大部分预测力&lt;/strong&gt;，因为残差中保留了具体的情绪词信息，如“涨停”“减持”“涉嫌”等；&lt;/li&gt;
&lt;li&gt;仅使用因子几乎没有任何预测力，甚至为负；&lt;/li&gt;
&lt;li&gt;但完整模型仍比仅残差模型略好，每日收益高出约 &lt;span class=&quot;math&quot;&gt;$1$&lt;/span&gt; bps，说明因子增强并非完全冗余。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;更重要的是，作者进一步把 FarmPredict 与朴素 LASSO 比较。LASSO 直接用原始词频 &lt;span class=&quot;math&quot;&gt;$X$&lt;/span&gt; 进行惩罚回归，相当于只做词选择，没有因子增强。结果显示，FarmPredict 的 &lt;span class=&quot;math&quot;&gt;$R^2$&lt;/span&gt; 从 LASSO 的 &lt;span class=&quot;math&quot;&gt;$3.99\%$&lt;/span&gt; 提高到 &lt;span class=&quot;math&quot;&gt;$4.21\%$&lt;/span&gt;，而组合年化收益提高了 &lt;span class=&quot;math&quot;&gt;$37.4\%$&lt;/span&gt;。这证明 FarmPredict &lt;strong&gt;没有坍缩为普通 LASSO&lt;/strong&gt;，因子增强在投资组合层面带来了显著改善。&lt;/p&gt;
&lt;h4&gt;2. 因子内容的可解释性&lt;/h4&gt;
&lt;p&gt;作者通过因子载荷矩阵 &lt;span class=&quot;math&quot;&gt;$B$&lt;/span&gt; 展示九个因子的词云。去除虚词后，这些因子可以大致标记为：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;公司；&lt;/li&gt;
&lt;li&gt;中国经济；&lt;/li&gt;
&lt;li&gt;基金；&lt;/li&gt;
&lt;li&gt;公司治理；&lt;/li&gt;
&lt;li&gt;IPO；&lt;/li&gt;
&lt;li&gt;盈利；&lt;/li&gt;
&lt;li&gt;激励；&lt;/li&gt;
&lt;li&gt;重组；&lt;/li&gt;
&lt;li&gt;其他。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这些主题大多比较中性，单独提取出来并不能很好预测个股收益。这与上一节的结果一致：仅因子模型的预测力很弱。FarmPredict 的真正机制在于：模型并不依赖少数强主题，而是&lt;strong&gt;在相对较弱的主题因子基础上，重点关注带有情绪信息的残差词&lt;/strong&gt;。因此，因子提供的更多是一种文档背景和词间相关性结构，而不是直接的涨跌信号。&lt;/p&gt;
&lt;h4&gt;3. 与词选择模型的比较&lt;/h4&gt;
&lt;p&gt;词选择模型的核心思路是从大量词汇中挑出与收益相关的词，然后据此打分。本章比较了两个代表性模型。&lt;/p&gt;
&lt;h5&gt;3.1 MNIR&lt;/h5&gt;
&lt;p&gt;MNIR（多项逆回归）由 Taddy（2013）提出，将文本—收益关系转化为多项逆回归问题，并使用 Gamma-Lasso 进行高维稀疏估计。作者使用 R 包实现，并按照与 FarmPredict 相同的滚动窗口调参。&lt;/p&gt;
&lt;p&gt;投资组合比较显示，FarmPredict 在扣除交易成本后的累计收益明显高于 MNIR。这说明仅仅进行词选择而不引入因子增强，不足以充分利用文本信息。&lt;/p&gt;
&lt;h5&gt;3.2 SESTM&lt;/h5&gt;
&lt;p&gt;SESTM（监督情绪主题模型）由 Ke 等（2019）提出。它假设每篇文章是正面主题和负面主题的混合，并用概率 &lt;span class=&quot;math&quot;&gt;$p_i$&lt;/span&gt; 表示文章正面情绪强度。其核心设定为：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$d_{i,S} \sim \text{Multinomial}\big(s_i,\ p_i u^{+} + (1-p_i) u^{-}\big)$&lt;/pre&gt;
&lt;p&gt;其中 &lt;span class=&quot;math&quot;&gt;$d_{i,S}$&lt;/span&gt; 是文章 &lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt; 中情绪词出现次数的向量，&lt;span class=&quot;math&quot;&gt;$s_i$&lt;/span&gt; 是情绪词总数，&lt;span class=&quot;math&quot;&gt;$u^{+}$&lt;/span&gt; 和 &lt;span class=&quot;math&quot;&gt;$u^{-}$&lt;/span&gt; 分别表示纯正面文章和纯负面文章中各情绪词的出现概率。SESTM 先筛选情绪词，再学习 &lt;span class=&quot;math&quot;&gt;$u^{+}$&lt;/span&gt; 和 &lt;span class=&quot;math&quot;&gt;$u^{-}$&lt;/span&gt;，最后对新文章估计 &lt;span class=&quot;math&quot;&gt;$p_i$&lt;/span&gt; 作为情绪得分。&lt;/p&gt;
&lt;p&gt;比较结果显示，SESTM 是所有基线模型中表现最接近 FarmPredict 的，但仍略逊一筹。SESTM 的累计收益与 FarmPredict 有可见差距，表 9 中与 FarmPredict 的每日收益差异为 &lt;span class=&quot;math&quot;&gt;$1.2$&lt;/span&gt; bps。这说明 SESTM 的监督主题结构虽然有效，但不如 FarmPredict 同时兼顾因子和残差来得完整。&lt;/p&gt;
&lt;h4&gt;4. 与词聚类模型的比较&lt;/h4&gt;
&lt;p&gt;词聚类模型不直接选择单个词，而是将语义相近的词聚成主题，再用主题进行预测。本章使用的是 Cong 等（2019）的文本因子模型：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;使用预训练 word2vec 将词映射为向量；&lt;/li&gt;
&lt;li&gt;用快速层次聚类将词分成因子或主题；&lt;/li&gt;
&lt;li&gt;计算每个文档的因子载荷和因子重要性；&lt;/li&gt;
&lt;li&gt;之后用 LASSO 等方法进行预测。&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;由于论文处理的是中文文本，作者使用中文金融语料预训练的 word2vec，而不是 Google 英文模型。实现中分别用 SVD 和频率计数两种方式计算因子重要性。&lt;/p&gt;
&lt;p&gt;比较显示，FarmPredict 明显优于频率计数版文本因子模型；SVD 版文本因子模型表现接近，但仍低于 FarmPredict。这进一步支持了 FarmPredict 的“双鲁棒”特性：它不单独依赖聚类或词选择，而是让模型自动在两者之间平衡。&lt;/p&gt;
&lt;h4&gt;5. 与传统动量策略的比较&lt;/h4&gt;
&lt;p&gt;为了排除“新闻情绪只是过去收益的代理”这一替代解释，作者比较了基于过去收益排序的动量策略。具体做法是分别用过去 1 天、2 天、3 天、1 周、1 个月、3 个月的累计收益构建等权多空组合，并按照与前文相同的交易成本假设计算收益。&lt;/p&gt;
&lt;p&gt;结果显示，在中国股票市场，这些动量策略在扣除交易成本后几乎全部为负收益，与 FarmPredict 形成鲜明对比。这说明 FarmPredict 捕捉到的不是简单的价格趋势，而是新闻文本中的增量信息。&lt;/p&gt;
&lt;h4&gt;6. 与深度学习模型的比较&lt;/h4&gt;
&lt;p&gt;作者还实现了几种前沿深度学习模型，以验证 FarmPredict 在同等数据上的相对表现。&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;BERT&lt;/strong&gt;：使用中文预训练 BERT，12 层 Transformer，768 个隐藏单元，12 个自注意力头。之后分别接 OLS、BiRNN 或 TextCNN 预测层，并加入 dropout 防止过拟合。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;BiRNN&lt;/strong&gt;：包含一个固定嵌入层、两层双向 LSTM（每层 100 个隐藏节点）和一个全连接层。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;TextCNN&lt;/strong&gt;：使用一维卷积层，卷积核大小分别为 3、4、5，然后进行最大时间池化，最后接全连接层输出收益预测。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;从组合累计收益曲线看，BERT、BiRNN、TextCNN 三者趋势接近，但均低于 FarmPredict。这说明在本文的中文财经新闻预测任务中，FarmPredict 虽然结构简单，却在样本外预测和投资组合层面优于这些复杂深度模型。&lt;/p&gt;
&lt;h4&gt;7. 统一比较基准与汇总&lt;/h4&gt;
&lt;p&gt;本章所有模型比较都遵循一个明确基准：&lt;strong&gt;等权组合、扣除交易成本、不考虑涨跌停限制&lt;/strong&gt;。这样可以公平地比较不同模型的选股能力，而不受涨跌停等极端假设的干扰。&lt;/p&gt;
&lt;p&gt;表 9 汇总了所有模型的样本外 &lt;span class=&quot;math&quot;&gt;$R^2$&lt;/span&gt; 和每日收益。总体上，FarmPredict 在预测精度和组合收益两个维度上均优于所有基线模型。其中 SESTM 表现最接近，但每日收益仍低约 &lt;span class=&quot;math&quot;&gt;$1.2$&lt;/span&gt; bps，其他模型差距更大。&lt;/p&gt;
&lt;h3&gt;理解后续章节必须掌握的内容&lt;/h3&gt;
&lt;p&gt;要理解第 6 节结论以及全文总结，读者必须掌握以下几点：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;FarmPredict 的优势来源是“因子增强 + 残差选择”&lt;/strong&gt;。仅残差模型虽然已经很接近完整模型，但完整模型在组合收益上仍更高。仅因子模型几乎无效，说明本文数据中情绪信息主要在残差词中，而因子主要负责提供文档背景和词间相关性结构。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;FarmPredict 没有退化为普通 LASSO&lt;/strong&gt;。LASSO 只做词选择，FarmPredict 的 &lt;span class=&quot;math&quot;&gt;$R^2$&lt;/span&gt; 和年化收益均显著更高。这是后续总结“方法创新具有实际价值”的关键证据。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;因子是可解释的弱主题&lt;/strong&gt;。九个因子大致对应公司、经济、基金、治理、IPO 等主题，但它们本身中性，预测力弱。这说明 FarmPredict 的机制不是依赖强主题，而是依赖残差中的情绪词与弱主题的结合。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;比较基准统一为等权、扣除交易成本、无涨跌停限制&lt;/strong&gt;。后续看到任何模型比较结果，都应意识到这是同一口径下的差异，不是不同成本假设造成的。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;FarmPredict 优于所有基线模型，但 SESTM 最接近&lt;/strong&gt;。这表示监督主题模型是一个强基准，但 FarmPredict 的双鲁棒设计仍能带来额外收益。读者在理解结论时，不应简单认为“深度学习模型一定更好”；在本任务中，BERT、BiRNN、TextCNN 均不如 FarmPredict。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;动量策略在中国市场无效&lt;/strong&gt;。这说明新闻文本信息具有独立于价格趋势的增量预测能力，不是动量代理。这是支持文本数据价值的直接证据。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;各模型差异以 bps 和 &lt;span class=&quot;math&quot;&gt;$R^2$&lt;/span&gt; 衡量&lt;/strong&gt;。&lt;span class=&quot;math&quot;&gt;$1$&lt;/span&gt; bps 等于 &lt;span class=&quot;math&quot;&gt;$0.01\%$&lt;/span&gt;，每日收益差异看似小，但年化后会放大。例如每日多 &lt;span class=&quot;math&quot;&gt;$1.2$&lt;/span&gt; bps，年化差距可能达到若干个百分点。理解这一点有助于正确解读表 9 中看似不大的数字。&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;h3&gt;公式、实验设置与定义通俗解释&lt;/h3&gt;
&lt;h4&gt;公式通俗解释&lt;/h4&gt;
&lt;h5&gt;1. 预测模型&lt;/h5&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$Y_i \approx \alpha + \beta^{\top} f_i + \gamma^{\top} u_i$&lt;/pre&gt;
&lt;p&gt;可以把 &lt;span class=&quot;math&quot;&gt;$f_i$&lt;/span&gt; 理解为文章“大方向”上的主题成分，比如这篇文章主要在讲公司治理，那篇文章主要在讲盈利。把 &lt;span class=&quot;math&quot;&gt;$u_i$&lt;/span&gt; 理解为剩下的“具体词”带来的信息，比如“涨停”“减持”“涉嫌”这些有情绪指向的词。完整模型同时使用两者：既考虑文章题材，又考虑具体用词。仅因子模型只问“题材是什么”，但不知道具体是好消息还是坏消息；仅残差模型只问“用了哪些情绪词”，但不考虑文章整体背景。实证结果表明，具体词信息更重要，但加上题材背景后还能略微提升。&lt;/p&gt;
&lt;h5&gt;2. SESTM 的多项分布&lt;/h5&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$d_{i,S} \sim \text{Multinomial}\big(s_i,\ p_i u^{+} + (1-p_i) u^{-}\big)$&lt;/pre&gt;
&lt;p&gt;通俗地说，每篇文章可以看成由两类词汇混合而成：一类是正面文章常用的词，另一类是负面文章常用的词。&lt;span class=&quot;math&quot;&gt;$u^{+}$&lt;/span&gt; 告诉我们“纯正面文章里每个词出现的概率”，&lt;span class=&quot;math&quot;&gt;$u^{-}$&lt;/span&gt; 告诉我们“纯负面文章里每个词出现的概率”。文章实际的情绪强度是 &lt;span class=&quot;math&quot;&gt;$p_i$&lt;/span&gt;，当 &lt;span class=&quot;math&quot;&gt;$p_i=1$&lt;/span&gt; 时完全正面，&lt;span class=&quot;math&quot;&gt;$p_i=0$&lt;/span&gt; 时完全负面。SESTM 通过训练数据学习哪些词是情绪词、&lt;span class=&quot;math&quot;&gt;$u^{+}$&lt;/span&gt; 和 &lt;span class=&quot;math&quot;&gt;$u^{-}$&lt;/span&gt; 分别是什么，然后对新的文章估计它的 &lt;span class=&quot;math&quot;&gt;$p_i$&lt;/span&gt; 作为情绪分数。这个模型假设文章的情绪主要来自少数情绪词的频率分布，而没有显式考虑 FarmPredict 中的因子背景。&lt;/p&gt;
&lt;h4&gt;关键实验设置通俗解释&lt;/h4&gt;
&lt;ul&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;统一比较基准&lt;/strong&gt;：所有模型比较都使用等权组合，每只入选股票占 &lt;span class=&quot;math&quot;&gt;$1\%$&lt;/span&gt; 资金，做多 Top 50、做空 Bottom 50，持有约一天，扣除约 &lt;span class=&quot;math&quot;&gt;$13$&lt;/span&gt; bps 的交易成本，但暂不考虑涨跌停限制。这样比较的是模型选股能力本身，而不是不同成本或成交假设。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;样本外 &lt;span class=&quot;math&quot;&gt;$R^2$&lt;/span&gt;&lt;/strong&gt;：在测试集上计算模型预测值与真实收益之间的拟合优度。&lt;span class=&quot;math&quot;&gt;$R^2$&lt;/span&gt; 表示模型解释了收益波动中多大比例。日频股票收益的 &lt;span class=&quot;math&quot;&gt;$R^2$&lt;/span&gt; 通常很小，&lt;span class=&quot;math&quot;&gt;$4.21\%$&lt;/span&gt; 已经相当不错，因为个股日收益噪声极大。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;每日收益与 bps&lt;/strong&gt;：每日收益指投资组合平均每天赚多少钱。&lt;span class=&quot;math&quot;&gt;$1$&lt;/span&gt; bps 是 &lt;span class=&quot;math&quot;&gt;$0.01\%$&lt;/span&gt;。例如每日多 &lt;span class=&quot;math&quot;&gt;$1$&lt;/span&gt; bps，一年约 &lt;span class=&quot;math&quot;&gt;$250$&lt;/span&gt; 个交易日，简单年化可多 &lt;span class=&quot;math&quot;&gt;$2.5\%$&lt;/span&gt; 左右。所以表 9 中“相差 1.2 bps”看似微小，但年化后不是可忽略的数字。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;累计 log2 收益&lt;/strong&gt;：图中纵轴使用对数刻度，&lt;span class=&quot;math&quot;&gt;$0$&lt;/span&gt; 表示本金未变，&lt;span class=&quot;math&quot;&gt;$1$&lt;/span&gt; 表示资金翻倍，&lt;span class=&quot;math&quot;&gt;$2$&lt;/span&gt; 表示翻两番， &lt;span class=&quot;math&quot;&gt;$-1$&lt;/span&gt; 表示亏掉一半。这种画法便于观察长期复利差异。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;因子词云&lt;/strong&gt;：把每个因子中权重最高的词按大小显示，词越大表示在该因子中越重要。它帮助研究者快速判断因子大致主题，但不代表这些主题本身能预测涨跌。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;Gamma-Lasso&lt;/strong&gt;：MNIR 中的一种稀疏惩罚回归方法，与普通 LASSO 类似，但在惩罚项上做了调整，更适合高维文本数据。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;word2vec&lt;/strong&gt;：一种把词变成向量的方法，语义相近的词向量距离较近。使用金融语料预训练后，能更好地刻画中文财经文本中的语义关系。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;TextCNN&lt;/strong&gt;：用多个一维卷积核扫描词向量序列，提取局部短语特征，再做池化，适合捕捉“涨停”“拉升”等局部搭配。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;BiRNN&lt;/strong&gt;：双向循环神经网络，同时从前往后和从后往前读取文章，可以结合上下文信息预测收益。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;BERT&lt;/strong&gt;：预训练语言模型，能够给出每个词在具体语境中的表示。其优势在于理解多义词和复杂语义，但在样本外组合表现上并不一定优于简单模型。&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;总之，本章通过内部拆解和外部比较，确认了 FarmPredict 的“因子增强 + 残差选择”设计在本文中文财经新闻数据上具有真实且可量化的优势，为全文结论提供了方法论层面的支撑。&lt;/p&gt;

&lt;!-- zab:slot:chapter_ch5:end --&gt;
&lt;hr/&gt;
&lt;!-- zab:slot:chapter_ch6:done --&gt;
&lt;h2&gt;结论&lt;/h2&gt;
&lt;h3&gt;本章作用&lt;/h3&gt;
&lt;p&gt;“结论（Conclusion）”是全文的收束章，主要任务不是提出新的方法或展示新的实验，而是把方法创新、实证结果和学术意义压缩成可清晰复述的总结。对于本文“机器能从中文文本中学到多少金融信息？”这一核心问题，结论给出的回答是：在本文的中文财经新闻数据和中国股票市场设定下，机器不仅能学到具有经济含义的情绪信号，还能把这些信号转化为显著、可交易的组合收益。&lt;/p&gt;
&lt;p&gt;具体而言，本章有三个作用：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;概括方法创新&lt;/strong&gt;：FarmPredict 的核心不是又一个“情绪词典”或“主题模型”，而是一个无监督、数据驱动的分析框架。它先把高维文本分解为少数隐藏因子和大量特质残差，再通过惩罚回归同时利用两者预测收益。结论反复强调，这一框架不依赖预定义字典、人工经验或预训练语义模型。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;提炼实证结论&lt;/strong&gt;：结论把第 4 节、第 5 节的大量结果浓缩为几个关键判断：模型选出的情感词具有经济含义；机器学习的情绪得分与个股 beta 调整后收益显著相关；基于情绪得分的投资组合可以获得可观回报。这些结果共同证明，中文财经新闻文本中包含非平庸的可交易信息。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;指出普适意义&lt;/strong&gt;：结论强调 FarmPredict 是一个高度灵活的分析框架，不限于中文、新闻或中国股票市场。它可以扩展到其他高维文本数据、其他收益定义、其他筛选方法和非线性预测模型。这为后续研究提供了方法论层面的出口。&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;h3&gt;关键概念、论证与技术细节&lt;/h3&gt;
&lt;h4&gt;1. 从“人工先验”到“无监督提取”&lt;/h4&gt;
&lt;p&gt;结论首先指出传统文本研究的重要局限性：大部分研究依赖预定义字典和研究者的人工经验。这种方法可复制性虽然较高，但字典可能带有主观偏差，且只能捕获字典覆盖范围内的信息，难以适应不同市场、不同文本风格和不断变化的情感表达。&lt;/p&gt;
&lt;p&gt;FarmPredict 的替代方案是：不让机器按照人写好的规则去“查词”，而是让机器从高维词频数据中自行提取隐藏结构和预测信号。具体做法是先用主成分分析（PCA）把词频向量 &lt;span class=&quot;math&quot;&gt;$X_i$&lt;/span&gt; 分解为隐藏因子 &lt;span class=&quot;math&quot;&gt;$f_i$&lt;/span&gt; 和特质残差 &lt;span class=&quot;math&quot;&gt;$u_i$&lt;/span&gt;：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$X_i = B f_i + u_i.$&lt;/pre&gt;
&lt;p&gt;这里 &lt;span class=&quot;math&quot;&gt;$f_i$&lt;/span&gt; 可以大致理解为文章的“主题背景”，&lt;span class=&quot;math&quot;&gt;$u_i$&lt;/span&gt; 是去掉主题背景后剩下的“具体用词信息”。整个过程不需要人工标注哪个词是正面、哪个词是负面，因此属于无监督学习。&lt;/p&gt;
&lt;h4&gt;2. FarmPredict 的三步流程&lt;/h4&gt;
&lt;p&gt;结论对 FarmPredict 的流程做了简洁回顾，可以把它拆成三步：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;strong&gt;无监督因子提取&lt;/strong&gt;：用 PCA 从全部词频中估计隐藏因子和特质残差，因子数量由调整特征值阈值法确定。这一步把高度相关的高维词向量转化为数量很少、相关性较弱的因子和残差。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;条件筛选&lt;/strong&gt;：在控制隐藏因子后，筛选出与 beta 调整后收益相关性较高的特质词。这一步是为了降低维度、减少计算负担，但不是必须的。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;惩罚回归预测&lt;/strong&gt;：将隐藏因子和筛选后的特质残差一起放入 LASSO 或其他预测模型，估计每篇文章的得分。&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;结论特别强调：即使第二步只保留了部分词，信息也没有被浪费，因为隐藏因子是从全部词中提取的。换句话说，筛选的过程是“条件在全部信息上的”，因此最终模型仍然利用了完整文本信息。&lt;/p&gt;
&lt;h4&gt;3. “双鲁棒”机制&lt;/h4&gt;
&lt;p&gt;FarmPredict 同时使用了因子和特质残差，这使它在方法论上具有“双重稳健”特征：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;如果收益主要由少数具体情绪词驱动，那么因子收益会很弱，模型自动接近普通 LASSO，即单纯的词选择；&lt;/li&gt;
&lt;li&gt;如果收益主要由文章主题结构驱动，那么模型会较多依赖因子；&lt;/li&gt;
&lt;li&gt;实际数据中两者可能都有一定作用，模型可以在两者之间自动平衡。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;因此，FarmPredict 不是简单地在“词选择模型”和“词聚类模型”之间二选一，而是让数据决定两者的相对权重。结论中对应的英文表述是 “alleviates the information loss by the traditional factor regression in dimensionality reduction and ameliorates the model selection inconsistency in the penalized regression”。&lt;/p&gt;
&lt;h4&gt;4. 避免了传统降维的信息损失&lt;/h4&gt;
&lt;p&gt;传统因子回归通常只保留少数主成分，把残差部分直接扔掉。这种做法在降维上有效，但可能丢掉残差中蕴含的具体情绪信号，例如“涨停”“减持”“涉嫌”这类词。FarmPredict 把因子和残差都保留下来，从而避免这种信息损失。&lt;/p&gt;
&lt;p&gt;同时，高维文本中词与词之间高度相关，直接进行 LASSO 可能不稳定，导致模型选择不一致。FarmPredict 先把高度相关的原始词频转化为相关较弱的因子和残差，再进行惩罚回归，从而缓解了这一问题。&lt;/p&gt;
&lt;h4&gt;5. 实证验证路径&lt;/h4&gt;
&lt;p&gt;结论总结了三类验证方式，用来判断 FarmPredict 是否真的学到了有意义的东西：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;选词分析&lt;/strong&gt;：查看模型选出的正面词和负面词是否具有经济含义；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;情绪与收益的相关性&lt;/strong&gt;：用面板回归检验情绪得分是否显著预测个股 beta 调整后收益，同时验证它不预测市场整体收益；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;情绪投资组合收益&lt;/strong&gt;：基于情绪得分构造多空组合，检验扣除交易成本后是否能获得显著回报。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;结论中并没有重新展示所有表格，而是把这些作为“framework’s effectiveness”的整体证据。从全文结果看，积极新闻情绪在新闻发布日带来平均约 &lt;span class=&quot;math&quot;&gt;$83$&lt;/span&gt; bps 的个股 beta 调整后收益，负面新闻约为 &lt;span class=&quot;math&quot;&gt;$-26$&lt;/span&gt; bps；等权多空组合在扣除交易成本且不考虑涨跌停限制时，年化收益最高可达 &lt;span class=&quot;math&quot;&gt;$54\%$&lt;/span&gt;。这些数字是“机器能学到金融信息”的直接证据。&lt;/p&gt;
&lt;h3&gt;理解全文结论与后续研究必须掌握的内容&lt;/h3&gt;
&lt;p&gt;结论是全文的最后一章，因此没有“后续章节”。但为了准确理解全文的最终判断，或在此基础上开展后续研究，读者必须掌握以下要点：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;FarmPredict 是一个框架，而不只是一个固定模型&lt;/strong&gt;。框架中的输入特征、筛选方法、因子提取方法、预测模型都可以替换。本文使用的是二进制词频、PCA 因子、条件相关筛选和 LASSO，但这只是框架的一个具体实现。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;模型的核心优势来自“无监督因子增强 + 特质残差选择”&lt;/strong&gt;。如果只使用因子，预测力很弱；如果只使用残差，表现已经接近完整模型；两者结合后，组合收益仍略有提高。更重要的是，FarmPredict 没有退化为普通 LASSO，说明因子增强确实带来了额外价值。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;文本信息不是动量代理&lt;/strong&gt;。传统动量策略在中国股票市场上扣除交易成本后几乎全部为负收益，而 FarmPredict 仍能获得显著正收益。这说明新闻文本中包含价格趋势之外的增量信息。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;实证表现要用“预测精度 + 组合收益”两个维度衡量&lt;/strong&gt;。样本外 &lt;span class=&quot;math&quot;&gt;$R^2$&lt;/span&gt; 只有 &lt;span class=&quot;math&quot;&gt;$4.21\%$&lt;/span&gt;，与日常直觉相比很小，但在个股日度收益中已经相当可观。组合收益数字，如每日 &lt;span class=&quot;math&quot;&gt;$17.8$&lt;/span&gt; bps，看似微小，年化后却会放大为 &lt;span class=&quot;math&quot;&gt;$54\%$&lt;/span&gt;。理解这一点有助于正确解读结论中的“显著”一词。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;中国市场制度会影响情绪效应的方向与大小&lt;/strong&gt;。积极新闻的股票收益反应明显强于负面新闻，这与中国的卖空限制一致。正面新闻可能提前泄露或被部分预期，而负面新闻难以提前交易，因此负面效应更集中在新闻发布日附近。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;与传统方法相比，FarmPredict 在文本任务中的优势是系统性的&lt;/strong&gt;。在统一比较口径下，FarmPredict 显著优于 MNIR、SESTM、文本因子模型、BERT、BiRNN、TextCNN 和动量策略。结论中的总结表显示，即使是最接近的 SESTM，每日收益仍比 FarmPredict 低约 &lt;span class=&quot;math&quot;&gt;$1.2$&lt;/span&gt; bps。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;后续研究可以对 FarmPredict 进行多层扩展&lt;/strong&gt;：例如将响应变量换成分类标签、将输入特征换成连续词频或 TF-IDF、将因子模型替换为非线性因子模型、在预测层使用神经网络等。结论为这类扩展提供了清晰路径。&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;h3&gt;公式、实验设置与定义通俗解释&lt;/h3&gt;
&lt;p&gt;结论章本身没有引入新的公式，但为了理解它对前文的总结，以下关键公式和实验设置需要通俗解释。&lt;/p&gt;
&lt;h4&gt;1. 因子分解公式&lt;/h4&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$X_i = B f_i + u_i$&lt;/pre&gt;
&lt;p&gt;把一篇文章 &lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt; 的词频向量 &lt;span class=&quot;math&quot;&gt;$X_i$&lt;/span&gt; 看成一个大列表，里面记录了几万个词各自出现与否或出现次数。这个公式表示：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$f_i$&lt;/span&gt; 是少数几个隐藏因子，可以理解为文章的“主题浓度”，例如“这篇文章有多少中国经济话题、多少公司治理话题”；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$B$&lt;/span&gt; 是因子载荷矩阵，告诉你每个词和每个主题之间的关系强度；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$u_i$&lt;/span&gt; 是特质残差，表示去掉主题背景后，文章中还剩下哪些特殊的用词信息，比如“涨停”“减持”“涉嫌”等具体情绪词。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;整个分解不依赖人工，主题和因子都是机器自己从数据中学到的。&lt;/p&gt;
&lt;h4&gt;2. 预测模型公式&lt;/h4&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$Y_i = a + b^{\top} f_i + \beta^{\top} u_i + \epsilon_i$&lt;/pre&gt;
&lt;p&gt;这里 &lt;span class=&quot;math&quot;&gt;$Y_i$&lt;/span&gt; 是文章 &lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt; 对应的股票在新闻发布日的 beta 调整后收益。模型同时使用：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$f_i$&lt;/span&gt;：文章的题材背景；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$u_i$&lt;/span&gt;：文章的具体用词残差；&lt;/li&gt;
&lt;li&gt;&lt;span class=&quot;math&quot;&gt;$\epsilon_i$&lt;/span&gt;：无法解释的噪声。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;LASSO 惩罚会让很多系数变为零，只留下少数真正有预测力的变量。&lt;/p&gt;
&lt;h4&gt;3. Beta 调整后收益&lt;/h4&gt;
&lt;p&gt;Beta 调整后收益是本文的训练目标。通俗地说，股票当天收益中有很大一部分来自整个市场上涨或下跌，而非公司自身新闻。为了只研究新闻情绪的影响，作者用：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$\text{Beta-adjusted Return}_{it} = \text{股票收益}_{it} - \beta_i \times \text{市场收益}_t$&lt;/pre&gt;
&lt;p&gt;其中 &lt;span class=&quot;math&quot;&gt;$\beta_i$&lt;/span&gt; 用历史数据估计，表示股票相对于市场指数的涨跌弹性。扣除市场影响后，得到的 beta 调整后收益更接近“公司特有收益”。&lt;/p&gt;
&lt;h4&gt;4. 条件筛选&lt;/h4&gt;
&lt;p&gt;条件筛选可以理解为：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;先用因子 &lt;span class=&quot;math&quot;&gt;$f_i$&lt;/span&gt; 回归收益 &lt;span class=&quot;math&quot;&gt;$Y_i$&lt;/span&gt;，得到因子解释不掉的那部分收益 &lt;span class=&quot;math&quot;&gt;$Y_u$&lt;/span&gt;；&lt;/li&gt;
&lt;li&gt;再计算每个残差词 &lt;span class=&quot;math&quot;&gt;$u_{ij}$&lt;/span&gt; 与 &lt;span class=&quot;math&quot;&gt;$Y_u$&lt;/span&gt; 的相关性；&lt;/li&gt;
&lt;li&gt;只保留相关性超过阈值 &lt;span class=&quot;math&quot;&gt;$\alpha$&lt;/span&gt; 的词进入下一轮 LASSO。&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;这样做的好处是：先排除文章主题的影响，再找具体词里的情绪信号。即使最后只保留了 500、1,000 或 2,000 个词，这些词也是基于全部信息的条件筛选结果。&lt;/p&gt;
&lt;h4&gt;5. 惩罚回归与 LASSO&lt;/h4&gt;
&lt;p&gt;LASSO 在普通最小二乘基础上增加了一个惩罚项，使不重要的变量系数被压缩为零。通俗地说，LASSO 会自动“关闭”那些对收益没有帮助的词，只保留少数高信息量的词。惩罚强度由 &lt;span class=&quot;math&quot;&gt;$\lambda$&lt;/span&gt; 控制，&lt;span class=&quot;math&quot;&gt;$\lambda$&lt;/span&gt; 越大，保留下来的词越少。本文中 &lt;span class=&quot;math&quot;&gt;$\lambda$&lt;/span&gt; 由交叉验证选择，目标是让训练集和验证集上都取得较好表现。&lt;/p&gt;
&lt;h4&gt;6. 无监督学习的含义&lt;/h4&gt;
&lt;p&gt;无监督学习是不给模型提供“正确答案”或人工标签的学习方式。在本文中，机器只看到词频矩阵 &lt;span class=&quot;math&quot;&gt;$X$&lt;/span&gt; 和股票收益 &lt;span class=&quot;math&quot;&gt;$Y$&lt;/span&gt;，但这个 &lt;span class=&quot;math&quot;&gt;$Y$&lt;/span&gt; 本身并不来自人工情绪标注，而是市场交易结果。模型需要自行判断哪些词、哪些主题与未来收益相关。这与传统“正面词清单”方式不同，避免了人工字典的主观性和覆盖面局限。&lt;/p&gt;
&lt;h4&gt;7. 调整特征值阈值&lt;/h4&gt;
&lt;p&gt;在 PCA 中，需要决定保留多少个隐藏因子。调整特征值阈值法通过校正相关矩阵的特征值，判断哪些共同变动方向显著大于噪声。本文最终选出 &lt;span class=&quot;math&quot;&gt;$9$&lt;/span&gt; 个因子，意味着在所有词频变动中，大约有九条主要的“共同主题线”在起作用。阈值参数 &lt;span class=&quot;math&quot;&gt;$C$&lt;/span&gt; 是控制这一判断严格程度的超参数。&lt;/p&gt;
&lt;p&gt;总之，结论章没有全新的技术内容，而是对全文方法和实证结果的最高层次概括。理解结论的关键，是把握住“无监督提取 + 因子增强 + 残差选择”这一核心设计，以及它在中文金融文本预测中带来的显著优势。&lt;/p&gt;

&lt;!-- zab:slot:chapter_ch6:end --&gt;
&lt;!-- zab:slot:q_core_contribution:done --&gt;
&lt;h2&gt;核心贡献判断&lt;/h2&gt;
&lt;h3&gt;本文最核心的贡献&lt;/h3&gt;
&lt;p&gt;本文最核心的贡献是提出了一个全新的文本预测框架 &lt;strong&gt;FarmPredict&lt;/strong&gt;（Factor-Augmented Regularized Model for Prediction），能够在不依赖任何预设词典、人工标注或预训练语言模型的情况下，直接从原始中文财经新闻文本中自动提取信息并预测个股收益。&lt;/p&gt;
&lt;p&gt;FarmPredict 的三个关键步骤为：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;strong&gt;无监督因子学习&lt;/strong&gt;：通过主成分分析（PCA）从高维词频矩阵中提取潜在因子（可理解为文章的主题或话题），因子个数由调整特征值阈值法自动确定；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;条件特质词筛选&lt;/strong&gt;：在控制潜在因子后，筛选出与目标收益最相关的特质词（sentiment-charged words）；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;稀疏回归预测&lt;/strong&gt;：将潜在因子与筛选后的特质成分同时放入带 &lt;span class=&quot;math&quot;&gt;$L_1$&lt;/span&gt; 惩罚的回归模型（如 LASSO）中，对收益进行联合预测。&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;该框架本质上是一个“因子增强的正则化预测模型”，具有“双重稳健”特性：如果收益主要由个别词汇驱动，模型会自动退化为普通的 LASSO；如果收益主要由文章主题/聚类驱动，则因子部分会占主导。因此，FarmPredict 能够在词选择和主题聚类之间自动取得平衡，避免了传统因子回归降维的信息损失，也缓解了高维相关协变量下模型选择不一致的问题。&lt;/p&gt;
&lt;h3&gt;为什么重要&lt;/h3&gt;
&lt;p&gt;&lt;strong&gt;1. 方法论上突破了传统文本分析的局限&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;以往金融文本研究大多依赖预设词典（如 Loughran-McDonald 词典）或预训练模型，主观性强、跨领域适应性差。FarmPredict 完全由数据驱动，机器在无监督条件下自行学习文本中的预测信息，避免了人工先验带来的偏差。这种高度灵活、可泛化的框架不仅适用于中文财经新闻，也可以迁移到其他高维文本预测任务。&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;2. 实证上展示了机器能从中文文本中学习到可观的金融信息&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;在 2015–2019 年中国 A 股市场的大规模新闻数据上，FarmPredict 情绪得分显示出显著的股票收益预测能力：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;正面情绪新闻当日平均带来 &lt;strong&gt;83 个基点（bps）&lt;/strong&gt; 的超额收益；&lt;/li&gt;
&lt;li&gt;负面情绪新闻当日平均带来 &lt;strong&gt;-26 个基点&lt;/strong&gt; 的影响；&lt;/li&gt;
&lt;li&gt;效应可持续数天。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;基于该情绪得分构建的等权多空组合，在扣除较高交易成本和涨跌停限制后，年化收益率最高可达 &lt;strong&gt;54%&lt;/strong&gt;（夏普比率 &lt;strong&gt;4.30&lt;/strong&gt;），显著优于 MNIR、SESTM、文本因子模型、BERT、双向循环神经网络、TextCNN 及传统动量策略等基准模型。&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;3. 揭示了新兴市场文本信息传导的独特机制&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;事件研究和安慰剂检验表明：正面新闻发布前约 7 天个股超额收益开始上升，而负面新闻发布前无显著下跌；新闻发布后正面情绪冲击（83 bps）远大于负面情绪冲击（26 bps）。这一不对称性与中国股票市场卖空受限、散户投资者占比较高的微观结构高度吻合，说明文本情绪在有限套利环境下具有更强的可交易信息含量。这为理解中国等发展中市场的资产价格行为提供了新的证据。&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;4. 证明了非英文、非发达市场中机器文本学习的可行性&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;已有文本金融研究主要集中在英文和发达市场。本文以中文财经新闻为对象，构建了覆盖 91.4 万篇文章的数据集，并验证了无监督机器学习在中文语境、高噪音散户市场中的有效性。这不仅弥补了跨语言、跨市场文本金融研究的空白，也为后续利用机器从非结构化文本中学习经济金融规律提供了可复现的分析框架和实证基准。&lt;/p&gt;
&lt;p&gt;综上，FarmPredict 的提出及其中文市场应用证明了：机器可以从文本数据中直接“学会”金融预测，而且这种数据驱动的方法在预测能力、投资绩效和机制解释上均优于传统及当前主流的文本分析方法。&lt;/p&gt;

&lt;!-- zab:slot:q_core_contribution:end --&gt;
&lt;hr/&gt;
&lt;!-- zab:slot:q_limits_questions:done --&gt;
&lt;h2&gt;局限与疑问&lt;/h2&gt;
&lt;h3&gt;本文值得注意的局限、风险与未解决问题&lt;/h3&gt;
&lt;ol&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;交易执行约束严重削弱策略实际收益&lt;/strong&gt;&lt;br&gt;论文明确指出，中国股市的交易成本（约13 bps/次买卖）和每日涨跌停限制对高频换仓策略构成重大障碍。在考虑交易成本后，等权组合的年化收益率从105.16%降至54.35%；若进一步假设涨跌停股票完全无法成交（下限情景），等权组合年化收益率仅剩4.30%，价值加权组合则转为负收益（-14.11%）。这说明模型捕捉到的部分信号集中在涨跌停股票上，而这些股票在实际交易中往往难以执行，因此论文报告的收益存在明显的高估风险。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;卖空限制可能扭曲负向信号的可实现性&lt;/strong&gt;&lt;br&gt;中国A股市场长期存在严格的卖空约束，融券成本高且标的有限。论文的策略依赖做空低分股票，但论文也承认负向新闻的影响（-26 bps）显著弱于正向新闻（+83 bps），且负向新闻事件前未出现显著的提前下跌，这与卖空限制一致。实际投资中，做空部分可能难以实施或成本极高，导致论文展示的“多空组合”收益无法被普通投资者复制。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;数据抓取与下采样带来样本选择偏差&lt;/strong&gt;&lt;br&gt;论文的新闻数据通过广度优先爬虫从新浪财经获取，抓取过程具有随机性，导致不同年份新闻数量极不均衡（2019年超过70万篇，而2012年仅约1万篇）。为缓解计算负担，论文将每日新闻数下采样至最多300篇，但这一操作可能系统性地改变了原始新闻流的分布，尤其是低频年份的样本代表性存疑。此外，新闻来源单一（仅新浪财经），可能遗漏其他重要媒体渠道（如官方公告、社交媒体等）的信息。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;模型的外部效度受制于中国市场特殊性&lt;/strong&gt;&lt;br&gt;论文的实证结论完全基于中国A股市场，该市场具有散户占比高、监管严格、涨跌停制度、卖空限制等鲜明特征。论文指出，这些制度安排导致正向新闻与负向新闻的影响不对称，且正向词汇更偏向“交易相关”而非“价值相关”，这与美国等成熟市场的发现不同。因此，FarmPredict在中国市场表现出的预测能力和收益模式未必能推广到其他语言或市场环境，尤其对于英文文本和成熟市场，模型效果可能显著下降。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;词袋模型忽略语义复杂性与上下文信息&lt;/strong&gt;&lt;br&gt;FarmPredict基于词频（或二元出现与否）构建特征，使用Jieba分词配合PCA和LASSO，本质上是一个线性词袋模型。它无法捕捉否定、反讽、条件句、指代消解等复杂语义关系，也无法区分同一词汇在不同语境中的含义变化（例如“涨”可能出现在“不涨”或“涨幅有限”等否定结构中）。论文虽展示了部分情感词和因子主题，但整体模型仍是“黑箱”，对文本语义的理解深度有限。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;超参数选择存在主观性与数据窥探风险&lt;/strong&gt;&lt;br&gt;论文中因子数量通过调整后的特征值阈值法确定，但作者选定参数C=150是基于对2000–2014年全样本特征值图的目视判断（“图中显示有两个较强因子和七个较弱因子”），而非严格的交叉验证。此外，词频阈值κ和条件筛选阈值α的调优范围也是人为设定。这种主观选择可能受到全样本特征的影响，导致测试期表现被高估。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;内生性问题未能完全解决&lt;/strong&gt;&lt;br&gt;论文通过滞后收益、控制变量、固定效应等方式缓解新闻与收益之间的内生性，但新闻发布本身可能与过去或当期的价格行为相关（例如媒体可能倾向于报道涨幅居前的股票）。事件研究表明正向新闻前7天收益已开始上升，暗示可能存在信息泄露或媒体选择性报道。尽管使用了滞后一词的收益作为控制，但无法排除新闻本身就是对过去收益的反应，从而削弱了“新闻驱动收益”的因果解释。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;模型比较的公平性与基准局限性&lt;/strong&gt;&lt;br&gt;论文比较了FarmPredict与MNIR、SESTM、文本因子模型、BERT、BiRNN、TextCNN及动量策略等，但部分基准模型（如BERT类）需要大规模预训练和调参，论文仅使用了固定的预训练模型并简单地附加预测层，可能未充分发挥这些深度学习方法的潜力。此外，模型间的超参数调优均使用相同的训练/验证窗口，但不同模型对超参数的敏感性不同，简单的比较可能低估某些基准模型的真实表现。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;收益归因与风险暴露分析不足&lt;/strong&gt;&lt;br&gt;论文报告了多空组合的市场风险暴露较低（R²约6.92%），并使用了Carhart四因子模型计算alpha，但未深入检验其他潜在风险因子（如流动性、波动率、反转因子、行业因子等）的影响。中国市场中反转效应和流动性溢价显著，FarmPredict的收益可能部分来自这些未被控制的因子，而非纯粹的文本信息。&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;&lt;p&gt;&lt;strong&gt;未解决的实际可交易性与容量问题&lt;/strong&gt;&lt;br&gt;论文策略每日换仓，依赖于新闻发布后一个交易日的持有期，这要求极高的执行速度和资金容量。论文未讨论策略的容量限制、冲击成本以及大资金规模下对市场价格的影响。对于小市值股票，50只等权持仓可能已经触及流动性瓶颈，实际收益可能远低于论文报告值。&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;

&lt;!-- zab:slot:q_limits_questions:end --&gt;</rdf:value>
        <dc:subject>AI-DeepRead</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3">
        <rdf:value>&lt;!-- AI_BUTLER_LLM_BLOCK_BEGIN::v1::llm-summary-msx95hlj-qk3yridb1m::5jje1n2m55 --&gt;
&lt;!-- AI_BUTLER_LLM_META_B64URL::v1:: --&gt;
&lt;h2&gt;AI 总结 - How Much Can Machines Learn Finance from Chinese Text Data?&lt;/h2&gt;

&lt;p data-ai-butler-llm-source=&quot;v1&quot; data-ai-butler-llm-block-id=&quot;llm-summary-msx95hlj-qk3yridb1m&quot; data-ai-butler-llm-meta=&quot;&quot; style=&quot;margin: 0 0 12px 0; padding: 6px 8px; border-left: 3px solid #59c0bc; background: #f4fbfb; color: #3d5f5d; font-size: 12px; line-height: 1.45;&quot;&gt;&lt;strong&gt;AI 来源：&lt;/strong&gt;供应商：DeepSeek · 模型：deepseek-v4-pro · 生成时间：&lt;span title=&quot;2026-08-17T13:11:11.959Z&quot;&gt;2026/8/17 21:11:11&lt;/span&gt;&lt;/p&gt;
&lt;div&gt;&lt;p&gt;本文提出并验证了一个名为 &lt;strong&gt;FarmPredict&lt;/strong&gt; 的文本预测框架，用于让机器直接从中文财经新闻中学习股票收益信息。FarmPredict 将高维文本数据通过无监督因子模型分解为潜在因子和特质残差，再用稀疏正则化回归把两者同时纳入预测模型，避免了传统降维方法的信息损失，并具有“词选择”与“词聚类”之间自动平衡的双重稳健特性。作者将该方法应用于新浪财经新闻数据，预测中国 A 股个股的 beta 调整后收益。结果显示，FarmPredict 能捕捉到显著的个股情绪信号：正面新闻在发布当日平均带来约 83 个基点的超额收益，负面新闻平均带来约 26 个基点的负面冲击，且正负影响存在不对称性，与中国市场的卖空约束一致。基于该情绪分数的多空组合在考虑交易成本后，等权组合年化收益最高可达 54%，夏普比率 4.30，显著优于 LASSO、MNIR、SESTM、词向量聚类、BERT 等基准模型。研究表明，机器能够从非英文、散户主导的新兴市场文本中学习到具有经济价值的金融信息。&lt;/p&gt;
&lt;hr&gt;
&lt;h2&gt;1. 研究背景与问题动机&lt;/h2&gt;
&lt;p&gt;在金融研究中，文本数据被广泛用来构造情绪、观点、主题等信号，进而预测资产价格或收益。传统做法通常依赖预先定义的情绪词典，例如 Loughran–McDonald 词典，统计文档中正面词和负面词的出现次数来构造情绪分数。这种方法虽然容易复现，但高度依赖词典质量，容易受到主观经验偏差影响，而且难以适应不同语言、不同市场和不同文本风格。&lt;/p&gt;
&lt;p&gt;近年来，机器学习方法被引入文本分析。一类方法是“词选择”，例如通过带惩罚的文本回归、支持向量机、多项逆回归等筛选出与收益相关的关键词；另一类方法是“词聚类”或“主题模型”，例如 LDA、词向量聚类等，把文档表示成若干主题或因子的组合。但这两类方法各有缺陷：词选择可能忽略词语之间的相关结构与上下文信息；主题模型则往往依赖先验知识和较强的统计假设，而且如果只使用主题因子进行预测，可能丢失原始文本中的有用信息。&lt;/p&gt;
&lt;p&gt;本文的核心问题是：&lt;strong&gt;在没有任何预设词典或先验知识的情况下，机器能否直接从海量文本中学习到与金融收益相关的信息？&lt;/strong&gt; 为此，作者提出 FarmPredict 框架，并将它应用于中文财经新闻和中国股票市场。&lt;/p&gt;
&lt;hr&gt;
&lt;h2&gt;2. FarmPredict 方法论&lt;/h2&gt;
&lt;h3&gt;2.1 问题设定&lt;/h3&gt;
&lt;p&gt;假设有 &lt;span class=&quot;math&quot;&gt;$n$&lt;/span&gt; 篇文章。令 &lt;span class=&quot;math&quot;&gt;$D$&lt;/span&gt; 为所有可能中文词的集合，第 &lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt; 篇文章的词频向量记为 &lt;span class=&quot;math&quot;&gt;$d_i \in \mathbb{N}^{|D|}$&lt;/span&gt;，其中 &lt;span class=&quot;math&quot;&gt;$d_{i,k}$&lt;/span&gt; 表示第 &lt;span class=&quot;math&quot;&gt;$k$&lt;/span&gt; 个词在该文章中出现的次数。每篇文章关联一个目标变量 &lt;span class=&quot;math&quot;&gt;$Y_i$&lt;/span&gt;，本文中是该文章对应股票在新闻发布日的 beta 调整后收益。&lt;/p&gt;
&lt;p&gt;文本数据维度极高且稀疏。在本文数据中，全部词表约 118 万个，但只有约 7.1 万个词至少出现在 50 篇文章中。研究假设只有少量词与收益相关，称为“情绪词”；其余为“情绪中性词”。&lt;/p&gt;
&lt;h3&gt;2.2 高频词筛选&lt;/h3&gt;
&lt;p&gt;首先过滤掉极低频词，只保留在至少 &lt;span class=&quot;math&quot;&gt;$\kappa$&lt;/span&gt; 篇文章中出现过的词，形成高频词表 &lt;span class=&quot;math&quot;&gt;$D_{freq}$&lt;/span&gt;。阈值 &lt;span class=&quot;math&quot;&gt;$\kappa$&lt;/span&gt; 作为超参数调节，平衡词表覆盖率和噪声。&lt;/p&gt;
&lt;h3&gt;2.3 因子模型与 PCA&lt;/h3&gt;
&lt;p&gt;对高频词特征 &lt;span class=&quot;math&quot;&gt;$X_i$&lt;/span&gt;，假设其服从近似因子模型：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$$X_i = B f_i + u_i,$$&lt;/pre&gt;
&lt;p&gt;其中 &lt;span class=&quot;math&quot;&gt;$f_i \in \mathbb{R}^k$&lt;/span&gt; 是 &lt;span class=&quot;math&quot;&gt;$k$&lt;/span&gt; 个潜在因子，&lt;span class=&quot;math&quot;&gt;$B$&lt;/span&gt; 是因子载荷矩阵，&lt;span class=&quot;math&quot;&gt;$u_i$&lt;/span&gt; 是特质残差项，与因子不相关。写成矩阵形式：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$$X = F B^T + U.$$&lt;/pre&gt;
&lt;p&gt;这里 &lt;span class=&quot;math&quot;&gt;$X$&lt;/span&gt; 和 &lt;span class=&quot;math&quot;&gt;$U$&lt;/span&gt; 是 &lt;span class=&quot;math&quot;&gt;$n \times |D_{freq}|$&lt;/span&gt; 矩阵，&lt;span class=&quot;math&quot;&gt;$F$&lt;/span&gt; 是 &lt;span class=&quot;math&quot;&gt;$n \times k$&lt;/span&gt; 因子矩阵。只有 &lt;span class=&quot;math&quot;&gt;$X$&lt;/span&gt; 可观测，&lt;span class=&quot;math&quot;&gt;$F$&lt;/span&gt;、&lt;span class=&quot;math&quot;&gt;$B$&lt;/span&gt;、&lt;span class=&quot;math&quot;&gt;$U$&lt;/span&gt; 需要通过主成分分析估计。&lt;/p&gt;
&lt;p&gt;潜在因子可以理解为文章的“主题”或“话题”。例如宏观新闻和基金类文章会有不同的词汇分布，这些差异体现在因子载荷中。因子模型把高度相关的原始词汇变量分解成潜在因子和近似不相关的特质残差，有助于缓解多重共线性。&lt;/p&gt;
&lt;p&gt;预测模型设定为：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$$Y_i = a + b^T f_i + \beta^T u_i + \varepsilon_i,$$&lt;/pre&gt;
&lt;p&gt;其中 &lt;span class=&quot;math&quot;&gt;$b$&lt;/span&gt; 和 &lt;span class=&quot;math&quot;&gt;$\beta$&lt;/span&gt; 分别是对因子和特质残差的系数，&lt;span class=&quot;math&quot;&gt;$\varepsilon_i$&lt;/span&gt; 为噪声。这个模型比直接用 &lt;span class=&quot;math&quot;&gt;$X_i$&lt;/span&gt; 做线性回归更灵活，因为因子和残差的线性组合张成的空间与原始变量相同，但因子方向能更好地捕捉共同信息。&lt;/p&gt;
&lt;h3&gt;2.4 因子数量的选择：调整特征值阈值法&lt;/h3&gt;
&lt;p&gt;Fan 等人提出的调整特征值阈值法用于数据驱动地选择因子数量 &lt;span class=&quot;math&quot;&gt;$k$&lt;/span&gt;。具体地，对相关矩阵的特征值进行偏差校正后，统计其是否显著大于 1：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$$\hat k = \max \left\{ j &amp;lt; |D_{freq}| : \hat\lambda_j^C &amp;gt; 1 + C \sqrt{\frac{|D_{freq}|}{n-1}} \right\},$$&lt;/pre&gt;
&lt;p&gt;其中 &lt;span class=&quot;math&quot;&gt;$\hat\lambda_j^C$&lt;/span&gt; 是第 &lt;span class=&quot;math&quot;&gt;$j$&lt;/span&gt; 大偏差校正特征值，&lt;span class=&quot;math&quot;&gt;$C$&lt;/span&gt; 是超参数。本文中通过调参选择 &lt;span class=&quot;math&quot;&gt;$C=150$&lt;/span&gt;，最终得到 &lt;span class=&quot;math&quot;&gt;$\hat k=9$&lt;/span&gt; 个因子。&lt;/p&gt;
&lt;h3&gt;2.5 条件筛选情绪词&lt;/h3&gt;
&lt;p&gt;在估计出因子 &lt;span class=&quot;math&quot;&gt;$\hat F$&lt;/span&gt; 后，先用 &lt;span class=&quot;math&quot;&gt;$Y$&lt;/span&gt; 对 &lt;span class=&quot;math&quot;&gt;$\hat F$&lt;/span&gt; 回归，得到残差 &lt;span class=&quot;math&quot;&gt;$\hat Y_u$&lt;/span&gt;，它表示收益中无法被因子解释的部分。然后计算每个特质残差列 &lt;span class=&quot;math&quot;&gt;$\hat U_j$&lt;/span&gt; 与 &lt;span class=&quot;math&quot;&gt;$\hat Y_u$&lt;/span&gt; 的相关系数，该相关本质上是在控制因子后的偏相关。给定阈值 &lt;span class=&quot;math&quot;&gt;$\alpha$&lt;/span&gt;，情绪词集合定义为：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$$\hat S = \{ j : |\operatorname{corr}(\hat U_j, \hat Y_u)| &amp;gt; \alpha \} \cap \{ j : k_j \geq \kappa \}.$$&lt;/pre&gt;
&lt;p&gt;这一步是可选的计算加速步骤，但不会丢失信息，因为因子已经包含了全部词的共同信息。&lt;/p&gt;
&lt;h3&gt;2.6 拟合 FarmPredict&lt;/h3&gt;
&lt;p&gt;在情绪词集合 &lt;span class=&quot;math&quot;&gt;$\hat S$&lt;/span&gt; 上，FarmPredict 求解如下惩罚最小二乘问题：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$$\min_{a, b, \beta} \left\{ \frac{1}{n} \sum_{i=1}^n \left( Y_i - a - b^T f_i - \beta^T u_{i,\hat S} \right)^2 + \lambda \|b\|_1 + \lambda \|\beta\|_1 \right\},$$&lt;/pre&gt;
&lt;p&gt;其中 &lt;span class=&quot;math&quot;&gt;$u_{i,\hat S}$&lt;/span&gt; 是第 &lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt; 篇文章特质残差中情绪词对应的部分。惩罚参数 &lt;span class=&quot;math&quot;&gt;$\lambda$&lt;/span&gt; 通过交叉验证选择，控制模型复杂度和系数稀疏性。L1 惩罚能进一步筛选出真正有预测力的词。惩罚项也可以替换为 SCAD、弹性网等其他形式。&lt;/p&gt;
&lt;h3&gt;2.7 对新文章打分&lt;/h3&gt;
&lt;p&gt;给定新文章特征 &lt;span class=&quot;math&quot;&gt;$X_{new}$&lt;/span&gt;，先用训练好的载荷矩阵 &lt;span class=&quot;math&quot;&gt;$\hat B$&lt;/span&gt; 估计其因子和残差：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$$f_{new} = (\hat B^T \hat B)^{-1} \hat B^T X_{new}, \quad
u_{new} = X_{new} - \hat B f_{new}.$$&lt;/pre&gt;
&lt;p&gt;然后预测情绪分数：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$$\hat Y_{new} = \hat a + \hat b^T f_{new} + \hat \beta^T u_{new,\hat S}.$$&lt;/pre&gt;
&lt;h3&gt;2.8 方法变体与灵活性&lt;/h3&gt;
&lt;p&gt;FarmPredict 是一个灵活的框架，而非固定模型。目标变量可以是连续收益，也可以二分为正负收益；特征可以是原始词频，也可以是 0/1 出现指示；因子提取不限于原始词频，也可以基于交互项或加入公司特征；最后的预测函数可以是线性模型，也可以是神经网络等非线性模型。本文主要使用带 L1 惩罚的线性模型。&lt;/p&gt;
&lt;p&gt;FarmPredict 的一个重要性质是“双重稳健”：如果收益完全可以由个别词预测，模型会让因子系数趋于零，退化为 LASSO；如果主题因子足够，则会更多利用因子。它自动在词选择和词聚类之间取得平衡，避免单一方法的局限性。&lt;/p&gt;
&lt;hr&gt;
&lt;h2&gt;3. 数据与预处理&lt;/h2&gt;
&lt;h3&gt;3.1 数据来源&lt;/h3&gt;
&lt;p&gt;新闻数据来自新浪财经网站，这是中国最大的财经新闻平台之一，每天发布超过 500 条股票相关新闻。作者使用广度优先爬虫从新浪财经主页开始，下载了约 634 万个链接，其中约 588 万为有效新闻文章。提取了每篇文章的发布时间、标题和正文，并通过正则表达式和网页结构匹配相关股票。&lt;/p&gt;
&lt;h3&gt;3.2 文本清洗与股票匹配&lt;/h3&gt;
&lt;p&gt;预处理步骤包括：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;strong&gt;去重&lt;/strong&gt;：同一标题且同一天发布的文章只保留一篇。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;字符清洗&lt;/strong&gt;：去除 HTML 标签、数字、标点和特殊字符，仅保留中文字符。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;股票匹配&lt;/strong&gt;：优先使用网页官方标签；若无标签，则扫描正文中的股票名称和代码。删除未匹配或匹配到多只股票的文章。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;收益匹配&lt;/strong&gt;：计算每篇文章对应股票在新闻发布时的有效收益。&lt;/li&gt;
&lt;/ol&gt;
&lt;h3&gt;3.3 Beta 调整收益&lt;/h3&gt;
&lt;p&gt;为了聚焦新闻对个股的独特信息，排除市场整体影响，本文使用 beta 调整收益：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$$\text{Beta-adjusted Return}_{it} = \text{Dividend Adjusted Return}_{it} - \beta_i \cdot \text{SSEC Return}_t,$$&lt;/pre&gt;
&lt;p&gt;其中 &lt;span class=&quot;math&quot;&gt;$\beta_i$&lt;/span&gt; 用 2005—2014 年个股日收益对上证综合指数日收益回归估计。收益时间窗为覆盖新闻发布时间的收盘到收盘收益。例如，周二下午 1 点发布的新闻，使用周一收盘到周二收盘的收益；周五晚 6 点发布的新闻，使用周五收盘到下周一收盘的收益。&lt;/p&gt;
&lt;h3&gt;3.4 中文分词&lt;/h3&gt;
&lt;p&gt;使用 Jieba 分词工具，基于隐马尔可夫模型对标题和正文进行分词。该方法在字符级别标注 B（词首）、M（词中）、E（词尾）、S（单字），并用 Viterbi 算法求解最可能的状态序列，从而切分词语。&lt;/p&gt;
&lt;h3&gt;3.5 下采样与最终数据&lt;/h3&gt;
&lt;p&gt;由于爬虫在不同年份获取的文章数量差异很大，例如 2019 年超过 70 万篇，而 2012 年仅约 1 万篇，作者对每天最多保留 300 篇文章进行随机下采样，最终得到 914,070 篇文章。词表共有约 118 万个不同词，其中 71,000 个词至少出现在 50 篇文章中。每篇文章的中位数总词数为 309，不同词数为 209，词频矩阵非常稀疏，中位文章非零占比仅 0.29%。&lt;/p&gt;
&lt;h3&gt;3.6 训练、验证与测试&lt;/h3&gt;
&lt;p&gt;超参数调优使用 2000—2010 年数据训练，2011—2014 年数据验证，以等权组合累计收益最大化为目标。测试采用滚动窗口：每个窗口用 10 年数据训练，随后 6 个月测试，窗口每 6 个月向前滚动。第一个窗口为 2005—2014 年训练、2015 年 1—6 月测试，最后一个窗口测试期为 2019 年 7—12 月。共 10 个窗口，全部测试样本覆盖 2015—2019 年。&lt;/p&gt;
&lt;hr&gt;
&lt;h2&gt;4. 实证结果&lt;/h2&gt;
&lt;h3&gt;4.1 情绪分数的验证&lt;/h3&gt;
&lt;h4&gt;4.1.1 情绪词的内容&lt;/h4&gt;
&lt;p&gt;作者首先考察 FarmPredict 筛选出的最具情绪强度词汇。正面词包括“涨停”“走强”“十只”“涨”“抢反弹”等；负面词包括“跌停”“敢死队”“准确率”“日盘”“跌”等。&lt;/p&gt;
&lt;p&gt;这些词汇中既有传统情绪词，也有看似非情绪但在中国市场语境下具有特殊含义的词，例如“敢死队”常被用来比喻熊市中激进抄底资金，具有负面预测含义。结果显示，正面情绪词更多与“交易行为”相关，而负面情绪词更多与“价值/法律”信息相关。这与中国市场散户占比高、交易驱动强的特征一致，也反映出负面信息在卖空限制下更难通过交易提前反应。&lt;/p&gt;
&lt;h4&gt;4.1.2 个股收益预测能力&lt;/h4&gt;
&lt;p&gt;为验证情绪分数是否预测个股收益，作者进行面板回归：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$$Return_{it} = Sentiment_{i,t-1} + Return_{i,t-s} + X_{it} + \mu_t + \varepsilon_{it},$$&lt;/pre&gt;
&lt;p&gt;其中 &lt;span class=&quot;math&quot;&gt;$Return_{it}$&lt;/span&gt; 是股票 &lt;span class=&quot;math&quot;&gt;$i$&lt;/span&gt; 在第 &lt;span class=&quot;math&quot;&gt;$t$&lt;/span&gt; 天的 beta 调整收益，&lt;span class=&quot;math&quot;&gt;$Sentiment_{i,t-1}$&lt;/span&gt; 是前一天新闻情绪分数，&lt;span class=&quot;math&quot;&gt;$X_{it}$&lt;/span&gt; 包含公司规模、市净率、beta、alpha、波动率、盈利意外等控制变量，&lt;span class=&quot;math&quot;&gt;$\mu_t$&lt;/span&gt; 是时间固定效应。结果显示，情绪分数的系数显著为正，从最初的 0.350 降至加入控制变量后的 0.193，仍然高度显著，调整 &lt;span class=&quot;math&quot;&gt;$R^2$&lt;/span&gt; 约 3.1%。这说明 FarmPredict 的情绪分数确实包含对个股超额收益的预测信息。&lt;/p&gt;
&lt;h4&gt;4.1.3 市场收益无预测能力&lt;/h4&gt;
&lt;p&gt;作者还检验了情绪分数对市场指数收益的预测能力。将每日平均情绪分数及其离散度对沪深 300 指数收益回归，加入短期、长期滞后收益、估值水平和利率等控制变量。结果显示，无论模型设定如何，平均情绪分数和离散度均不显著。这说明 FarmPredict 学到的是个股特质信息，而非市场整体信息。&lt;/p&gt;
&lt;h4&gt;4.1.4 事件研究&lt;/h4&gt;
&lt;p&gt;作者把新闻发布视作事件，事件窗口为发布前 13 天到发布后 14 天，进行如下回归：&lt;/p&gt;
&lt;pre class=&quot;math&quot; style=&quot;max-width:100%; overflow-x:auto; overflow-y:hidden; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; box-sizing:border-box;&quot;&gt;$$Return_{it} = \sum_{p=-13}^{14} \beta_p Day_{ip} + \delta_i + \mu_t + \varepsilon_{it},$$&lt;/pre&gt;
&lt;p&gt;其中 &lt;span class=&quot;math&quot;&gt;$Day_{ip}$&lt;/span&gt; 是事件日指示变量，&lt;span class=&quot;math&quot;&gt;$\delta_i$&lt;/span&gt; 和 &lt;span class=&quot;math&quot;&gt;$\mu_t$&lt;/span&gt; 分别为股票和日期固定效应。&lt;/p&gt;
&lt;p&gt;事件研究发现：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;正面新闻&lt;/strong&gt;：股票 beta 调整收益在新闻发布前约 7 天开始显著上升，发布当日达到峰值，全样本平均约 83 个基点。正面影响持续约 2 天。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;负面新闻&lt;/strong&gt;：发布前没有明显提前下跌，负面冲击主要集中在发布当天，平均约 26 个基点，持续约 3 天。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这种正负不对称与中国市场的卖空限制和监管有关。正面信息可以通过买入提前反应，而负面信息因为难以卖空，难以在发布前充分反映，因此负面新闻发布时冲击更突然、幅度相对较小。&lt;/p&gt;
&lt;h4&gt;4.1.5 安慰剂检验&lt;/h4&gt;
&lt;p&gt;为了确认事件研究中的收益模式确实由新闻事件引起，作者随机抽取与事件窗口等长的 28 天样本，重复 200 次进行同样的回归。结果显示，安慰剂样本的平均收益围绕零波动，而真实事件后的收益显著高于安慰剂分布。这支持了事件研究结果的真实性。&lt;/p&gt;
&lt;h3&gt;4.2 投资组合表现&lt;/h3&gt;
&lt;h4&gt;4.2.1 组合构建&lt;/h4&gt;
&lt;p&gt;基于预测情绪分数，每个交易日根据前一日收盘至当日收盘之间发布的新闻，对相关股票计算情绪分数。然后做多分数最高的 50 只股票，做空分数最低的 50 只股票。若高分或低分股票不足 50 只，未分配资金以现金形式持有。组合在当日收盘竞价建仓，持有至次日收盘平仓。&lt;/p&gt;
&lt;p&gt;等权组合中每只股票固定分配 1% 总资本；市值加权组合中权重与股票前一日总市值成正比。&lt;/p&gt;
&lt;h4&gt;4.2.2 交易成本与涨跌停限制&lt;/h4&gt;
&lt;p&gt;中国股市交易成本主要包括印花税、过户费和交易佣金，合计约为每次买卖 13 个基点。此外，中国股市实行 ±10% 涨跌停限制，涨跌停时股票难以成交。作者给出组合收益的上界（所有涨跌停股票均能成交）和下界（涨跌停股票均无法成交）作为参考区间。&lt;/p&gt;
&lt;h4&gt;4.2.3 基本业绩&lt;/h4&gt;
&lt;p&gt;2015—2019 年，FarmPredict 等权多空组合表现如下：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;不考虑交易成本和涨跌停：年化收益 105.16%，夏普比率 8.51。&lt;/li&gt;
&lt;li&gt;考虑交易成本但不考虑涨跌停：年化收益 54.35%，夏普比率 5.32。&lt;/li&gt;
&lt;li&gt;考虑交易成本且涨跌停股票不可交易：年化收益 4.30%，夏普比率 0.21。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;市值加权组合收益大幅下降：考虑交易成本但无涨跌停时年化收益仅 9.18%，考虑涨跌停后甚至转负。这说明该策略的超额收益主要来自小市值股票，大市值股票定价更有效，新闻情绪对其影响较小。&lt;/p&gt;
&lt;h4&gt;4.2.4 收益来源与风险暴露&lt;/h4&gt;
&lt;p&gt;作者用 Carhart 四因子模型分析组合收益的 alpha 和风险暴露。结果显示，FarmPredict 多空组合的市场风险暴露很小，&lt;span class=&quot;math&quot;&gt;$R^2_{factor}$&lt;/span&gt; 仅约 6.92%，说明多空两端抵消了大部分市场波动。收益主要来自股票特质信息，组合 alpha 年化约 51.06%，接近总收益。这进一步说明该策略赚取的是新闻带来的个股 alpha，而非市场 beta。&lt;/p&gt;
&lt;hr&gt;
&lt;h2&gt;5. 模型讨论与比较&lt;/h2&gt;
&lt;h3&gt;5.1 因子与残差的贡献&lt;/h3&gt;
&lt;p&gt;为理解 FarmPredict 中因子和残差各自的作用，作者分别使用“仅因子”和“仅残差”进行预测。&lt;/p&gt;
&lt;p&gt;结果如表 8 所示：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;完整模型：样本外 &lt;span class=&quot;math&quot;&gt;$R^2 = 4.21\%$&lt;/span&gt;，组合日收益 17.8 个基点。&lt;/li&gt;
&lt;li&gt;仅因子：&lt;span class=&quot;math&quot;&gt;$R^2 = -0.12\%$&lt;/span&gt;，日收益 -8.2 个基点，比完整模型差 26 个基点，显著。&lt;/li&gt;
&lt;li&gt;仅残差：&lt;span class=&quot;math&quot;&gt;$R^2 = 4.21\%$&lt;/span&gt;，日收益 16.4 个基点，比完整模型差 1 个基点。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;这说明在本应用中，特质残差承担了大部分预测能力，但因子增强仍带来可观的组合收益改善。作者还比较了朴素 LASSO 直接对原始词频回归。FarmPredict 的 &lt;span class=&quot;math&quot;&gt;$R^2$&lt;/span&gt; 为 4.21%，LASSO 为 3.99%；组合年化收益 FarmPredict 比 LASSO 高 37.4%。这表明因子增强并不是无用的，而确实改善了预测和投资表现。&lt;/p&gt;
&lt;h3&gt;5.2 因子内容&lt;/h3&gt;
&lt;p&gt;作者分析了 9 个因子的载荷矩阵，绘制词云。这些因子大致可以解读为公司、中国经济、基金、公司治理、IPO、盈利、激励、重组等主题。大多数因子本身是情绪中性的，因此单靠因子并不能预测收益；FarmPredict 的优势在于把中性主题因子与有预测力的情绪残差结合起来。&lt;/p&gt;
&lt;h3&gt;5.3 与其他模型比较&lt;/h3&gt;
&lt;p&gt;作者将 FarmPredict 与多种基准模型进行对比：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;MNIR&lt;/strong&gt;：多项逆回归词选择模型。FarmPredict 显著优于 MNIR。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;SESTM&lt;/strong&gt;：有监督情绪提取与主题模型，是较先进的基准。SESTM 表现接近，但 FarmPredict 仍高出约 1.2 个基点日收益。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;词聚类模型&lt;/strong&gt;：基于 word2vec 嵌入和层次聚类的文本因子方法。FarmPredict 优于该模型，但 SVD 版本表现较接近。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;动量策略&lt;/strong&gt;：基于过去 1 天、2 天、3 天、1 周、1 月和 3 月收益排序构建组合。所有动量策略在中国市场均表现不佳，扣除交易成本后累计收益为负，远不如 FarmPredict。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;深度学习方法&lt;/strong&gt;：包括 BERT、BiRNN 和 TextCNN。FarmPredict 在组合表现上同样优于这些模型。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;总体而言，FarmPredict 在样本外预测精度和组合收益上均优于所有比较模型，证明了因子增强和特质残差共同建模的有效性。&lt;/p&gt;
&lt;hr&gt;
&lt;h2&gt;6. 结论与贡献&lt;/h2&gt;
&lt;p&gt;本文提出 FarmPredict 框架，将无监督因子模型与稀疏正则化预测相结合，直接从文本数据中学习金融收益信号。该方法不依赖预设词典或预训练模型，而是通过 PCA 学习潜在因子，用条件相关筛选选出情绪词，再用 LASSO 类惩罚回归进行预测。它在词选择和词聚类之间自动平衡，兼具降维和信息保留的优势。&lt;/p&gt;
&lt;p&gt;应用层面，作者将 FarmPredict 用于新浪财经中文新闻，预测中国 A 股个股 beta 调整收益。结果表明：&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;机器学习可以从中文新闻中提取有经济意义的情绪信息。&lt;/li&gt;
&lt;li&gt;正面新闻发布日平均带来 83 个基点超额收益，负面新闻平均带来 26 个基点负面冲击，正负不对称与卖空限制一致。&lt;/li&gt;
&lt;li&gt;基于情绪分数的多空组合在扣除交易成本后，等权组合年化收益可达 54%，夏普比率 4.30，显著高于多种基准模型。&lt;/li&gt;
&lt;li&gt;组合收益主要来自个股 alpha，而非市场风险暴露。&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;论文的贡献还体现在拓展了文本分析的语言和市场范围：此前研究多集中于英文和发达市场，本文展示了在新兴市场和非英文文本中应用机器学习文本分析的可能性。FarmPredict 的灵活性使得它可以适应不同的输入变换、筛选方法和预测模型，为社会科学中的文本分析提供了一个通用框架。&lt;/p&gt;
&lt;/div&gt;
&lt;!-- AI_BUTLER_LLM_BLOCK_END::v1::llm-summary-msx95hlj-qk3yridb1m::a808e375 --&gt;</rdf:value>
